---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProductTile from '@components/ProductTile.astro';
import SmartImage from '@components/SmartImage.astro';
import { installSections, type InstallLink } from '@data/installationsHub';
import { isExternalHref } from '@util/external-href';

const title = 'Install TBMQ and TBMQ Lite: Docker, Kubernetes, Cloud';
const description =
	'Get TBMQ running: try the public live demo, install TBMQ with Docker, Kubernetes or Helm on your servers or in your cloud account, or run TBMQ Lite in a single container.';

/** Off-site links open in a new tab; a link with an analytics id carries it together with `gtm_button`. */
const linkAttrs = ({ href, id }: InstallLink) => ({
	href,
	id,
	...(isExternalHref(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
});
---

<BaseLayout forceLightTheme title={title} description={description} pageId="installations" breadcrumb="Installations">
	<div class="install">
		<header class="install__container install__intro">
			<h1 class="install__intro-title">Get TBMQ running</h1>
			<p class="install__intro-text">
				Pick where it runs. The live demo needs nothing installed; TBMQ and TBMQ Lite have a guide for every way they
				install.
			</p>
		</header>

		<nav class="install-nav" aria-label="Sections on this page">
			<ul>
				{
					installSections.map((s) => (
						<li>
							<a href={`#${s.id}`}>{s.name}</a>
						</li>
					))
				}
			</ul>
		</nav>

		{
			installSections.map((s) => {
				const { aside, tryNow } = s;
				return (
					<section id={s.id} aria-labelledby={`${s.id}-title`} class:list={['install__product', s.band && 'is-band']}>
						<div class="install__container">
							<header class="install__head">
								<ProductTile product={s.tile} size={48} />
								<div>
									<p class="install__label">{s.label}</p>
									<h2 class="install__title" id={`${s.id}-title`}>
										{s.name}
										{s.tag && <span class="install__tag">{s.tag}</span>}
									</h2>
								</div>
							</header>

							<div class="install__grid">
								<div>
									<p class="install__text">{s.description}</p>

									{tryNow && (
										<div class="install__regions">
											<p class="install__group-title">Try now</p>
											<a class:list={['install__region', tryNow.id && 'gtm_button']} {...linkAttrs(tryNow)}>
												<span class="install__region-globe">
													<Icon name="tabler:world" aria-hidden="true" />
												</span>
												<span class="install__region-name">
													demo.tbmq.io
													<small>Public TBMQ broker</small>
												</span>
												<span class="install__region-cta">
													{tryNow.label}
													<span class="sr-only"> for the TBMQ live demo</span>
													<Icon name="tabler:chevron-right" aria-hidden="true" />
												</span>
											</a>
										</div>
									)}

									<div class="install__actions">
										{s.primary && (
											<a class:list={['install__button', s.primary.id && 'gtm_button']} {...linkAttrs(s.primary)}>
												{s.primary.label}
												<span class="sr-only"> — {s.name}</span>
											</a>
										)}
										{s.links.map((link) => (
											<a class:list={['install__link', link.id && 'gtm_button']} {...linkAttrs(link)}>
												{link.label}
												<span class="sr-only"> — {s.name}</span>
												<Icon name="tabler:chevron-right" aria-hidden="true" />
											</a>
										))}
									</div>
								</div>

								<div class="install__panel">
									{aside && (
										<div class="install__aside">
											<h3 class="install__aside-title">
												<Icon name="tabler:cloud-lock" aria-hidden="true" />
												{aside.title}
											</h3>
											<p class="install__text">{aside.text}</p>
											<div class="install__actions">
												{aside.links.map((link) => (
													<a class:list={['install__link', link.id && 'gtm_button']} {...linkAttrs(link)}>
														{link.label}
														<span class="sr-only"> — {aside.title}</span>
														<Icon name="tabler:chevron-right" aria-hidden="true" />
													</a>
												))}
											</div>
										</div>
									)}
									{s.options?.map((group) => (
										<div>
											<p class="install__group-title">{group.title}</p>
											<ul class="install__chips">
												{group.items.map((option) => (
													<li>
														<a class="install__chip" href={option.href}>
															<SmartImage src={option.logo} alt="" width="90" height="18" loading="lazy" />
															<span>
																{option.label}
																{option.note && <span class="install__chip-note"> {option.note}</span>}
															</span>
														</a>
													</li>
												))}
											</ul>
										</div>
									))}
								</div>
							</div>
						</div>
					</section>
				);
			})
		}
	</div>
</BaseLayout>

<style lang="scss">
	@use '../../styles/variables' as *;

	$install-nav-h: 48px;
	$measure: 1100px;

	// The site header is fixed, so the page starts below it.
	.install {
		padding-top: var(--header-height);
		padding-bottom: $spacing-20;
		background: var(--color-bg);
	}

	.install__container {
		max-width: $measure;
		margin-inline: auto;
		padding-inline: $spacing-5;
	}

	.install__intro {
		padding-block: $spacing-12;
		text-align: center;
	}

	.install__intro-title {
		@include section-title;

		margin: 0 0 $spacing-5;
		color: var(--color-text);
	}

	.install__intro-text {
		@include text-m;
		line-height: 24px;

		max-width: 65ch;
		margin: 0 auto;
	}

	// Sticky under the header; stuck, it takes the header's shadow (see the script).
	.install-nav {
		position: sticky;
		top: var(--header-height);
		z-index: 10;
		background: var(--color-bg);
		transition: box-shadow $transition-fast;

		&[data-stuck] {
			box-shadow: var(--shadow-header);
		}

		// Auto margins on the ends centre the row while it fits and let it scroll from its start when not.
		// Positioned, so the script's `offsetLeft` is measured within it.
		ul {
			position: relative;
			display: flex;
			gap: $spacing-6;
			height: $install-nav-h;
			margin: 0;
			padding: 0 $spacing-4;
			overflow-x: auto;
			list-style: none;
			scrollbar-width: none;

			@include media-down(md) {
				gap: $spacing-4;
			}
		}

		li {
			display: flex;
			flex: none;

			&:first-child {
				margin-inline-start: auto;
			}

			&:last-child {
				margin-inline-end: auto;
			}
		}

		a {
			position: relative;
			display: flex;
			align-items: center;
			font-size: $font-size-sm;
			font-weight: $font-weight-medium;
			color: var(--color-text-secondary);
			text-decoration: none;
			white-space: nowrap;
			transition: color $transition-fast;

			&::after {
				content: '';
				position: absolute;
				inset: auto 0 0;
				height: 3px;
				border-radius: 3px 3px 0 0;
				background: var(--color-brand);
				transform: scaleX(0);
				transition: transform 0.2s ease;
			}

			&:hover,
			&[aria-current] {
				color: var(--color-text);
			}

			&[aria-current]::after {
				transform: scaleX(1);
			}

			&:focus-visible {
				outline: 2px solid var(--color-brand);
				outline-offset: -2px;
				border-radius: $radius-sm;
			}
		}
	}

	:global(:root:has(.install-nav)) {
		scroll-padding-top: calc(var(--header-height) + #{$install-nav-h});

		@media (prefers-reduced-motion: no-preference) {
			scroll-behavior: smooth;
		}
	}

	.install__product {
		padding-block: $spacing-10;

		& + & {
			border-top: 1px solid var(--color-border);
		}

		&.is-band {
			background: linear-gradient(
				150deg,
				color-mix(in srgb, var(--color-brand) 16%, var(--color-bg)),
				color-mix(in srgb, var(--color-brand) 5%, var(--color-bg))
			);

			+ .install__product {
				border-top: 0;
			}
		}
	}

	.install__head {
		display: flex;
		align-items: center;
		gap: $spacing-5;
		margin-bottom: $spacing-5;

		@include media-down(sm) {
			gap: $spacing-3;
		}
	}

	.install__label,
	.install__group-title {
		margin: 0 0 $spacing-3;
		font-size: $font-size-sm;
		font-weight: $font-weight-medium;
		line-height: $line-height-tight;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	.install__label {
		margin-bottom: $spacing-1;
	}

	.install__title {
		display: flex;
		align-items: center;
		gap: $spacing-3;
		font-size: $font-size-3xl;
		font-weight: $font-weight-bold;
		line-height: $line-height-tight;
		margin: 0;
		color: var(--color-text);
	}

	.install__tag {
		@include text-xs;

		padding: 2px $spacing-2;
		border: 1px solid color-mix(in srgb, var(--color-brand) 40%, transparent);
		border-radius: $radius-full;
		background: color-mix(in srgb, var(--color-brand) 10%, transparent);
		color: var(--color-brand);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.install__grid {
		display: grid;
		grid-template-columns: minmax(0, 13fr) minmax(0, 10fr);
		gap: $spacing-8 $spacing-10;
		align-items: start;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.install__text {
		@include text-m;
		line-height: 24px;

		max-width: 46ch;
		margin: 0;
	}

	.install__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-3 $spacing-4;
		margin-top: $spacing-6;
	}

	.install__button {
		@include button-base;

		gap: $spacing-2;
		height: 44px;
		padding: 0 $spacing-4;
		font-weight: $font-weight-bold;
		line-height: 20px;
		border: 1px solid var(--color-brand);
		border-radius: $radius-md;
		background-color: var(--color-brand);
		color: var(--color-brand-contrast);

		&:hover {
			background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
		}

		&:focus-visible {
			outline: 2px solid var(--color-brand);
			outline-offset: 3px;
		}
	}

	.install__link {
		@include text-m;
		line-height: 24px;

		font-weight: $font-weight-medium;

		display: inline-flex;
		align-items: center;
		gap: $spacing-1;
		color: var(--color-brand);
		text-decoration: none;

		:global(svg) {
			width: 1.1em;
			height: 1.1em;
		}

		&:hover {
			text-decoration: underline;
		}
	}

	.install__regions {
		max-width: 480px;
		margin-top: $spacing-6;

		.install__group-title {
			color: var(--color-brand);
		}
	}

	.install__region {
		display: flex;
		align-items: center;
		gap: $spacing-3;
		padding: $spacing-3 $spacing-4;
		border-radius: $radius-lg;
		background: var(--color-bg-surface);
		box-shadow:
			0 1px 2px rgba(23, 24, 28, 0.06),
			0 6px 18px rgba(23, 24, 28, 0.06);
		color: var(--color-text);
		text-decoration: none;

		&:hover {
			box-shadow:
				0 1px 2px rgba(23, 24, 28, 0.08),
				0 10px 24px rgba(23, 24, 28, 0.1);
		}

		&:focus-visible {
			outline: 2px solid var(--color-brand);
			outline-offset: 3px;
		}
	}

	.install__region-globe {
		display: grid;
		flex: none;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-brand) 14%, var(--color-bg-surface));
		color: var(--color-brand);

		:global(svg) {
			width: 20px;
			height: 20px;
		}
	}

	.install__region-name {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
		font-weight: $font-weight-bold;
		line-height: 1.3;

		small {
			@include text-s;
			line-height: 22px;

			font-weight: $font-weight-normal;
			color: var(--color-text-secondary);
		}
	}

	.install__region-cta {
		@include text-s;
		line-height: 22px;

		font-weight: $font-weight-medium;

		display: inline-flex;
		flex: none;
		align-items: center;
		gap: $spacing-1;
		color: var(--color-brand);

		:global(svg) {
			width: 18px;
			height: 18px;
		}
	}

	.install__panel {
		display: grid;
		gap: $spacing-5;
		padding: $spacing-5;
		border-radius: $radius-xl;
		background: var(--color-bg-surface);
		box-shadow:
			0 1px 2px rgba(16, 24, 40, 0.06),
			0 18px 40px -18px rgba(16, 24, 40, 0.22);

		@include media-down(sm) {
			padding: $spacing-4;
		}
	}

	.install__aside .install__actions {
		margin-top: $spacing-3;
	}

	.install__aside-title {
		@include text-m;
		line-height: 20px;

		font-weight: $font-weight-bold;

		display: flex;
		align-items: center;
		gap: $spacing-3;
		margin: 0 0 $spacing-3;

		:global(svg) {
			flex: none;
			width: 24px;
			height: 24px;
			color: var(--color-brand);
		}
	}

	.install__chips {
		display: flex;
		flex-wrap: wrap;
		gap: $spacing-2;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.install__chip {
		@include text-m;
		line-height: 24px;

		display: inline-flex;
		align-items: center;
		gap: $spacing-2;
		min-height: 40px;
		padding: $spacing-1 $spacing-4;
		border: 1px solid var(--color-border-light);
		border-radius: $radius-full;
		font-weight: $font-weight-medium;
		text-decoration: none;

		:global(img) {
			flex: none;
			width: auto;
			height: 20px;
		}

		&:hover {
			border-color: var(--color-text-secondary);
			background: var(--color-bg-light);
		}
	}

	.install__chip-note {
		color: var(--color-text-secondary);
		font-weight: $font-weight-normal;
	}
</style>

<script>
	const root = document.documentElement;
	const nav = document.querySelector<HTMLElement>('.install-nav')!;
	const list = nav.querySelector('ul')!;
	const links = [...nav.querySelectorAll('a')];
	const sections = links.map((a) => document.getElementById(a.hash.slice(1))!);
	let current = -1;
	let frame = 0;

	const update = () => {
		frame = 0;
		const stuck = nav.getBoundingClientRect().top <= parseFloat(getComputedStyle(nav).top) + 0.5;
		nav.toggleAttribute('data-stuck', stuck);

		// The section being read: the last whose top has passed a quarter of the view under the bars;
		// at the end of the page, the last one, however short.
		const pad = parseFloat(getComputedStyle(root).scrollPaddingTop);
		const line = pad + (innerHeight - pad) / 4;
		const next =
			scrollY + innerHeight >= root.scrollHeight - 2
				? sections.length - 1
				: sections.findLastIndex((s) => s.getBoundingClientRect().top <= line);
		if (next === current) return;
		current = next;
		links.forEach((a, i) =>
			i === current ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')
		);
		// On a phone the row scrolls sideways: keep the lit link in its middle.
		const lit = links[current];
		if (lit && list.scrollWidth > list.clientWidth) {
			list.scrollTo({ left: lit.offsetLeft - (list.clientWidth - lit.offsetWidth) / 2, behavior: 'smooth' });
		}
	};

	const schedule = () => {
		frame ||= requestAnimationFrame(update);
	};
	addEventListener('scroll', schedule, { passive: true });
	addEventListener('resize', schedule);
	update();
</script>
