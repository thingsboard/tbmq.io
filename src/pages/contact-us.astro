---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const title = 'Contact the TBMQ Team: Sales and Support';
const description =
	'Contact the TBMQ team about licensing, TBMQ Professional Edition trials, Private Cloud and technical support. Send a message through the form and we will reply.';
---

<BaseLayout title={title} description={description} pageId="contact-us">
	<div class="contact-us-page">
		<ContactForm mode="page" />
	</div>
</BaseLayout>

<style lang="scss">
	.contact-us-page {
		min-height: calc(100vh - var(--header-height, 72px));
		background-color: var(--color-bg-brand-tint);
		background-image: url('/images/contact-us-bg.svg');
		background-position: center;
		background-repeat: no-repeat;
		background-size: contain;
		padding-top: var(--header-height, 72px);

		// In dark mode the brand-blue dotted SVG is fine on a dark page bg
		// (transparent background, themed strokes), but the page surface must
		// switch to a dark tone so the form card has contrast.
		:global([data-theme='dark']) & {
			background-color: var(--color-bg);
		}
	}
</style>
