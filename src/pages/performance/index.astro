---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BenchmarkHero from '@components/Performance/BenchmarkHero.astro';
import BenchmarkResults from '@components/Performance/BenchmarkResults.astro';
import WhyScales from '@components/Performance/WhyScales.astro';
import BenchmarkTrust from '@components/Performance/BenchmarkTrust.astro';
import BenchmarkCta from '@components/Performance/BenchmarkCta.astro';
import { Products } from '@models/site.models';
import { marketingJsonLd } from '~/util/structuredData';

const title = 'MQTT Broker Benchmark – 100M Connections, 3M+ msg/sec';
const description =
	'TBMQ MQTT broker benchmarks: 100M concurrent connections at 6M msg/sec, 3M+ messages/sec on a single node, and 1M msg/sec point-to-point — fully reproducible.';
const jsonLd = marketingJsonLd({
	path: '/performance/',
	name: title,
	description,
	breadcrumb: 'Performance',
});
---

<BaseLayout
	forceLightTheme
	title={title}
	description={description}
	pageId="performance"
	gitHubPlatform={Products.TBMQ}
	jsonLd={jsonLd}
	ogImageAlt="TBMQ MQTT broker performance benchmarks at 100M connections and 3M+ msg/sec"
>
	<main>
		<BenchmarkHero />
		<BenchmarkResults />
		<WhyScales />
		<BenchmarkTrust />
		<BenchmarkCta />
	</main>
</BaseLayout>

<script>
	import '~/scripts/open-links-in-new-tab';

	// Scroll reveal: fade + slide elements in as they enter the viewport.
	const main = document.querySelector('main');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (main && !reduceMotion && 'IntersectionObserver' in window) {
		main.classList.add('reveal-ready');
		const observer = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('in');
						obs.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 }
		);
		main.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
	}
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	:global(#performance) {
		--tb-main-color: #{$color-pe};
		--tb-main-color-hover: #{$color-pe-dark};
	}

	// Scroll-reveal: hidden state is only applied once JS marks the page ready,
	// so the content stays visible without JS or with reduced motion.
	:global(main.reveal-ready .reveal) {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.6s ease,
			transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
		transition-delay: var(--reveal-delay, 0ms);
		will-change: opacity, transform;
	}

	:global(main.reveal-ready .reveal.in) {
		opacity: 1;
		transform: none;
	}
</style>
