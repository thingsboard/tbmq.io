---
import BaseLayout from '@layouts/BaseLayout.astro';
import LiveDemoHero from '@components/LiveDemo/LiveDemoHero.astro';
import DashboardTour from '@components/LiveDemo/DashboardTour.astro';
import ConnectCard from '@components/LiveDemo/ConnectCard.astro';
import ProductionCta from '@components/LiveDemo/ProductionCta.astro';
import { Products } from '@models/site.models';
import { marketingJsonLd } from '~/util/structuredData';

const title = 'Free Public MQTT Broker – Live Online Demo';
const description =
	'Try TBMQ, the open-source MQTT broker, online. Explore the dashboard or connect any MQTT client to our free public broker at demo.tbmq.io — no signup required.';
const jsonLd = marketingJsonLd({
	path: '/live-demo/',
	name: title,
	description,
	breadcrumb: 'Live Demo',
});
---

<BaseLayout
	forceLightTheme
	title={title}
	description={description}
	pageId="live-demo"
	gitHubPlatform={Products.TBMQ}
	jsonLd={jsonLd}
	ogImageAlt="TBMQ live demo — try the open-source MQTT broker online"
>
	<main>
		<LiveDemoHero />
		<DashboardTour />
		<ConnectCard />
		<ProductionCta />
	</main>
</BaseLayout>

<script>
	// Scroll reveal: fade + slide elements in as they enter the viewport.
	const main = document.querySelector('main');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (main && !reduceMotion && 'IntersectionObserver' in window) {
		main.classList.add('reveal-ready');
		const observer = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('in');
						obs.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 }
		);
		main.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
	}
</script>

<style lang="scss">
	@use '../styles/variables' as *;

	// Scroll-reveal: hidden state is only applied once JS marks the page ready,
	// so the content stays visible without JS or with reduced motion.
	:global(main.reveal-ready .reveal) {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.6s ease,
			transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
		transition-delay: var(--reveal-delay, 0ms);
		will-change: opacity, transform;
	}

	:global(main.reveal-ready .reveal.in) {
		opacity: 1;
		transform: none;
	}

	:global(#live-demo) {
		--tb-main-color: #{$color-pe};
		--tb-main-color-hover: #{$color-pe-dark};

		// Offset in-page anchor jumps (e.g. the hero's "Connect a client ↓")
		// so the target section clears the fixed header instead of hiding under it.
		scroll-padding-top: calc(#{$header-height} + 24px);
	}

	// Animate in-page anchor scrolls, but honor users who prefer reduced motion.
	@media (prefers-reduced-motion: no-preference) {
		:global(#live-demo) {
			scroll-behavior: smooth;
		}
	}
</style>
