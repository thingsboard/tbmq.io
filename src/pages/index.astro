---

<BaseLayout
	forceLightTheme
	title="Open Source MQTT Broker - Scalable IoT Messaging"
	description="Deliver 3M+ MQTT messages/sec with TBMQ — a fault-tolerant open-source MQTT broker with clustering and message durability."
	pageId="mqtt-broker"
	gitHubPlatform={Products.TBMQ}
	preloadLcpImage="/hero/tbmq-cover.webp"
>
	<main>
		<Hero
			product={Products.TBMQ}
			title={['TBMQ', 'Open-source MQTT Broker']}
			subtitle="Scalable, fault-tolerant, and durable messaging for millions of MQTT clients"
			buttons={[
				{ text: 'Try it now', href: '/installations/', variant: 'white' },
				{ text: 'Learn more', href: '/mqtt/', variant: 'outline' },
			]}
			anchorLink="#content"
			backgroundImage="/hero/tbmq-cover.webp"
			videoBackground={{
				webm: 'https://video.thingsboard.io/tbmq-cover.webm',
				mp4: 'https://video.thingsboard.io/tbmq-cover.mp4',
			}}
			achievement={null}
		/>

		<div id="content">
			<TopFeaturesSection />
			<ScenariosSection />
			<InstallationOptionsSection />
			<MiddleFeaturesSection />
			<div id="comparison-features">
				<ComparisonTable
					title="TBMQ feature comparison"
					groups={tbmqGroups}
					peColor="#1f8b4d"
					centerTitle={true}
					bgColor="#F2F8F4"
					noSkew={true}
					fixedMaxWidth={true}
				/>
			</div>
			<BottomFeaturesSection />
			<GetStartedSection />
		</div>
	</main>
</BaseLayout>

<script>
	import '~/scripts/open-links-in-new-tab';
</script>

<style lang="scss">
	@use '../styles/variables' as *;

	:global(#mqtt-broker) {
		--tb-main-color: #{$color-pe};
		--tb-main-color-hover: #{$color-pe-dark};
	}

	:global(#mqtt-broker #hero .button:hover) {
		background-color: $color-pe-dark;
		filter: none;
	}

	:global(#mqtt-broker #content a:not(.btn)) {
		color: #1f8b4d;
	}
</style>
