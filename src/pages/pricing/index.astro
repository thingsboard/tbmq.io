	.tbmq-pc-subscription-cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: $spacing-6;
		padding: $spacing-8 $spacing-10;
		margin-top: $spacing-8;
		background: var(--color-bg-surface);
		border: 1px solid var(--color-border);
