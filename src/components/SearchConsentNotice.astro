---
// Stands in for Google search until the visitor allows External media; `@util/site-search` decides when.
import NButton from '@components/Landing/NButton.astro';
import { SEARCH_CONSENT_NOTE, SEARCH_CONSENT_TEXT } from '@data/privacy';
import { googleSiteSearchUrl } from '@util/site-search';

interface Props {
	/** Unique per page: the button's aria-describedby, so a screen reader reads the text on focus. */
	descId: string;
}

const { descId } = Astro.props;
---

{/* Starts hidden; the script that owns the search shows it and puts the query into the Google link. */}
<div class="search-consent" data-search-consent hidden>
	<p id={descId} class="search-consent__text">{SEARCH_CONSENT_TEXT}</p>
	<div class="search-consent__actions">
		<NButton size="sm" data-cc="accept-media" aria-describedby={descId}>Load Google search</NButton>
		<a class="search-consent__google" href={googleSiteSearchUrl('')} target="_blank" rel="noopener noreferrer">
			Search on Google instead
		</a>
	</div>
	<p class="search-consent__note">
		{SEARCH_CONSENT_NOTE}
		<button type="button" class="cookie-settings" data-cc="show-preferences">Cookie settings</button>
	</p>
</div>

<style lang="scss">
	@use '../styles/variables' as *;

	.search-consent {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 0.25rem 0;
		text-align: start;

		&[hidden] {
			display: none;
		}
	}

	.search-consent__text,
	.search-consent__note {
		margin: 0;
	}

	.search-consent__text {
		@include text-card;
	}

	.search-consent__note {
		@include text-card-sm;
		color: var(--color-text-secondary);
	}

	.search-consent__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
	}

	.search-consent__google {
		color: var(--color-primary);
	}
</style>
