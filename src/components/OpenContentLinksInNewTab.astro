<script is:inline>
	// Marketing pages that opt in (BaseLayout's `openContentLinksInNewTab`) open
	// their in-content links in a new tab so visitors keep the landing page —
	// an SEO-team request, so internal links are deliberately included.
	// In-page anchors (#…) and links with an explicit `target` stay as authored.
	// `is:inline` so the script ships only when BaseLayout actually renders the
	// component — a bundled module script is included from the module graph and
	// would leak onto pages that never opted in. Rendering after <slot /> also
	// guarantees <main> is parsed before this runs.
	document.querySelectorAll('main a[href]').forEach((link) => {
		const href = link.getAttribute('href') ?? '';
		if (href.startsWith('#') || link.hasAttribute('target')) return;
		link.target = '_blank';
		const rel = new Set(link.rel.split(' ').filter(Boolean));
		rel.add('noopener');
		rel.add('noreferrer');
		link.rel = [...rel].join(' ');
	});
</script>
