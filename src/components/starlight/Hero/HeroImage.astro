---
import fs from 'node:fs';
import { join } from 'node:path';
import { docsLink, type Products } from '~/models/site.models';

export interface Props {
	product: Products;
}

const { product } = Astro.props;

// TBMQ brand green, consumed as `currentColor` by the SVG. Baked in at build
// time, so keep in sync with $color-brand in src/styles/_variables.scss.
const color = '#1a7f46';

const svgPath = join(process.cwd(), 'public', 'hero', 'tbmq-hero.svg');
let svg = fs.readFileSync(svgPath, 'utf-8');

// `product` selects the CE or PE docs prefix.
const links = {
	sessions: docsLink(product, 'user-guide/ui/sessions/'),
	credentials: docsLink(product, 'user-guide/ui/mqtt-client-credentials/'),
	monitoring: docsLink(product, 'user-guide/ui/monitoring/'),
	subscriptions: docsLink(product, 'user-guide/ui/subscriptions/'),
	websocket: docsLink(product, 'user-guide/ui/websocket-client/'),
};

// Substitute link placeholders defined in the SVG
for (const [key, href] of Object.entries(links)) {
	svg = svg.replaceAll(`{{links.${key}}}`, href);
}
---

<div class="hero-image not-content" style={`color: ${color};`} set:html={svg} />

<style>
	.hero-image {
		display: none;
	}

	@media (min-width: 78rem) {
		.hero-image {
			display: flex;
			align-items: center;
			justify-self: end;
			align-self: center;
			padding: 2rem 2rem 2rem 0;
			pointer-events: none;
			height: 43.75rem;
		}

		.hero-image :global(svg) {
			width: 100%;
			max-width: 38rem;
			height: auto;
			filter: drop-shadow(0 8px 32px rgba(0, 0, 0, 0.2));
			display: block;
		}

		.hero-image :global(svg a) {
			pointer-events: all;
			cursor: pointer;
			color: inherit;
		}
	}

	@media (min-width: 77.9375rem) and (max-width: 100rem) {
		.hero-image {
			align-items: end;
		}
	}
</style>
