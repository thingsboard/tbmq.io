---
/**
 * Link from the docs into the /mqtt/ learn hub. The counterpart of `DocLink`
 * for the other tree: it takes the topic slug, not a path, and fails the build
 * on a slug the hub does not have, so a renamed guide cannot leave dead links
 * behind in the shared `_includes` content. Same `bold` and `target` props as
 * DocLink, but plain by default — these are inline concept links.
 */
import { getTopic, topicHref } from '~/data/mqttLearn';

interface Props {
	slug: string;
	bold?: boolean;
	target?: '_blank' | '_self' | '_parent' | '_top';
}
const { slug, bold = false, target } = Astro.props;
// Throws on an unknown slug — the build-time guarantee this component exists for.
getTopic(slug);
---

<a href={topicHref(slug)} target={target} rel={target === '_blank' ? 'noopener noreferrer' : undefined}
	>{
		bold ? (
			<b>
				<slot />
			</b>
		) : (
			<slot />
		)
	}</a
>
