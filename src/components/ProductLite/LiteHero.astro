---
import { TBMQ_LITE_VER } from '~/data/versions';

// The same command the install guide leads with (docs/lite/installation).
const command = [
	'docker run -d --name tbmq-lite --restart unless-stopped \\',
	'  -p 1883:1883 -p 8083:8083 -p 8084:8084 \\',
	`  -v tbmq-lite:/data thingsboard/tbmq-lite:${TBMQ_LITE_VER}`,
].join('\n');

interface Stat {
	value: string;
	label: string;
	href: string;
}

const stats: Stat[] = [
	{ value: '1', label: 'container to run', href: '#lite-build' },
	{ value: '0', label: 'other services beside it', href: '#lite-build' },
	{
		value: '7,500',
		label: 'msg/s sustained on 2 CPUs and 2 GB',
		href: '/docs/lite/guarantees-and-limits/#capacity',
	},
];
---

<section id="lite-hero">
	<div class="inner">
		<h1 class="hero-title">
			<span class="eyebrow">TBMQ Lite · Beta</span>
			<span class="headline">The whole MQTT broker in one container</span>
		</h1>
		<p class="subtitle">
			TBMQ Lite is the single-node edition of TBMQ: one container and one data volume, with no Kafka, PostgreSQL or
			Valkey beside it. It keeps TBMQ's MQTT 3.1, 3.1.1 and 5 handling, persistent sessions with durable offline queues,
			retained messages, the REST API and the web UI, for sites that fit one machine, the edge, labs and laptops. It is
			in public beta and supports DEVICE clients only.
		</p>

		<div class="command">
			{/* prettier-ignore */}
			<pre><code>{command}</code></pre>
			<button type="button" class="copy" data-copy={command} aria-label="Copy the docker run command">Copy</button>
		</div>

		<div class="buttons">
			<a class="btn btn-white" href="/docs/lite/installation/">Install TBMQ Lite</a>
			<a class="btn btn-outline" href="#lite-compare">Compare with TBMQ</a>
		</div>

		<div class="stats">
			{
				stats.map((s) => (
					<a class="stat" href={s.href}>
						<span class="stat-value">{s.value}</span>
						<span class="stat-label">{s.label}</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLButtonElement>('#lite-hero .copy').forEach((btn) => {
		btn.addEventListener('click', () => {
			if (btn.classList.contains('copied')) return;
			navigator.clipboard
				.writeText(btn.dataset.copy ?? '')
				.then(() => {
					const original = btn.textContent;
					btn.textContent = 'Copied ✓';
					btn.classList.add('copied');
					setTimeout(() => {
						btn.textContent = original;
						btn.classList.remove('copied');
					}, 1600);
				})
				.catch(() => {
					/* clipboard unavailable: the command stays selectable */
				});
		});
	});
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The hero is dark in both themes, so its colours are fixed, like ProductHero's.
	#lite-hero {
		background-color: #00240f;
		padding: calc(#{$header-height} + 64px) $spacing-6 $spacing-20;
	}

	.inner {
		@include container;
		max-width: 1400px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.hero-title {
		margin: 0;
	}

	.eyebrow {
		display: block;
		@include text-s;
		font-weight: $font-weight-semibold;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: $color-pe-hover;
		margin: 0 0 20px;
	}

	.headline {
		display: block;
		@include page-title;
		color: $color-white;
		margin: 0 0 24px;
		text-wrap: balance;
	}

	.subtitle {
		@include body-text;
		color: rgba(255, 255, 255, 0.8);
		margin: 0 0 40px;
		max-width: 820px;
	}

	.command {
		position: relative;
		width: 100%;
		max-width: 760px;
		margin: 0 0 40px;
		text-align: left;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: $radius-lg;

		pre {
			margin: 0;
			padding: 20px 84px 20px 20px;
			overflow-x: auto;
			background: transparent;
			border: 0;
		}

		code {
			font-family: $font-family-mono;
			@include text-s;
			color: #dfe9e2;
			white-space: pre;
			background: transparent;
			padding: 0;
		}
	}

	.copy {
		position: absolute;
		top: 12px;
		right: 12px;
		@include text-xs;
		padding: 4px 10px;
		border-radius: $radius-md;
		cursor: pointer;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: #cfe8d6;
		transition: $transition-base;

		&:hover,
		&.copied {
			background: rgba(255, 255, 255, 0.14);
			border-color: rgba(255, 255, 255, 0.3);
			color: $color-white;
		}
	}

	.buttons {
		display: flex;
		gap: 20px;
		flex-wrap: wrap;
		justify-content: center;
		margin-bottom: 72px;
	}

	.btn {
		@include button-base;
		padding: 14px 28px;
		border-radius: $radius-lg;

		&.btn-white {
			background-color: $color-white;
			color: $color-pe-link;

			&:hover {
				background-color: #e8e8e8;
			}
		}

		&.btn-outline {
			border: 1px solid rgba(255, 255, 255, 0.6);
			color: $color-white;

			&:hover {
				background-color: rgba(255, 255, 255, 0.1);
				border-color: $color-white;
			}
		}
	}

	.stats {
		display: grid;
		grid-template-columns: 1fr;
		gap: 40px 24px;
		width: 100%;
		max-width: 900px;

		@include media-up(md) {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 8px;
		text-decoration: none;

		&:not(:last-child) {
			@include media-up(md) {
				border-right: 1px solid rgba(255, 255, 255, 0.14);
			}
		}
	}

	.stat-value {
		@include stat-value;
		color: $color-pe-hover;
		font-variant-numeric: tabular-nums;
	}

	.stat-label {
		@include text-s;
		color: rgba(255, 255, 255, 0.72);
		margin-top: 12px;
		max-width: 22ch;
	}
</style>
