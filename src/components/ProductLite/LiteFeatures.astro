---
import SectionHeader from '@components/Landing/SectionHeader.astro';
import { Icon } from 'astro-icon/components';

// Every line is stated on a TBMQ Lite docs page (install, configuration, comparison).
const features = [
	{
		icon: 'tabler:versions',
		title: 'MQTT 3.1, 3.1.1 and 5',
		text: 'The same MQTT handling as clustered TBMQ: the two are built from the same code.',
	},
	{
		icon: 'tabler:database',
		title: 'Persistent sessions',
		text: 'A persistent client gets the QoS 1 and QoS 2 messages published while it was offline, from a durable queue of 10,000 messages by default.',
	},
	{
		icon: 'tabler:pin',
		title: 'Retained messages',
		text: 'Stored in the embedded database on the data volume, like everything else the broker keeps.',
	},
	{
		icon: 'tabler:arrows-split-2',
		title: 'Shared subscriptions',
		text: 'DEVICE clients share a subscription with $share/<group>/<topic>, as usual.',
	},
	{
		icon: 'tabler:shield-lock',
		title: 'Five authentication providers',
		text: 'Basic, X.509, JWT, SCRAM and HTTP, the same providers as TBMQ.',
	},
	{
		icon: 'tabler:layout-dashboard',
		title: 'REST API and web UI',
		text: 'The TBMQ web UI and REST API on port 8083. Create credentials, then publish and subscribe from the UI.',
	},
	{
		icon: 'tabler:chart-line',
		title: 'Prometheus metrics',
		text: 'The series of the TBMQ metrics reference, without those of Kafka, SQL queues, APPLICATION clients and integrations, plus pipeline and store series of its own.',
	},
	{
		icon: 'tabler:archive',
		title: 'Built-in backup',
		text: 'Back up from the UI, the REST API or the command line. Before an upgrade changes the store, the broker takes a checkpoint.',
	},
	{
		icon: 'tabler:lock-check',
		title: 'Secure defaults',
		text: 'The administrator password is changed at the first sign-in, and the metrics endpoint answers only with a token.',
	},
];
---

<section id="lite-features">
	<div class="inner">
		<SectionHeader
			class="reveal"
			title="What you get"
			subtitle="TBMQ Lite shares TBMQ's MQTT handling, authentication providers, REST API and web UI."
		/>
		<ul class="features">
			{
				features.map((f, i) => (
					<li class="feature reveal" style={`--reveal-delay: ${(i % 3) * 90}ms`}>
						<Icon name={f.icon} class="lite-feature-icon" />
						<h3 class="feature-title">{f.title}</h3>
						<p class="feature-text">{f.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	#lite-features {
		padding: $spacing-20 $spacing-6;
		background-color: var(--color-bg-surface);
		scroll-margin-top: var(--header-height);
	}

	.inner {
		@include container;
		max-width: 1200px;
	}

	.features {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: $spacing-6;

		@include media-up(md) {
			grid-template-columns: repeat(2, 1fr);
		}

		@include media-up(lg) {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.feature {
		padding: $spacing-6;
		border: 1px solid var(--color-border);
		border-radius: $radius-xl;
		background-color: var(--color-bg-surface);
	}

	:global(.lite-feature-icon) {
		width: 28px;
		height: 28px;
		color: var(--color-brand);
		margin-bottom: $spacing-4;
	}

	.feature-title {
		@include card-title-sm;
		color: var(--color-text);
		margin: 0 0 $spacing-2;
	}

	.feature-text {
		@include text-card-sm;
		color: var(--color-text-secondary);
		margin: 0;
	}
</style>
