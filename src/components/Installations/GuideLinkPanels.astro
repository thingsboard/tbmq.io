---
// GuideLinkPanels.astro
// Grouped directory of deployment-guide links: one panel per group (icon + label),
// each listing compact rows of logo + title + arrow. All groups stay visible, so a
// reader scans every deployment at once instead of switching tabs.
//
// Usage:
//   <GuideLinkPanels product={props.product} groups={[
//     { label: 'Standalone', icon: 'tabler:server', items: [
//       { path: 'installation/docker#upgrading', title: 'Docker (Linux, macOS)', icon: '/src/assets/images/installation/docker-linux-mac.svg' },
//     ] },
//   ]} />

import Icon from '~/components/starlight/Icon.astro';
import { Products, productDocsPrefix } from '~/models/site.models';

export interface GuideLink {
	path: string; // docs path relative to the edition prefix; may carry a #hash
	title: string;
	icon: string; // SVG path inside /src/assets/
}

export interface GuideGroup {
	label: string;
	icon: string; // tabler icon name
	items: GuideLink[];
}

interface Props {
	groups: GuideGroup[];
	product: Products;
}

const { groups, product } = Astro.props;
const prefix = productDocsPrefix[product];

const svgModules = import.meta.glob<string>('/src/assets/**/*.svg', {
	eager: true,
	query: '?raw',
	import: 'default',
});

const resolved = groups.map((group) => ({
	...group,
	items: group.items.map((item) => {
		const [basePath, hash] = item.path.split('#');
		const href = `/docs/${prefix}${basePath.endsWith('/') ? basePath : basePath + '/'}${hash ? '#' + hash : ''}`;
		return { ...item, href, iconRaw: svgModules[item.icon] ?? null };
	}),
}));
---

<div class="gl-panels">
	{
		resolved.map((group) => (
			<section class="gl-panel" aria-label={group.label}>
				<p class="gl-panel__label">
					<span class="gl-panel__icon" aria-hidden="true">
						<Icon name={group.icon} />
					</span>
					{group.label}
				</p>
				<ul>
					{group.items.map((item) => (
						<li>
							<a href={item.href}>
								<span class="gl-row__logo" aria-hidden="true">
									{item.iconRaw && <Fragment set:html={item.iconRaw} />}
								</span>
								<span class="gl-row__title">{item.title}</span>
								<span class="gl-row__go" aria-hidden="true">
									<Icon name="tabler:arrow-right" />
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>

<style>
	.gl-panels {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.25rem;
	}

	@media (max-width: 640px) {
		.gl-panels {
			grid-template-columns: 1fr;
		}
	}

	.gl-panel {
		margin: 0;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--color-bg-brand-tint);
	}

	.gl-panel__label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.5rem;
		padding: 0.25rem 0.5rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--sl-color-gray-2);
	}

	.gl-panel__icon {
		display: flex;
		font-size: 1rem;
		color: var(--color-brand);
	}

	.gl-panel ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.gl-panel li {
		margin: 0;
	}

	.gl-panel a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.625rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-bg);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s;
	}

	.gl-panel a:hover {
		border-color: var(--color-brand);
	}

	.gl-panel a:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: 1px;
	}

	/* Icons drawn with fill="currentColor" (the TBMQ mark) pick up the brand green. */
	.gl-row__logo {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 4.5rem;
		height: 1.75rem;
		color: var(--color-brand);
	}

	.gl-row__logo :global(svg) {
		width: auto;
		max-width: 100%;
		height: 100%;
	}

	.gl-row__title {
		flex: 1;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.gl-row__go {
		display: flex;
		font-size: 1rem;
		color: var(--sl-color-gray-3);
		transition:
			color 0.15s,
			transform 0.15s;
	}

	.gl-panel a:hover .gl-row__go {
		color: var(--color-brand);
		transform: translateX(3px);
	}

	@media (prefers-reduced-motion: reduce) {
		.gl-panel a,
		.gl-row__go {
			transition: none;
		}

		.gl-panel a:hover .gl-row__go {
			transform: none;
		}
	}
</style>
