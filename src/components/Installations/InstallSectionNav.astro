---
// InstallSectionNav.astro
// Row of jump tiles at the top of the installation index, one per section of the page.
// Also honours the legacy `?installationType=<id>` links from when the sections were tabs:
// the page scrolls to the matching section.

import Icon from '~/components/starlight/Icon.astro';

export interface InstallSection {
	id: string; // heading id of the section on the page
	label: string;
	icon: string; // tabler icon name
	text: string;
}

interface Props {
	sections: InstallSection[];
}

const { sections } = Astro.props;
---

<nav class="is-nav" aria-label="Installation options">
	<ul>
		{
			sections.map((s) => (
				<li>
					<a href={`#${s.id}`}>
						<span class="is-nav__icon" aria-hidden="true">
							<Icon name={s.icon} />
						</span>
						<span class="is-nav__label">{s.label}</span>
						<span class="is-nav__text">{s.text}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script>
	const type = new URLSearchParams(window.location.search).get('installationType');
	if (type && !window.location.hash) {
		const target = document.getElementById(type);
		if (target) requestAnimationFrame(() => target.scrollIntoView());
	}
</script>

<style>
	.is-nav ul {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
	}

	@media (max-width: 1100px) {
		.is-nav ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 480px) {
		.is-nav ul {
			grid-template-columns: 1fr;
		}
	}

	.is-nav li {
		margin: 0;
	}

	.is-nav a {
		display: grid;
		grid-template-columns: auto 1fr;
		column-gap: 0.75rem;
		row-gap: 0.125rem;
		align-items: center;
		height: 100%;
		padding: 0.875rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--color-bg-brand-tint);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s;
	}

	.is-nav a:hover {
		border-color: var(--color-brand);
	}

	.is-nav__icon {
		grid-row: span 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.5rem;
		background: var(--sl-color-bg);
		border: 1px solid var(--sl-color-gray-5);
		font-size: 1.25rem;
		color: var(--color-brand);
	}

	.is-nav__label {
		font-weight: 600;
		color: var(--sl-color-white);
		line-height: 1.3;
	}

	.is-nav__text {
		font-size: var(--sl-text-xs);
		line-height: 1.4;
		color: var(--sl-color-gray-3);
	}
</style>
