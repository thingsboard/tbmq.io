---
// DeploymentAtGlance.astro
// Opening summary for an installation guide: the containers the deployment runs on its
// host, then one tile per port TBMQ exposes (port, protocol, what it's for). The labels and
// icons are overridable, so the same layout also shows build tools and build outputs. An
// optional second group (`managed`) sits beside the host, e.g. a cloud's managed services.
//
// Usage:
//   <DeploymentAtGlance host="One host · Docker" services={[
//     { name: 'TBMQ', logo: '/src/assets/images/installation/tbmq-ce.svg' },
//     { name: 'PostgreSQL', icon: 'simple-icons:postgresql' },
//   ]} ports={[
//     { port: '1883', protocol: 'MQTT', use: 'MQTT clients' },
//     { port: '8883', protocol: 'MQTTS', use: 'MQTT clients that connect over TLS, once you', linkText: 'enable MQTTS', href: '#…' },
//   ]} />

import Icon from '~/components/starlight/Icon.astro';

export interface GlanceService {
	name: string;
	icon?: string; // icon name (tabler:…, simple-icons:…)
	logo?: string; // or an SVG path inside /src/assets/
}

export interface GlancePort {
	port: string;
	protocol: string;
	use: string;
	code?: string; // optional inline code appended after `use`, in parentheses
	linkText?: string; // optional link appended after `use`
	href?: string;
}

interface Props {
	host: string;
	hostIcon?: string;
	services: GlanceService[];
	managedLabel?: string;
	managedIcon?: string;
	managed?: GlanceService[];
	portsLabel?: string;
	portsIcon?: string;
	ports: GlancePort[];
}

const {
	host,
	hostIcon = 'tabler:server',
	services,
	managedLabel = 'Managed services',
	managedIcon = 'tabler:cloud',
	managed,
	portsLabel = 'Ports',
	portsIcon = 'tabler:plug-connected',
	ports,
} = Astro.props;

// Up to four tiles share one row. Beyond that, pick three or four columns, whichever leaves
// fewer empty slots in the last row (six → 3 + 3, five → 3 + 2, eight → 4 + 4).
const emptySlots = (c: number) => (c - (ports.length % c)) % c;
const cols = ports.length <= 4 ? ports.length : emptySlots(3) < emptySlots(4) ? 3 : 4;

const groups = [
	{ label: host, icon: hostIcon, items: services },
	...(managed?.length ? [{ label: managedLabel, icon: managedIcon, items: managed }] : []),
];

const svgModules = import.meta.glob<string>('/src/assets/**/*.svg', {
	eager: true,
	query: '?raw',
	import: 'default',
});
---

<div class="dg">
	<div class:list={['dg-groups', { 'dg-groups--two': groups.length > 1 }]}>
		{
			groups.map((g) => (
				<div class="dg-host">
					<p class="dg-label">
						<span class="dg-label__icon" aria-hidden="true">
							<Icon name={g.icon} />
						</span>
						{g.label}
					</p>
					<ul class="dg-services">
						{g.items.map((s) => (
							<li class="dg-service">
								<span class="dg-service__icon" aria-hidden="true">
									{s.logo && svgModules[s.logo] ? (
										<Fragment set:html={svgModules[s.logo]} />
									) : (
										s.icon && <Icon name={s.icon} />
									)}
								</span>
								{s.name}
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
	<p class="dg-label dg-label--ports">
		<span class="dg-label__icon" aria-hidden="true"><Icon name={portsIcon} /></span>
		{portsLabel}
	</p>
	<ul class="dg-ports" style={`--dg-cols: ${cols}`}>
		{
			ports.map((p) => (
				<li class="dg-port">
					<span class="dg-port__num">{p.port}</span>
					<span class="dg-port__proto">{p.protocol}</span>
					<span class="dg-port__use">
						{p.use}
						{p.code && (
							<>
								{' '}
								<span class="dg-port__code">
									(<code>{p.code}</code>)
								</span>
							</>
						)}
						{p.linkText && p.href && (
							<>
								{' '}
								<a href={p.href}>{p.linkText}</a>
							</>
						)}
					</span>
				</li>
			))
		}
	</ul>
</div>

<style>
	.dg {
		margin-top: 1.25rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--color-bg-brand-tint);
	}

	.dg-label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.625rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--sl-color-gray-2);
	}

	.dg-label--ports {
		margin-top: 1rem;
	}

	.dg-label__icon {
		display: flex;
		font-size: 1rem;
		color: var(--color-brand);
	}

	.dg-groups {
		display: grid;
		gap: 0.75rem;
	}

	.dg-groups--two {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	/* Starlight spaces adjacent content blocks with margin-top; grid gap does that here. */
	.dg-groups > .dg-host {
		margin-top: 0;
	}

	@media (max-width: 720px) {
		.dg-groups--two {
			grid-template-columns: 1fr;
		}
	}

	.dg-host {
		padding: 0.875rem;
		border: 1px dashed var(--sl-color-gray-4);
		border-radius: 0.625rem;
		background: var(--sl-color-bg);
	}

	.dg-services,
	.dg-ports {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.dg-services {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.dg-service {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0.375rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-bg);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	/* Logos drawn with fill="currentColor" (the TBMQ mark) pick up the brand green. */
	.dg-service__icon {
		display: flex;
		align-items: center;
		height: 1.125rem;
		font-size: 1.125rem;
		color: var(--color-brand);
	}

	.dg-service__icon :global(svg) {
		width: auto;
		height: 100%;
	}

	.dg-ports {
		display: grid;
		grid-template-columns: repeat(var(--dg-cols, 4), minmax(0, 1fr));
		gap: 0.5rem;
	}

	.dg-port {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		margin: 0;
		padding: 0.75rem 0.875rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-bg);
	}

	.dg-port__num {
		font-family: var(--__sl-font-mono, var(--sl-font-mono));
		font-size: 1.375rem;
		font-weight: 600;
		line-height: 1.2;
		color: var(--color-brand);
	}

	.dg-port__proto {
		font-size: var(--sl-text-sm);
		line-height: 1.3;
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.dg-port__use {
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}

	/* Env var names are long single words: let them break rather than overflow the tile. */
	.dg-port__code {
		overflow-wrap: anywhere;
	}

	@media (max-width: 720px) {
		.dg-ports {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
