---
/**
 * Homepage hero background: MQTT publishers → TBMQ cluster → subscribers.
 *
 * Decorative (aria-hidden) and hand-authored so it stays editable: every label
 * below is a string, and the geometry is computed from the two node lists.
 * Pass it to `<Hero>` through the `background` slot.
 *
 * It is a composition rather than one stretched SVG, because the headline in
 * the middle is HTML sized in px while the art has to follow the viewport:
 *
 *  - `.frame` is the broker. CSS sizes it around the headline.
 *  - Wide screens show the left/right wings: they scale with the hero height
 *    and are anchored to the frame edges, so the lanes always meet their ports;
 *    a narrow gutter simply crops the outer node column.
 *  - Everything else (tablets, phones) shows the top/bottom wings instead,
 *    where the free space is.
 *
 * Only the visible pair animates (`display: none` wings do not tick). Motion
 * stops for `prefers-reduced-motion` and while the hero is scrolled off screen.
 */

interface FlowNode {
	label: string;
	icon: keyof typeof ICONS;
}

/** 24×24 glyph bodies. Tabler Icons (MIT), except `kafka` — Simple Icons (CC0). */
const stroke = 'fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"';
const ICONS = {
	sensor: `<path ${stroke} d="M10 13.5a4 4 0 1 0 4 0V5a2 2 0 0 0-4 0zM10 9h4"/>`,
	gateway: `<path ${stroke} d="M3 15a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zm14 2v.01M13 17v.01M15 13v-2m-3.25-2.25a4 4 0 0 1 6.5 0M8.5 6.5a8 8 0 0 1 13 0"/>`,
	vehicle: `<g ${stroke}><path d="M5 17a2 2 0 1 0 4 0a2 2 0 1 0-4 0m10 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0"/><path d="M5 17H3v-6l2-5h9l4 5h1a2 2 0 0 1 2 2v4h-2m-4 0H9m-6-6h15m-6 0V6"/></g>`,
	meter: `<g ${stroke}><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0"/><path d="M11 12a1 1 0 1 0 2 0a1 1 0 1 0-2 0m2.41-1.41L16 8m-9 4a5 5 0 0 1 5-5"/></g>`,
	machine: `<g ${stroke}><path d="M3 21h18M5 21V9l5 4V9l5 4h4"/><path d="M19 21v-8l-1.436-9.574A.5.5 0 0 0 17.069 3h-1.145a.5.5 0 0 0-.494.418L14 12m-5 5h1m4 0h1"/></g>`,
	app: `<path ${stroke} d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zm3 1h.01M9 8h.01"/>`,
	dashboard: `<path ${stroke} d="M5 4h4a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1m0 12h4a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1m10-4h4a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1m0-8h4a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1"/>`,
	analytics: `<g ${stroke}><path d="M3 3v18h18m-1-3v3m-4-5v5m-4-8v8m-4-5v5"/><path d="M3 11c6 0 5-5 9-5s3 5 9 5"/></g>`,
	http: `<path ${stroke} d="M4 13h5m3 3V8h3a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2h-3m8-5v8M9 16v-5.5a2.5 2.5 0 0 0-5 0V16"/>`,
	kafka: `<path fill="currentColor" d="M9.71 2.136a1.43 1.43 0 0 0-2.047 0h-.007a1.48 1.48 0 0 0-.421 1.042c0 .41.161.777.422 1.039l.007.007c.257.264.616.426 1.019.426c.404 0 .766-.162 1.027-.426l.003-.007c.261-.262.421-.629.421-1.039c0-.408-.159-.777-.421-1.042zM8.683 22.295c.404 0 .766-.167 1.027-.429l.003-.008c.261-.261.421-.631.421-1.036c0-.41-.159-.778-.421-1.044H9.71a1.42 1.42 0 0 0-1.027-.432a1.4 1.4 0 0 0-1.02.432h-.007c-.26.266-.422.634-.422 1.044c0 .406.161.775.422 1.036l.007.008c.258.262.617.429 1.02.429m7.89-4.462c.359-.096.683-.33.882-.684l.027-.052a1.47 1.47 0 0 0 .114-1.067a1.45 1.45 0 0 0-.675-.896l-.021-.014a1.43 1.43 0 0 0-1.078-.132c-.36.091-.684.335-.881.686c-.2.349-.241.75-.146 1.119c.099.363.33.691.675.896h.002c.346.203.737.239 1.101.144m-6.405-7.342a2.08 2.08 0 0 0-1.485-.627c-.58 0-1.103.242-1.482.627c-.378.385-.612.916-.612 1.507s.233 1.124.612 1.514a2.08 2.08 0 0 0 2.967 0c.379-.39.612-.923.612-1.514s-.233-1.122-.612-1.507m-.835-2.51c.843.141 1.6.552 2.178 1.144h.004c.092.093.182.196.265.299l1.446-.851a3.2 3.2 0 0 1-.047-1.808a3.15 3.15 0 0 1 1.456-1.926l.025-.016a3.06 3.06 0 0 1 2.345-.306c.77.21 1.465.721 1.898 1.482v.002c.431.757.518 1.626.313 2.408a3.15 3.15 0 0 1-1.456 1.928l-.198.118h-.02a3.1 3.1 0 0 1-2.154.201a3.13 3.13 0 0 1-1.514-.944l-1.444.848a4.16 4.16 0 0 1 0 2.879l1.444.846c.413-.47.939-.789 1.514-.944a3.04 3.04 0 0 1 2.371.319l.048.023v.002a3.17 3.17 0 0 1 1.408 1.906a3.22 3.22 0 0 1-.313 2.405l-.026.053l-.003-.005a3.15 3.15 0 0 1-1.867 1.436a3.1 3.1 0 0 1-2.371-.318v-.006a3.16 3.16 0 0 1-1.456-1.927a3.2 3.2 0 0 1 .047-1.805l-1.446-.848a4 4 0 0 1-.265.294l-.004.005a3.94 3.94 0 0 1-2.178 1.138v1.699a3.1 3.1 0 0 1 1.56.862l.002.004c.565.572.914 1.368.914 2.243c0 .873-.35 1.664-.914 2.239l-.002.009a3.1 3.1 0 0 1-2.21.931a3.1 3.1 0 0 1-2.206-.93h-.002v-.009a3.2 3.2 0 0 1-.916-2.239c0-.875.35-1.672.916-2.243v-.004h.002a3.1 3.1 0 0 1 1.558-.862v-1.699a3.93 3.93 0 0 1-2.176-1.138l-.006-.005a4.1 4.1 0 0 1-1.173-2.874c0-1.122.452-2.136 1.173-2.872h.006a3.95 3.95 0 0 1 2.176-1.144V6.289a3.14 3.14 0 0 1-1.558-.864h-.002v-.004a3.2 3.2 0 0 1-.916-2.243c0-.871.35-1.669.916-2.243l.002-.002A3.08 3.08 0 0 1 8.683 0c.861 0 1.641.355 2.21.932v.002h.002c.565.574.914 1.372.914 2.243c0 .876-.35 1.667-.914 2.243l-.002.005a3.14 3.14 0 0 1-1.56.864zm8.121-1.129l-.012-.019a1.45 1.45 0 0 0-.87-.668a1.43 1.43 0 0 0-1.103.146h.002c-.347.2-.58.529-.677.896c-.095.365-.054.768.146 1.119l.007.009c.2.347.519.579.874.673c.357.103.755.059 1.098-.144l.019-.009a1.47 1.47 0 0 0 .657-.885a1.5 1.5 0 0 0-.141-1.118"/>`,
};

const PUB = {
	sensors: { label: 'Sensors', icon: 'sensor' },
	gateways: { label: 'Gateways', icon: 'gateway' },
	vehicles: { label: 'Vehicles', icon: 'vehicle' },
	meters: { label: 'Smart meters', icon: 'meter' },
	machines: { label: 'Machines', icon: 'machine' },
} satisfies Record<string, FlowNode>;

// Subscribers are MQTT client apps plus the two integrations every edition ships (Kafka, HTTP).
const SUB = {
	apps: { label: 'Applications', icon: 'app' },
	dashboards: { label: 'Dashboards', icon: 'dashboard' },
	kafka: { label: 'Kafka', icon: 'kafka' },
	http: { label: 'HTTP APIs', icon: 'http' },
	analytics: { label: 'Analytics', icon: 'analytics' },
} satisfies Record<string, FlowNode>;

interface Lane {
	node: FlowNode;
	/** Lane curve, drawn in the direction the message travels. */
	d: string;
	nx: number;
	ny: number;
	/** Label anchor. */
	lx: number;
	ly: number;
	/** Port on the frame edge. */
	px: number;
	py: number;
	/** Pulse duration and (negative) start offset, in seconds. */
	dur: number;
	delay: number;
}

const DURATIONS = [3.1, 3.7, 2.8, 3.4, 3.0];
const pace = (i: number, shift: number) => {
	const dur = DURATIONS[i % DURATIONS.length];
	return { dur, delay: -(((i * 1.27 + shift) % dur) + 0.01).toFixed(2) };
};

// ── Wide layout: wings left and right of the frame ───────────────────────────
// 520 × 900 units, scaled by hero height. The frame edge is x = 520 for the
// publishers and x = 0 for the subscribers. Even rows sit in the inner column,
// which stays visible in the narrowest gutter; odd rows sit further out.
const SIDE = { w: 520, h: 900, r: 26, inner: 112, outer: 330 };

function sideWing(nodes: FlowNode[], dir: 'in' | 'out'): Lane[] {
	return nodes.map((node, i) => {
		const dist = i % 2 === 0 ? SIDE.inner : SIDE.outer;
		const ny = 200 + i * 140;
		const py = 250 + i * 100;
		const nx = dir === 'in' ? SIDE.w - dist : dist;
		const px = dir === 'in' ? SIDE.w : 0;
		const edge = dir === 'in' ? nx + SIDE.r : nx - SIDE.r;
		const mid = (edge + px) / 2;
		const d =
			dir === 'in'
				? `M${edge} ${ny}C${mid} ${ny} ${mid} ${py} ${px} ${py}`
				: `M${px} ${py}C${mid} ${py} ${mid} ${ny} ${edge} ${ny}`;
		return { node, d, nx, ny, lx: nx, ly: ny + SIDE.r + 24, px, py, ...pace(i, dir === 'in' ? 0 : 1.6) };
	});
}

// ── Stacked layout: wings above and below the frame ──────────────────────────
// 720 × 190 units, centred on the frame. A phone shows the middle ~390 units,
// so the top row keeps three nodes there. The bottom row leaves the centre
// free for the hero's scroll arrow.
const STACK = { w: 720, h: 190, r: 20 };

function stackWing(nodes: FlowNode[], dir: 'in' | 'out'): Lane[] {
	const mid = STACK.w / 2;
	const n = nodes.length;
	return nodes.map((node, i) => {
		const k = i - (n - 1) / 2;
		if (dir === 'in') {
			const nx = mid + k * 120;
			const px = mid + k * 56;
			const ny = 54;
			const y0 = ny + STACK.r;
			const ym = (y0 + STACK.h) / 2;
			const d = `M${nx} ${y0}C${nx} ${ym} ${px} ${ym} ${px} ${STACK.h}`;
			return { node, d, nx, ny, lx: nx, ly: 22, px, py: STACK.h, ...pace(i, 0) };
		}
		const nx = mid + Math.sign(k) * (Math.abs(k) < 1 ? 110 : 270);
		const px = mid + k * 56;
		const ny = 120;
		const y1 = ny - STACK.r;
		const d = `M${px} 0C${px} ${y1 / 2} ${nx} ${y1 / 2} ${nx} ${y1}`;
		return { node, d, nx, ny, lx: nx, ly: ny + STACK.r + 22, px, py: 0, ...pace(i, 1.6) };
	});
}

const wings = [
	{
		kind: 'side',
		place: 'left',
		box: SIDE,
		caption: { text: 'PUBLISHERS', x: SIDE.w - 20, y: 128, anchor: 'end' },
		lanes: sideWing([PUB.sensors, PUB.meters, PUB.gateways, PUB.machines, PUB.vehicles], 'in'),
	},
	{
		kind: 'side',
		place: 'right',
		box: SIDE,
		caption: { text: 'SUBSCRIBERS', x: 20, y: 128, anchor: 'start' },
		lanes: sideWing([SUB.apps, SUB.dashboards, SUB.kafka, SUB.http, SUB.analytics], 'out'),
	},
	{
		kind: 'stack',
		place: 'top',
		box: STACK,
		caption: null,
		lanes: stackWing([PUB.meters, PUB.sensors, PUB.gateways, PUB.vehicles, PUB.machines], 'in'),
	},
	{
		kind: 'stack',
		place: 'bottom',
		box: STACK,
		caption: null,
		lanes: stackWing([SUB.dashboards, SUB.apps, SUB.analytics, SUB.kafka], 'out'),
	},
];
---

<div class="hero-flow" aria-hidden="true">
	<svg class="sprite" width="0" height="0" focusable="false">
		{
			Object.entries(ICONS).map(([name, body]) => (
				<symbol id={`hero-flow-${name}`} viewBox="0 0 24 24" set:html={body} />
			))
		}
	</svg>

	<div class="frame"><span class="frame-tag">TBMQ cluster</span></div>

	{
		wings.map((wing) => (
			<div class:list={['gutter', `gutter--${wing.kind}`, `gutter--${wing.place}`]}>
				<svg class="wing" viewBox={`0 0 ${wing.box.w} ${wing.box.h}`} focusable="false">
					{wing.caption && (
						<text class="caption" x={wing.caption.x} y={wing.caption.y} text-anchor={wing.caption.anchor}>
							{wing.caption.text}
						</text>
					)}
					{wing.lanes.map((lane) => (
						<g>
							<path class="lane" d={lane.d} />
							<path
								class="pulse"
								d={lane.d}
								pathLength="100"
								style={`animation-duration:${lane.dur}s;animation-delay:${lane.delay}s`}
							/>
							<circle class="port" cx={lane.px} cy={lane.py} r="4" />
							<circle class="node" cx={lane.nx} cy={lane.ny} r={wing.box.r} />
							<use
								class="glyph"
								href={`#hero-flow-${lane.node.icon}`}
								x={lane.nx - wing.box.r / 2}
								y={lane.ny - wing.box.r / 2}
								width={wing.box.r}
								height={wing.box.r}
							/>
							<text class="label" x={lane.lx} y={lane.ly} text-anchor="middle">
								{lane.node.label}
							</text>
						</g>
					))}
				</svg>
			</div>
		))
	}
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The hero is dark on every theme (the page forces light, the hero inverts it),
	// so these are fixed values rather than theme tokens.
	$bg: #060d09;
	$ink: #fff;
	$overlap: 16px; // how far a gutter reaches into the frame, so ports are not clipped

	.hero-flow {
		// Frame size per layout. The stacked heights follow the hero's own font breakpoints.
		--frame-w: min(920px, calc(100% - 32px));
		--frame-h: 320px;

		position: absolute;
		inset: 0;
		overflow: hidden;
		color: $color-pe;
		font-family: $font-family-base;
		background:
			radial-gradient(ellipse 55% 60% at 50% 50%, rgba($color-pe, 0.16), transparent 72%),
			radial-gradient(rgba($ink, 0.06) 1px, transparent 1.5px) 0 0 / 32px 32px,
			$bg;

		@media (min-width: 750px) {
			--frame-h: 400px;
		}

		@media (min-width: 1250px) {
			--frame-h: 560px;
		}
	}

	.sprite {
		position: absolute;
	}

	.frame {
		position: absolute;
		top: 50%;
		left: 50%;
		width: var(--frame-w);
		height: var(--frame-h);
		transform: translate(-50%, -50%);
		border: 1px solid rgba($color-pe, 0.4);
		border-radius: 24px;
		background: linear-gradient(180deg, rgba($color-pe, 0.1), rgba($color-pe, 0.03));
		box-shadow:
			0 0 90px rgba($color-pe, 0.14),
			inset 0 0 70px rgba($color-pe, 0.05);
	}

	.frame-tag {
		@include text-xs;
		display: none;
		position: absolute;
		top: 0;
		left: 32px;
		transform: translateY(-50%);
		padding: 0 12px;
		border: 1px solid rgba($color-pe, 0.4);
		border-radius: 999px;
		background: $bg;
		color: rgba($ink, 0.78);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.gutter {
		position: absolute;
		overflow: hidden;
	}

	.wing {
		position: absolute;
		display: block;
		overflow: visible;
	}

	// Stacked layout (default)
	.gutter--side {
		display: none;
	}

	.gutter--stack {
		container: hero-flow-gutter / size;
		left: 0;
		right: 0;
		height: calc(50% - var(--frame-h) / 2 + #{$overlap});

		.wing {
			left: 50%;
			// 68px keeps the art clear of the fixed header (top) and the screen edge (bottom).
			height: clamp(120px, calc(100% - #{$overlap} - 68px), 230px);
			aspect-ratio: 720 / 190;
			transform: translateX(-50%);
		}
	}

	.gutter--top {
		top: 0;
		-webkit-mask-image: linear-gradient(to bottom, transparent 44px, #000 76px);
		mask-image: linear-gradient(to bottom, transparent 44px, #000 76px);

		.wing {
			bottom: $overlap;
		}
	}

	.gutter--bottom {
		bottom: 0;

		.wing {
			top: $overlap;
		}
	}

	// Wide layout: enough room beside the headline for the wings
	@media (min-width: 1250px) and (min-aspect-ratio: 4/3) {
		.hero-flow {
			--frame-w: 920px;
			--frame-h: max(66%, 540px);
		}

		.frame-tag {
			display: block;
		}

		.gutter--stack {
			display: none;
		}

		.gutter--side {
			display: block;
			top: 0;
			bottom: 0;
			width: calc(50% - var(--frame-w) / 2 + #{$overlap});

			.wing {
				top: 0;
				height: 100%;
				aspect-ratio: 520 / 900;
			}
		}

		.gutter--left {
			left: 0;
			-webkit-mask-image: linear-gradient(to right, transparent, #000 40px);
			mask-image: linear-gradient(to right, transparent, #000 40px);

			.wing {
				right: $overlap;
			}
		}

		.gutter--right {
			right: 0;
			-webkit-mask-image: linear-gradient(to left, transparent, #000 40px);
			mask-image: linear-gradient(to left, transparent, #000 40px);

			.wing {
				left: $overlap;
			}
		}
	}

	// ── SVG parts ────────────────────────────────────────────────────────────────
	.lane,
	.pulse {
		fill: none;
		stroke-linecap: round;
	}

	.lane {
		stroke: rgba($ink, 0.16);
		stroke-width: 1.5;
	}

	// One bright dash per lane, travelling its whole length: with pathLength = 100
	// the 8-unit dash starts just before the path and ends just past it.
	.pulse {
		stroke: #4ee08a;
		stroke-width: 3;
		stroke-dasharray: 8 108;
		stroke-dashoffset: 8;
		animation: hero-flow-pulse 3s linear infinite;
	}

	.port {
		fill: $color-pe;
	}

	.node {
		fill: rgba($ink, 0.05);
		stroke: rgba($ink, 0.26);
		stroke-width: 1.25;
	}

	.glyph {
		color: rgba($ink, 0.92);
	}

	.label,
	.caption {
		fill: rgba($ink, 0.8);
	}

	.label {
		font-size: 17px;
		font-weight: $font-weight-medium;
	}

	.gutter--stack .label {
		font-size: 13px;

		// The stacked wings shrink with the space above and below the frame. Under
		// this gutter height the labels drop below ~10px, so the icons carry it alone.
		@container hero-flow-gutter (max-height: 228px) {
			display: none;
		}
	}

	.caption {
		fill: rgba($ink, 0.5);
		font-size: 14px;
		font-weight: $font-weight-semibold;
		letter-spacing: 0.16em;
	}

	@keyframes hero-flow-pulse {
		from {
			stroke-dashoffset: 8;
		}
		to {
			stroke-dashoffset: -100;
		}
	}

	.hero-flow.is-paused .pulse {
		animation-play-state: paused;
	}

	@media (prefers-reduced-motion: reduce) {
		.pulse {
			display: none;
			animation: none;
		}
	}
</style>

<script>
	// Stop the lane animation while the hero is scrolled out of view.
	const art = document.querySelector<HTMLElement>('.hero-flow');
	if (art && 'IntersectionObserver' in window) {
		new IntersectionObserver(([entry]) => art.classList.toggle('is-paused', !entry.isIntersecting)).observe(art);
	}
</script>
