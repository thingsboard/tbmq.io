---
import { Products, docsLink } from '~/models/site.models';

interface Props {
	product: Products;
	path: string;
	bold?: boolean;
	target?: '_blank' | '_self' | '_parent' | '_top';
}
const { product, path, bold = true, target } = Astro.props;
const href = docsLink(product, path);
---

<a href={href} target={target} rel={target === '_blank' ? 'noopener noreferrer' : undefined}
	>{
		bold ? (
			<b><slot /></b>
		) : (
			<slot />
		)
	}</a
>
