---
import DeferredLoadTrigger from './DeferredLoadTrigger.astro';
import GtmHead from './GtmHead.astro';
---

<!--
	Single entry point for all third-party browser scripts. DeferredLoadTrigger
	defines window.__deferOnInteraction for the scripts that defer on it
	(GitHubButton); GtmHead parses the consent cookie and loads GTM only with
	consent. BaseLayout, LegalLayout and the Starlight Head override all mount this
	in <head>, so every page type gets the same loaders and the consent globals
	CookieConsent needs.
-->
<DeferredLoadTrigger />
<GtmHead />
