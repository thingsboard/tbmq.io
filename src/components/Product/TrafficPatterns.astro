									<text
										x="72"
										y="93"
										text-anchor="middle"
										dominant-baseline="middle"
										font-size="15"
										font-weight="700"
										fill="#fff"
										letter-spacing="0.6"
									>
										BROKER
									</text>
									<circle cx="306" cy="36" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="306" cy="36" r="8" fill="#17bb52" />
									<circle cx="306" cy="72" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="306" cy="72" r="8" fill="#17bb52" />
									<circle cx="306" cy="108" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="306" cy="108" r="8" fill="#17bb52" />
									<circle cx="306" cy="144" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="306" cy="144" r="8" fill="#17bb52" />
									<text
										x="300"
										y="174"
										text-anchor="middle"
										font-size="15"
										font-weight="600"
										fill="#3f4a44"
										letter-spacing="0.3"
									>
										Subscribers
									</text>
								</svg>
							)}
							{p.type === 'point-to-point' && (
								<svg
									viewBox="0 0 360 196"
									role="img"
									aria-label="Point-to-point: one publisher to one subscriber through the broker"
								>
									<defs>
										<marker
											id="tp-8"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
										<marker
