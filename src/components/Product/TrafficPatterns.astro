										<marker
											id="tp-0"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
										<marker
											id="tp-1"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
										<marker
											id="tp-2"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
										<marker
											id="tp-3"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
									</defs>
									<path
										d="M68 36 C 139.1 36 154.9 73 226 73"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#tp-0)"
									/>
									<path
										d="M68 72 C 139.1 72 154.9 86 226 86"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#tp-1)"
									/>
									<path
										d="M68 108 C 139.1 108 154.9 98 226 98"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#tp-2)"
									/>
									<path
										d="M68 144 C 139.1 144 154.9 111 226 111"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#tp-3)"
									/>
									<circle cx="54" cy="36" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="54" cy="36" r="8" fill="#17bb52" />
									<circle cx="54" cy="72" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="54" cy="72" r="8" fill="#17bb52" />
									<circle cx="54" cy="108" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="54" cy="108" r="8" fill="#17bb52" />
									<circle cx="54" cy="144" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="54" cy="144" r="8" fill="#17bb52" />
									<rect x="232" y="62" width="112" height="60" rx="12" fill="#155e2b" />
									<text
										x="288"
										y="93"
										text-anchor="middle"
										dominant-baseline="middle"
										font-size="15"
										font-weight="700"
										fill="#fff"
										letter-spacing="0.6"
									>
										BROKER
									</text>
									<text
										x="60"
										y="174"
										text-anchor="middle"
										font-size="15"
										font-weight="600"
										fill="#3f4a44"
										letter-spacing="0.3"
									>
