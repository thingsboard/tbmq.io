									<circle cx="56" cy="92" r="8" fill="#17bb52" />
									<rect x="124" y="62" width="112" height="60" rx="12" fill="#155e2b" />
									<text
										x="180"
										y="93"
										text-anchor="middle"
										dominant-baseline="middle"
										font-size="15"
										font-weight="700"
										fill="#fff"
										letter-spacing="0.6"
