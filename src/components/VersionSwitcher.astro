---
import { Products } from '@models/site.models.ts';
import { allPages } from '~/content';
import { getVersionFromURL, switchVersionWithFallback } from '~/util/path-utils';
import { RELEASE_FAMILIES, familySlug } from '~/models/releases-table';
import { UPGRADE_FAMILIES, getFamilySlug } from '~/models/upgrade-instructions';

// Inline SVGs as raw strings so their `currentColor` flows from the parent's CSS `color`.
const iconSources = import.meta.glob<string>('/src/assets/images/docs/product-selector/*.svg', {
	eager: true,
	query: '?raw',
	import: 'default',
});
const getIcon = (name: string) => iconSources[`/src/assets/images/docs/product-selector/${name}.svg`] ?? '';

// ────────────────────────────────────────────────────────────────────────────
// FAMILIES — single source of truth for what the selector renders.
// Add or edit one entry to add/edit a product in the selector.
// ────────────────────────────────────────────────────────────────────────────
type Group = 'core' | 'addons' | 'ecosystem';

interface Edition {
	product: Products;
	label: string;
}
interface Region {
	product: Products;
	label: string;
	subtitle: string;
}
interface Family {
	id: Products;
	group: Group;
	name: string;
	tagline: string;
	iconId: string;
	editions: Edition[];
	/** When defined, region row + popover render whenever the active edition
	 * matches one of `options[].product`. */
	regions?: { options: Region[] };
	/** Edition to land on when this family is picked from the product dropdown.
	 * Defaults to `editions[editions.length - 1]` (Professional/Cloud first). */
	preferredEdition?: Products;
}

const FAMILIES: Family[] = [
	{
		id: Products.TBMQ,
		group: 'ecosystem',
		name: 'MQTT Broker',
		tagline: 'Reliable messaging for massive fleets',
		iconId: 'tbmq',
		editions: [
			{ product: Products.TBMQ, label: 'Community' },
			{ product: Products.TBMQ_PE, label: 'Professional' },
		],
		preferredEdition: Products.TBMQ_PE,
	},
];

// ────────────────────────────────────────────────────────────────────────────
// State derivation
// ────────────────────────────────────────────────────────────────────────────
const currentProduct = getVersionFromURL(Astro.url.pathname);
const currentFamily =
	FAMILIES.find((f) => f.editions.some((e) => e.product === currentProduct)) ??
	// If currentProduct is a region variant (PAAS_EU), find the family by region match
	FAMILIES.find((f) => f.regions?.options.some((r) => r.product === currentProduct))!;

// Build the existing-pages set used by switchVersionWithFallback (incl. dynamic pages).
const existingPageIds = new Set(allPages.map((p) => p.id));
for (const f of RELEASE_FAMILIES) {
	const slug = familySlug(f.family);
	existingPageIds.add(`docs/releases/releases-table/${slug}`);
	existingPageIds.add(`docs/pe/releases/releases-table/${slug}`);
}
const upgradePlatforms = ['ubuntu', 'centos', 'windows', 'docker', 'docker-compose'];
for (const fam of UPGRADE_FAMILIES) {
	const slug = getFamilySlug(fam);
	for (const platform of upgradePlatforms) {
		existingPageIds.add(`docs/installation/upgrade-instructions/${platform}/${slug}`);
		existingPageIds.add(`docs/pe/installation/upgrade-instructions/${platform}/${slug}`);
	}
}

const href = (target: Products) => switchVersionWithFallback(Astro.url.pathname, target, existingPageIds);

// Edition pill is "active" if its product matches current OR if it's the
// regional trigger and current is one of its region variants (so the Cloud
// pill stays highlighted when reading EU docs).
const isEditionActive = (e: Edition): boolean => {
	if (e.product === currentProduct) return true;
	if (currentFamily.regions?.options.some((r) => r.product === currentProduct)) {
		return e.product === currentFamily.regions.options[0]!.product;
	}
	return false;
};
---

<product-selector>
	<div class="ps-card">
		<!-- Static product label — single-product site, no product switching -->
		<div class="ps-header">
			<span class="ps-icon-box ps-icon-box--header">
				<span class="ps-icon" set:html={getIcon(currentFamily.iconId)} />
			</span>
			<span class="ps-header-text">
				<span class="ps-eyebrow">You're reading docs for</span>
				<span class="ps-name">{currentFamily.name}</span>
			</span>
		</div>

		<!-- Edition switch: rendered when family has multiple editions -->
		{
			currentFamily.editions.length > 1 && (
				<div class="ps-switch" role="group" aria-label="Edition">
					{currentFamily.editions.map((e) => (
						<a
							class:list={['ps-pill', { 'is-active': isEditionActive(e) }]}
							href={href(e.product)}
							aria-pressed={isEditionActive(e)}
						>
							{e.label}
						</a>
					))}
				</div>
			)
		}
	</div>
</product-selector>

<style lang="scss">
	@use '../styles/variables' as *;

	product-selector {
		display: block;
		position: relative;
		width: 100%;
	}

	// ─── Outer card wrapping the 3 controls ─────────────────────────────────
	.ps-card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 8px;
		background: var(--sl-color-bg-sidebar, var(--sl-color-bg));
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 10px;
	}

	// ─── Header (static product label) ───────────────────────────────────────
	.ps-header {
		display: flex;
		align-items: center;
		gap: 8px;
		width: 100%;
		padding: 6px 8px;
		border-radius: 8px;
		text-align: left;
		color: var(--sl-color-white);
	}

	.ps-header-text {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
		line-height: 1.2;
	}

	.ps-eyebrow {
		font-size: 11px;
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}

	.ps-name {
		font-size: 16px;
		font-weight: 600;
		color: var(--sl-color-white);
	}

	// ─── Icon box (32×32 with 20×20 SVG inside) ─────────────────────────────
	.ps-icon-box {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 4px;
		flex-shrink: 0;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-1);
	}

	.ps-icon-box--header {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent, var(--sl-color-accent));
	}

	.ps-icon {
		display: inline-flex;
		width: 20px;
		height: 20px;

		:global(svg) {
			width: 20px;
			height: 20px;
		}
	}

	// ─── Edition switch ─────────────────────────────────────────────────────
	// Content-sized pills with `flex: 0 1 auto` — each pill is sized to its
	// own text (so "Professional" has natural padding, doesn't fill the cell
	// edge-to-edge), and `space-evenly` distributes whatever room is left.
	// If the sidebar narrows enough that pills can't fit, flex-shrink kicks
	// in and the pills ellipsize (overflow:hidden + text-overflow:ellipsis)
	// instead of overflowing the .ps-card.
	.ps-switch {
		display: flex;
		justify-content: space-evenly;
		gap: 4px;
		padding: 4px;
		background: var(--sl-color-gray-7);
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 8px;
	}

	.ps-pill {
		flex: 0 1 auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 0;
		padding: 6px 10px;
		font-size: 12px;
		font-weight: 400;
		line-height: 1.2;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		border: 1px solid transparent;
		border-radius: 6px;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;

		&:hover {
			color: var(--sl-color-white);
		}

		&.is-active {
			background: var(--sl-color-bg);
			border-color: var(--sl-color-text-accent, var(--sl-color-accent));
			color: var(--sl-color-white);
			font-weight: 600;
		}
	}
</style>
