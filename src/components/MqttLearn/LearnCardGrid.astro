---
interface Card {
	href: string;
	title: string;
	blurb: string;
}
interface Props {
	cards: Card[];
}
const { cards } = Astro.props;
---

<div class="learn-card-grid">
	{
		cards.map((c) => (
			<a class="learn-card" href={c.href}>
				<span class="learn-card__title">{c.title}</span>
				<span class="learn-card__blurb">{c.blurb}</span>
			</a>
		))
	}
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	.learn-card-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 12px;
		margin: $spacing-4 0 $spacing-6;
		@include media-up(sm) {
			grid-template-columns: 1fr 1fr;
		}
	}
	// Nested under .learn-card-grid so the specificity beats the layout's
	// global prose rule (.learn-body a { text-decoration: underline }), which
	// otherwise re-adds an underline to these card links.
	.learn-card-grid .learn-card {
		display: flex;
		flex-direction: column;
		gap: 4px;
		background: $color-bg-white;
		border: 1px solid $color-border;
		border-radius: $radius-lg;
		padding: 14px 16px;
		text-decoration: none;
		transition:
			border-color $transition-fast,
			box-shadow $transition-fast,
			transform $transition-fast;
		&:hover {
			border-color: $color-pe;
			box-shadow: var(--shadow-sm);
			text-decoration: none;
		}
		&:focus-visible {
			outline: 2px solid $color-pe;
			outline-offset: 2px;
		}
	}
	// Subtle lift on hover — motion only, so gate it behind reduced-motion.
	@media (prefers-reduced-motion: no-preference) {
		.learn-card-grid .learn-card:hover {
			transform: translateY(-1px);
		}
	}
	.learn-card__title {
		font-size: 14.5px;
		font-weight: $font-weight-semibold;
		color: $color-text-primary;
	}
	.learn-card__blurb {
		font-size: 13px;
		line-height: 1.45;
		color: $color-text-secondary;
	}
</style>
