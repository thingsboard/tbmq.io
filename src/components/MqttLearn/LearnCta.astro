---
// Bottom conversion band, reused on every learn page.
---

<section class="learn-cta">
	<div class="learn-cta__inner">
		<h2 class="learn-cta__title">Run it yourself</h2>
		<p class="learn-cta__text">
			TBMQ is a free, open-source MQTT broker built to scale. Spin it up in minutes or try the live demo — no install
			required.
		</p>
		<div class="learn-cta__actions">
			<a class="learn-cta__btn learn-cta__btn--primary" href="/installations/">Try it now</a>
			<a class="learn-cta__btn" href="/live-demo/">Live demo</a>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.learn-cta {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		text-align: center;
		background: $color-text-primary;
		border-radius: $radius-xl;
		padding: $spacing-16 $spacing-6;
		margin-top: $spacing-16;
		width: 100%;

		// Soft green glow rising from the base + a faint schematic dot-grid,
		// bookending the hero motif at the foot of every learn page.
		&::before {
			content: '';
			position: absolute;
			inset: 0;
			z-index: 0;
			background:
				radial-gradient(120% 90% at 50% 118%, rgba(23, 187, 82, 0.32), transparent 60%),
				radial-gradient(circle, rgba(255, 255, 255, 0.06) 1px, transparent 1.5px);
			background-size:
				100% 100%,
				24px 24px;
			-webkit-mask-image: radial-gradient(ellipse 80% 100% at 50% 100%, #000, transparent 78%);
			mask-image: radial-gradient(ellipse 80% 100% at 50% 100%, #000, transparent 78%);
			pointer-events: none;
		}
	}
	.learn-cta__inner {
		position: relative;
		z-index: 1;
	}
	.learn-cta__title {
		font-size: 30px;
		font-weight: $font-weight-semibold;
		letter-spacing: -0.01em;
		color: #fff;
		margin: 0 0 12px;
	}
	.learn-cta__text {
		font-size: 16px;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.8);
		max-width: 560px;
		margin: 0 auto 24px;
	}
	.learn-cta__actions {
		display: flex;
		justify-content: center;
		gap: 16px;
		flex-wrap: wrap;
	}
	.learn-cta__btn {
		display: inline-flex;
		align-items: center;
		padding: 12px 24px;
		border-radius: 8px;
		font-weight: $font-weight-medium;
		text-decoration: none;
		border: 1px solid rgba(255, 255, 255, 0.3);
		color: #fff;
		&:hover {
			border-color: #fff;
		}
	}
	.learn-cta__btn--primary {
		background: $color-pe;
		border-color: $color-pe;
		color: #fff;
		&:hover {
			background: $color-pe-hover;
			border-color: $color-pe-hover;
		}
	}
</style>
