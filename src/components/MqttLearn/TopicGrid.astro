---
import { mqttCategoryGroups, topicHref } from '~/data/mqttLearn';

// Two-digit index for the mono category markers. The category order is a
// deliberate learning progression (fundamentals → … → comparisons), so the
// numbering encodes real reading order rather than decoration.
const pad = (n: number) => String(n).padStart(2, '0');
---

<nav class="topic-nav" aria-label="MQTT topic categories">
	{
		mqttCategoryGroups.map((group) => (
			<a class="topic-nav__link" href={`#${group.id}`}>
				{group.label}
			</a>
		))
	}
</nav>

<div class="topic-groups">
	{
		mqttCategoryGroups.map((group, i) => (
			<section class="topic-group" id={group.id}>
				<header class="topic-group__head">
					<span class="topic-group__idx" aria-hidden="true">
						{pad(i + 1)}
					</span>
					<h2 class="topic-group__label">{group.label}</h2>
					<span class="topic-group__rule" aria-hidden="true" />
					<span class="topic-group__count">{group.topics.length} guides</span>
				</header>
				<div class="topic-grid">
					{group.topics.map((t) => (
						<a class="topic-card" href={topicHref(t.slug)}>
							<h3 class="topic-card__title">{t.navLabel}</h3>
							<p class="topic-card__text">{t.quickAnswer}</p>
							<span class="topic-card__cta">
								Read the guide{' '}
								<span class="topic-card__arrow" aria-hidden="true">
									→
								</span>
							</span>
						</a>
					))}
				</div>
			</section>
		))
	}
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	// ── Jump nav ────────────────────────────────────────────────────
	// Monospace label chips — the technical accessory face used throughout
	// the hub — act as a quick index to each category section.
	.topic-nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
		width: 100%;
	}
	.topic-nav__link {
		display: inline-flex;
		align-items: center;
		padding: 8px 15px;
		border: 1px solid $color-border;
		border-radius: $radius-full;
		background: $color-bg-white;
		font-family: $font-family-mono;
		font-size: 13px;
		font-weight: $font-weight-medium;
		color: $color-text-secondary;
		text-decoration: none;
		transition:
			border-color $transition-fast,
			color $transition-fast,
			background-color $transition-fast;
		&:hover {
			border-color: rgba(31, 139, 77, 0.5);
			background: #eaf7ef;
			color: $color-pe-link;
		}
	}

	// ── Category sections ───────────────────────────────────────────
	.topic-groups {
		display: flex;
		flex-direction: column;
		gap: $spacing-16;
		width: 100%;
		margin-top: $spacing-12;
	}
	.topic-group {
		width: 100%;
		scroll-margin-top: calc(#{$header-height} + 24px);
	}
	// Descendant selectors (specificity 0,2,0) are required throughout this
	// header row: single-class scoped rules resolve to `:where(...)`-zeroed
	// specificity (0,1,0) and lose to base/user-agent element rules — notably
	// the UA `header { display: block }`, which otherwise defeats `display:flex`
	// and stacks the row. Same trap the `.topic-group__label` size hit before.
	.topic-groups .topic-group__head {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: $spacing-6;
	}
	.topic-groups .topic-group__idx {
		font-family: $font-family-mono;
		font-size: 14px;
		font-weight: $font-weight-semibold;
		letter-spacing: 0.04em;
		color: $color-pe-link;
		flex-shrink: 0;
	}
	.topic-groups .topic-group__label {
		font-size: 25px;
		font-weight: $font-weight-semibold;
		letter-spacing: -0.01em;
		color: $color-text-primary;
		margin: 0;
		flex-shrink: 0;
	}
	.topic-groups .topic-group__rule {
		flex: 1;
		height: 1px;
		min-width: 20px;
		background: linear-gradient(90deg, $color-border, rgba(235, 235, 235, 0));
	}
	.topic-groups .topic-group__count {
		flex-shrink: 0;
		font-family: $font-family-mono;
		font-size: 12.5px;
		letter-spacing: 0.02em;
		color: $color-text-muted;
		white-space: nowrap;
	}
	// On narrow screens the fixed-width label + count overflow the row and clip
	// the count. Drop the connecting rule, let the row wrap, and keep the count
	// right-aligned so it falls neatly under long labels instead of off-screen.
	@include media-down(sm) {
		.topic-groups .topic-group__head {
			flex-wrap: wrap;
			gap: 6px 10px;
		}
		.topic-groups .topic-group__label {
			font-size: 22px;
		}
		.topic-groups .topic-group__rule {
			display: none;
		}
		.topic-groups .topic-group__count {
			margin-left: auto;
		}
	}

	// ── Cards ───────────────────────────────────────────────────────
	.topic-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 18px;
		width: 100%;
		@include media-up(sm) {
			grid-template-columns: repeat(2, 1fr);
		}
		@include media-up(lg) {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.topic-card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 24px 24px 22px;
		border: 1px solid $color-border;
		border-radius: $radius-lg;
		background: $color-bg-white;
		text-decoration: none;
		box-shadow:
			0 1px 2px rgba(23, 24, 28, 0.04),
			0 10px 24px -18px rgba(23, 24, 28, 0.14);
		transition:
			transform $transition-fast,
			border-color $transition-fast,
			box-shadow $transition-fast;
		&:hover {
			transform: translateY(-3px);
			border-color: rgba(31, 139, 77, 0.45);
			box-shadow:
				0 14px 30px -12px rgba(31, 139, 77, 0.28),
				0 3px 10px rgba(23, 24, 28, 0.05);
		}
	}
	.topic-card__title {
		font-size: 18px;
		font-weight: $font-weight-semibold;
		line-height: 1.3;
		color: $color-text-primary;
		margin: 0 0 10px;
		transition: color $transition-fast;
	}
	.topic-card:hover .topic-card__title {
		color: $color-pe-link;
	}
	.topic-card__text {
		font-size: 14px;
		line-height: 1.62;
		color: $color-text-secondary;
		margin: 0 0 18px;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.topic-card__cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: auto;
		font-family: $font-family-mono;
		font-size: 13px;
		font-weight: $font-weight-medium;
		color: $color-pe-link;
	}
	.topic-card__arrow {
		display: inline-block;
		transition: transform $transition-fast;
	}
	.topic-card:hover .topic-card__arrow {
		transform: translateX(4px);
	}

	@media (prefers-reduced-motion: reduce) {
		.topic-card,
		.topic-card__arrow,
		.topic-card__title {
			transition: none;
		}
		.topic-card:hover {
			transform: none;
		}
		.topic-card:hover .topic-card__arrow {
			transform: none;
		}
	}
</style>
