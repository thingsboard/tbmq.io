{
	/* Scroll-reveal for marketing pages: elements marked `.reveal` inside <main>
fade + slide in as they enter the viewport (stagger via `--reveal-delay`).
One shared component so the threshold/easing contract can't drift between the
pages that use it. Render it once per page, after <main>. */
}

<script>
	// Scroll reveal: fade + slide elements in as they enter the viewport.
	const main = document.querySelector('main');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (main && !reduceMotion && 'IntersectionObserver' in window) {
		main.classList.add('reveal-ready');
		const observer = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('in');
						obs.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 }
		);
		main.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
	}
</script>

<style is:global>
	/* Scroll-reveal: hidden state is only applied once JS marks the page ready,
	   so the content stays visible without JS or with reduced motion. */
	main.reveal-ready .reveal {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.6s ease,
			transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
		transition-delay: var(--reveal-delay, 0ms);
		will-change: opacity, transform;
	}

	main.reveal-ready .reveal.in {
		opacity: 1;
		transform: none;
	}
</style>
