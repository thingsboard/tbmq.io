---
import { Icon } from 'astro-icon/components';

const ports = [
	{ label: 'MQTT (TCP)', value: '1883' },
	{ label: 'MQTTS (TLS)', value: '8883' },
	{ label: 'WS (WebSocket)', value: '8084' },
	{ label: 'WSS (WebSocket TLS)', value: '443' },
];

const tabs = [
	{
		id: 'sub',
		label: 'Subscribe',
		code: 'mosquitto_sub -d -h demo.tbmq.io -p 1883 -q 1 \\\n  -t sensors/temperature -u demo',
	},
	{
		id: 'pub',
		label: 'Publish',
		code: 'mosquitto_pub -d -h demo.tbmq.io -p 1883 -q 1 \\\n  -t sensors/temperature -m 25 -u demo',
	},
	{
		id: 'tls',
		label: 'Subscribe (TLS)',
		code: 'mosquitto_sub -d -h demo.tbmq.io -p 8883 -q 1 \\\n  -t sensors/temperature -u demo \\\n  --cafile tbmq-demo-root-ca.pem',
	},
	{
		id: 'pubtls',
		label: 'Publish (TLS)',
		code: 'mosquitto_pub -d -h demo.tbmq.io -p 8883 -q 1 \\\n  -t sensors/temperature -m 25 -u demo \\\n  --cafile tbmq-demo-root-ca.pem',
	},
];
---

<section id="ld-connect">
	<div class="inner">
		<p class="kicker reveal">No signup required</p>
		<h2 class="reveal">Connect to our free public MQTT broker</h2>
		<p class="lead reveal">
			Point any MQTT client at the public demo broker. Use the connection details below — the examples use <a
				href="https://mosquitto.org/download/"
				target="_blank"
				rel="noopener noreferrer">mosquitto</a
			>, a widely used open-source CLI client.
		</p>

		<div
			class="flow reveal"
			role="img"
			aria-label="Connection flow: your MQTT client connects to the demo.tbmq.io broker, which publishes and subscribes with the TBMQ dashboard"
		>
			<div class="flow-node">
				<span class="flow-ic"><Icon name="tabler:device-desktop" /></span>
				<span class="flow-title">Your MQTT client</span>
				<span class="flow-note">mosquitto</span>
			</div>
			<div class="flow-conn">
				<span class="flow-label">Connect</span>
				<span class="flow-track"><i></i></span>
			</div>
			<div class="flow-node core">
				<span class="flow-ic"><Icon name="tabler:shield-check" /></span>
				<span class="flow-title">demo.tbmq.io broker</span>
				<span class="flow-note">public MQTT</span>
			</div>
			<div class="flow-conn">
				<span class="flow-label">Pub / Sub</span>
				<span class="flow-track"><i></i></span>
			</div>
			<div class="flow-node">
				<span class="flow-ic"><Icon name="tabler:layout-dashboard" /></span>
				<span class="flow-title">TBMQ dashboard</span>
				<span class="flow-note">web UI</span>
			</div>
		</div>

		<div class="grid">
			<!-- Connection details card -->
			<div class="conn-card reveal">
				<div class="conn-head">
					<div class="conn-head-host">
						<span class="conn-head-label">Host</span>
						<span class="conn-host">demo.tbmq.io</span>
					</div>
					<button class="copy" data-copy="demo.tbmq.io" aria-label="Copy host">Copy</button>
				</div>
				<div class="conn-rows">
					{
						ports.map((p) => (
							<div class="conn-row">
								<span class="conn-label">{p.label}</span>
								<button
									type="button"
									class="conn-value port copy"
									data-copy={p.value}
									title={`Copy ${p.value}`}
									aria-label={`Copy ${p.label} port ${p.value}`}
								>
									{p.value}
								</button>
							</div>
						))
					}
					<div class="conn-row">
						<span class="conn-label">Username</span>
						<span class="conn-value">demo</span>
					</div>
					<div class="conn-row">
						<span class="conn-label">Password</span>
						<span class="conn-value muted">None required</span>
					</div>
					<div class="conn-row">
						<span class="conn-label">CA Certificate</span>
						<a
							class="conn-value link"
							href="/resources/tbmq-demo-root-ca.pem"
							download="tbmq-demo-root-ca.pem"
							title="Download certificate"
						>
							tbmq-demo-root-ca.pem
						</a>
					</div>
				</div>
			</div>

			<!-- Tabbed CLI examples -->
			<div class="tabs reveal" data-ld-tabs style="--reveal-delay: 90ms">
				<div class="tab-bar" role="tablist">
					{
						tabs.map((t, i) => (
							<button
								class:list={['tab', { active: i === 0 }]}
								role="tab"
								id={`ld-tab-${t.id}`}
								aria-controls={`ld-panel-${t.id}`}
								aria-selected={i === 0 ? 'true' : 'false'}
								data-tab={t.id}
							>
								{t.label}
							</button>
						))
					}
				</div>
				{
					tabs.map((t, i) => (
						<div
							class:list={['tab-panel', { active: i === 0 }]}
							role="tabpanel"
							id={`ld-panel-${t.id}`}
							aria-labelledby={`ld-tab-${t.id}`}
							tabindex="0"
							data-panel={t.id}
						>
							{/* prettier-ignore */}
							<pre><code>{t.code}</code></pre>
							<button class="copy copy-code" data-copy={t.code} aria-label="Copy command">
								Copy
							</button>
						</div>
					))
				}
			</div>
		</div>

		<div class="safety reveal">
			<span class="safety-icon-wrap">
				<Icon name="tabler:alert-triangle" class="safety-icon" />
			</span>
			<p>
				<strong>Heads up:</strong> the demo is a shared public environment. All messages and topics are visible to other users.
				Please do not transmit sensitive data.
			</p>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	#ld-connect {
		background-color: $color-bg-light;
		padding: $spacing-20 $spacing-6;
	}

	.inner {
		@include container;
		max-width: 1100px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.kicker {
		text-transform: uppercase;
		letter-spacing: 0.16em;
		font-size: 14px;
		font-weight: $font-weight-semibold;
		color: $color-pe-dark;
		margin: 0 0 16px;
	}

	h2 {
		@include section-title;
		margin: 0 0 20px;
	}

	.lead {
		@include text-m;
		color: $color-text-secondary;
		max-width: 720px;
		margin: 0 0 48px;

		a {
			color: $color-pe-dark;
			text-decoration: underline;
		}
	}

	.flow {
		display: flex;
		align-items: stretch;
		justify-content: center;
		width: 100%;
		max-width: 920px;
		margin: 0 auto 48px;
	}

	.flow-node {
		flex: 1;
		max-width: 280px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		text-align: center;
		padding: 20px 16px;
		border-radius: 14px;
		background: $color-white;
		border: 1px solid $color-border;

		&.core {
			background: linear-gradient(180deg, rgba(23, 187, 82, 0.1), $color-white);
			border-color: rgba(23, 187, 82, 0.4);
		}
	}

	.flow-ic {
		width: 46px;
		height: 46px;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(23, 187, 82, 0.1);
		color: $color-pe-dark;
		border: 1px solid rgba(23, 187, 82, 0.3);

		:global(svg) {
			width: 26px;
			height: 26px;
		}
	}

	.flow-node.core .flow-ic {
		background: $color-pe-dark;
		color: $color-white;
		border-color: $color-pe-dark;
	}

	.flow-title {
		font-size: 15px;
		font-weight: $font-weight-semibold;
		color: $color-text-primary;
		line-height: 1.25;
	}

	.flow-note {
		font-size: 12.5px;
		color: $color-text-muted;
	}

	.flow-conn {
		flex: none;
		width: 96px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}

	.flow-label {
		font-size: 11px;
		font-weight: $font-weight-bold;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: $color-pe-dark;
	}

	.flow-track {
		position: relative;
		width: 100%;
		height: 2px;
		background: $color-border-light;

		&::before {
			content: '';
			position: absolute;
			right: -1px;
			top: -4px;
			border-left: 8px solid #bcd8c4;
			border-top: 5px solid transparent;
			border-bottom: 5px solid transparent;
		}

		i {
			position: absolute;
			top: -3px;
			left: 0;
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: $color-pe-dark;
			box-shadow: 0 0 8px rgba(23, 187, 82, 0.5);
			animation: flow-packet-x 2.6s linear infinite;
		}
	}

	.flow-conn:nth-of-type(4) .flow-track i {
		animation-delay: 1.3s;
	}

	@keyframes flow-packet-x {
		0% {
			left: -4%;
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		90% {
			opacity: 1;
		}
		100% {
			left: 104%;
			opacity: 0;
		}
	}

	@keyframes flow-packet-y {
		0% {
			top: -8%;
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		90% {
			opacity: 1;
		}
		100% {
			top: 104%;
			opacity: 0;
		}
	}

	@include media-down(md) {
		.flow {
			flex-direction: column;
			align-items: center;
		}

		.flow-node {
			max-width: 340px;
			width: 100%;
		}

		.flow-conn {
			width: auto;
			height: 60px;
			flex-direction: column;
		}

		.flow-track {
			width: 2px;
			height: 100%;

			&::before {
				right: auto;
				top: auto;
				left: -4px;
				bottom: -1px;
				border-left: 5px solid transparent;
				border-right: 5px solid transparent;
				border-top: 8px solid #bcd8c4;
			}

			i {
				left: -3px;
				top: 0;
				animation-name: flow-packet-y;
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flow-track i {
			display: none;
		}
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		width: 100%;
		text-align: left;

		@include media-up(lg) {
			grid-template-columns: 1fr 1fr;
		}
	}

	.conn-card,
	.tabs {
		background: $color-white;
		border: 1px solid $color-border;
		border-radius: 14px;
		overflow: hidden;
	}

	// Stretched by the grid to the height of the taller connection-details card,
	// so lay it out as a column and let the active panel claim the leftover space
	// — otherwise the panel stops at its command and the card's own white
	// background shows below the terminal.
	.tabs {
		display: flex;
		flex-direction: column;
	}

	.conn-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 16px 20px;
		border-bottom: 1px solid $color-border;
	}

	.conn-head-host {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.conn-head-label {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 12px;
		font-weight: $font-weight-semibold;
		color: $color-text-muted;
	}

	.conn-host {
		font-family: $font-family-mono;
		font-weight: $font-weight-semibold;
	}

	.conn-rows {
		padding: 8px 20px 16px;
	}

	.conn-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 8px 0;
		border-bottom: 1px solid $color-border-light;

		&:last-child {
			border-bottom: none;
		}
	}

	.conn-label {
		@include text-s;
		color: $color-text-muted;
	}

	.conn-value {
		font-family: $font-family-mono;
		font-size: 14px;
		color: $color-text-primary;

		// Shares the .copy button behaviour: the label swaps to "Copied ✓" on click.
		// The chip is right-aligned in the row, so it widens leftwards for that
		// label and the row label never moves.
		&.port {
			white-space: nowrap;
			// .copy (later in this sheet, same specificity as .conn-value) would
			// otherwise pull the chip down to its own 12px
			font-size: 14px;
			color: $color-pe-link;
			background: rgba(23, 187, 82, 0.1);
			border: 1px solid rgba(23, 187, 82, 0.3);
			border-radius: 6px;
			padding: 1px 8px;
			cursor: pointer;
			transition: $transition-fast;

			&:hover {
				// re-stated: .copy:hover would otherwise lighten the number to the
				// brand green, which is too low-contrast on the chip's tint
				color: $color-pe-link;
				background: rgba(23, 187, 82, 0.18);
				border-color: rgba(23, 187, 82, 0.5);
			}

			&.copied {
				color: $color-white;
				background: $color-pe-dark;
				border-color: $color-pe-dark;
			}
		}

		&.muted {
			font-family: inherit;
			font-style: italic;
			color: $color-text-muted;
		}

		&.link {
			color: $color-pe-dark;
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}
		}
	}

	.tab-bar {
		display: flex;
		border-bottom: 1px solid $color-border;
	}

	.tab {
		flex: 1;
		padding: 12px 8px;
		background: transparent;
		border: none;
		border-bottom: 2px solid transparent;
		font-size: 14px;
		font-weight: $font-weight-medium;
		color: $color-text-muted;
		cursor: pointer;
		transition: 0.2s;

		&.active {
			color: $color-pe-dark;
			border-bottom-color: $color-pe-dark;
		}
	}

	.tab-panel {
		display: none;
		position: relative;
		background: #0f1614;

		// grow into the card, never shrink below the command it holds
		&.active {
			display: block;
			flex: 1 0 auto;
		}

		pre {
			margin: 0;
			padding: 20px;
		}

		code {
			font-family: $font-family-mono;
			font-size: 13px;
			line-height: 1.7;
			white-space: pre-wrap;
			overflow-wrap: anywhere;
			color: #dfe9e2;
		}
	}

	.copy {
		border: 1px solid $color-border;
		background: $color-white;
		border-radius: 6px;
		padding: 4px 10px;
		font-size: 12px;
		color: $color-text-secondary;
		cursor: pointer;
		transition: 0.2s;

		&:hover {
			border-color: $color-pe-dark;
			color: $color-pe-dark;
		}

		&.copied {
			color: $color-pe-dark;
			border-color: $color-pe-dark;
		}
	}

	.copy-code {
		position: absolute;
		top: 12px;
		right: 12px;
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.18);
		color: #cfe8d6;

		&:hover {
			background: rgba(255, 255, 255, 0.14);
			border-color: rgba(255, 255, 255, 0.3);
			color: $color-white;
		}
	}

	.safety {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		@include text-s;
		color: $color-text-primary;
		background: rgba(255, 171, 0, 0.14);
		border: 1px solid rgba(255, 171, 0, 0.5);
		border-left: 4px solid #f5a300;
		border-radius: 10px;
		padding: 16px 20px;
		margin: 32px 0 0;
		max-width: 760px;
		text-align: left;

		p {
			margin: 0;
		}

		strong {
			color: #b26a00;
		}
	}

	// The wrapper is exactly one text line tall (text-s line-height) and centers
	// the icon, so with the container's flex-start alignment the icon sits level
	// with the first line ("Heads up:") — no fragile pixel nudge needed.
	.safety-icon-wrap {
		display: flex;
		align-items: center;
		height: 24px;
		flex-shrink: 0;
	}

	:global(.safety-icon) {
		width: 20px;
		height: 20px;
		color: #f5a300;
	}
</style>

<script>
	// Tab switcher
	document.querySelectorAll<HTMLElement>('[data-ld-tabs]').forEach((root) => {
		const tabs = root.querySelectorAll<HTMLButtonElement>('.tab');
		const panels = root.querySelectorAll<HTMLElement>('.tab-panel');
		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const id = tab.dataset.tab;
				tabs.forEach((t) => {
					const on = t === tab;
					t.classList.toggle('active', on);
					t.setAttribute('aria-selected', on ? 'true' : 'false');
				});
				panels.forEach((p) => p.classList.toggle('active', p.dataset.panel === id));
			});
		});
	});

	// Copy-to-clipboard
	document.querySelectorAll<HTMLButtonElement>('.copy').forEach((btn) => {
		btn.addEventListener('click', () => {
			if (btn.classList.contains('copied')) return;
			navigator.clipboard
				.writeText(btn.dataset.copy ?? '')
				.then(() => {
					const original = btn.textContent;
					btn.textContent = 'Copied ✓';
					btn.classList.add('copied');
					setTimeout(() => {
						btn.textContent = original;
						btn.classList.remove('copied');
					}, 1500);
				})
				.catch(() => {});
		});
	});

	// Live status pinger — updates the hero pill created in LiveDemoHero
	const statusEl = document.querySelector<HTMLElement>('[data-ld-status]');
	if (statusEl) {
		const statusText = statusEl.querySelector('.status-text');
		fetch('https://demo.tbmq.io', { mode: 'no-cors' })
			.then(() => {
				statusEl.classList.add('online');
				if (statusText) statusText.textContent = 'Online';
			})
			.catch(() => {
				statusEl.classList.add('offline');
				if (statusText) statusText.textContent = 'Offline';
			});
	}
</script>
