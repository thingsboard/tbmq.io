---
/**
 * The legal pages, linked from both footers, then the button that reopens the cookie
 * preferences (`CookieConsent.astro`). Colour comes from the host via
 * `--legal-color` / `--legal-hover-color`, the way `SocialNetworks` reads `--sn-color`.
 */
import { PRIVACY_CHOICES_LABEL, footerLegalLinks } from '@data/privacy';
---

<nav class="legal" aria-label="Legal">
	{footerLegalLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
	<button type="button" class="cookie-settings legal-choice" data-cc="show-preferences">
		{PRIVACY_CHOICES_LABEL}
	</button>
</nav>

<style>
	.legal {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;
	}

	.legal a,
	.legal .legal-choice {
		font-size: 0.875rem;
		color: var(--legal-color, #8e8292);
		text-decoration: none;
		white-space: nowrap;
		transition: color 300ms;
	}

	.legal a:hover,
	.legal .legal-choice:hover {
		color: var(--legal-hover-color, #fff);
		text-decoration: underline;
	}
</style>
