---
interface ComparisonRow {
	label: string;
	href?: string;
	ce?: boolean;
	pe?: boolean;
	ceText?: string;
	peText?: string;
	ceLinkHref?: string;
	peLinkHref?: string;
}

interface ComparisonGroup {
	category: string;
	rows: ComparisonRow[];
}

interface Props {
	title?: string;
	groups: ComparisonGroup[];
	/** PE column accent (heading, tick, links). Passed verbatim into an inline
	 *  style, so CSS `var()` strings work as well as literals. */
	peColor?: string;
	centerTitle?: boolean;
	bgColor?: string;
	noSkew?: boolean;
	fixedMaxWidth?: boolean;
}

const {
	title = 'Feature comparison',
	groups,
	peColor = 'var(--color-brand)',
	centerTitle = false,
	bgColor = '#f4f4f4',
	noSkew = false,
	fixedMaxWidth = false,
} = Astro.props;

// The CE and PE columns share one shape; the header row and every body cell
// render from this single descriptor so the two columns — and their visible
// vs. sr-only edition labels — can't drift apart when a new cell state is added.
// Only the three accessors vary per row; everything else is static config.
const EDITION_COLUMNS = [
	{
		colClass: 'col-ce',
		edition: 'Community Edition',
		abbreviation: 'CE',
		linkClass: 'cell-link',
		included: (row: ComparisonRow) => row.ce,
		text: (row: ComparisonRow) => row.ceText,
		linkHref: (row: ComparisonRow) => row.ceLinkHref,
	},
	{
		colClass: 'col-pe',
		edition: 'Professional Edition',
		abbreviation: 'PE',
		linkClass: 'cell-link pe-link',
		included: (row: ComparisonRow) => row.pe,
		text: (row: ComparisonRow) => row.peText,
		linkHref: (row: ComparisonRow) => row.peLinkHref,
	},
];
---

<section
	class="comparison-table"
	style={`--comparison-pe-color: ${peColor}; --comparison-bg-color: ${bgColor}`}
	data-center-title={centerTitle ? 'true' : undefined}
	data-no-skew={noSkew ? 'true' : undefined}
	data-fixed-max-width={fixedMaxWidth ? 'true' : undefined}
>
	<div class:list={['comparison-inner', { 'comparison-inner--fixed': fixedMaxWidth }]}>
		<h2 class="comparison-title">{title}</h2>

		<div class="comparison-header">
			<div class="col-feature">Features</div>
			{
				EDITION_COLUMNS.map((col) => (
					<div class={col.colClass}>
						<span class="long">{col.edition}</span>
						<span class="short">{col.abbreviation}</span>
					</div>
				))
			}
		</div>

		{
			groups.map((group) => (
				<div class="comparison-group">
					<div class="group-header">
						<span>{group.category}</span>
					</div>
					{group.rows.map((row) => {
						const Tag = row.href ? 'a' : 'div';
						return (
							<Tag
								href={row.href}
								target={row.href?.startsWith('http') ? '_blank' : undefined}
								rel={row.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
								class="comparison-row"
							>
								<div class="col-feature">{row.label}</div>
								{EDITION_COLUMNS.map((col) => (
									<div class={col.colClass}>
										{col.text(row) ? (
											col.linkHref(row) ? (
												<a href={col.linkHref(row)} target="_blank" rel="noopener noreferrer" class={col.linkClass}>
													{col.text(row)}
												</a>
											) : (
												<span>{col.text(row)}</span>
											)
										) : col.included(row) ? (
											<>
												{/* The tick inherits its column's accent via currentColor — see the
												    .mark colour rules below — so it can't drift from the heading. */}
												<svg class="mark" width="20" height="20" viewBox="0 0 18 18" fill="none" aria-hidden="true">
													<circle cx="9" cy="9" r="9" fill="currentColor" fill-opacity="0.08" />
													<path
														d="M4.92725 9.58194L7.25466 11.9093L13.0732 6.09082"
														stroke="currentColor"
														stroke-width="2"
														stroke-linecap="round"
														stroke-linejoin="round"
													/>
												</svg>
												<span class="sr-only">Included in {col.edition}</span>
											</>
										) : (
											<>
												<span class="empty" aria-hidden="true">
													&nbsp;
												</span>
												<span class="sr-only">Not included in {col.edition}</span>
											</>
										)}
									</div>
								))}
							</Tag>
						);
					})}
				</div>
			))
		}
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	// CE column accent — one definition read by the heading and its tick, so the
	// two can't drift apart (the PE pair shares --comparison-pe-color the same way).
	$ce-accent: #0d417b;

	.comparison-table {
		position: relative;
		width: 100%;
		// The ::before pseudo uses `width: 100vw` for a full-bleed background.
		// `100vw` would normally trigger a page-wide horizontal scrollbar
		// because it includes the vertical scrollbar's gutter; that's
		// prevented globally by `body { overflow-x: clip }` in _base.scss.
		// No section-level clip needed here — and importantly, NOT adding
		// one preserves the skewY(-6deg) variant's vertical bleed into
		// adjacent sections (an explicit visual intent that section-level
		// clip would have broken).
		padding: 100px 1.875rem 6rem;
		padding-top: 200px;
		background-color: transparent;

		&[data-no-skew] {
			padding-top: 100px;
		}

		// Background (renders above section's default background)
		&::before {
			content: '';
			position: absolute;
			width: 100vw;
			height: 103%;
			background-color: var(--comparison-bg-color, #f4f4f4);
			z-index: 0;
			left: 49.4%;
			transform: translateX(-50%) skewY(-6deg);
			top: -67px;
		}

		&[data-no-skew]::before {
			transform: translateX(-50%);
			top: 0;
			height: 100%;
		}

		@media screen and (min-width: 1500px) {
			padding-left: 6.25rem;
			padding-right: 6.25rem;
		}

		@media screen and (max-width: 768px) {
			padding: 3rem 1.25rem;
		}
	}

	.comparison-inner {
		position: relative;
		z-index: 1;
		max-width: 1200px;
		margin: 0 auto;

		@media screen and (min-width: 1500px) {
			max-width: 1400px;
		}

		&--fixed {
			@media screen and (min-width: 1500px) {
				max-width: 1200px;
			}
		}
	}

	.comparison-title {
		font-size: $font-size-4xl;
		font-weight: $font-weight-medium;
		line-height: 1.33;
		color: #202020;
		margin: 0 0 2rem;
		text-align: left;

		[data-center-title] & {
			text-align: center;
		}

		@media screen and (max-width: 900px) {
			font-size: $font-size-3xl;
		}
	}

	.comparison-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		background-color: $color-white;
		border-radius: 4px;
		height: 84px;
		margin-bottom: 4px;
		// Match the body rows' 20px horizontal padding so the flex columns
		// distribute over the same width. Without this, header columns are
		// 40px wider than body columns and the header labels sit ~13-18px
		// to the right of the checkmarks below them.
		padding: 0 1.25rem;

		.col-feature {
			flex: 1;
			font-size: $font-size-2xl;
			font-weight: $font-weight-medium;
			line-height: 2.25rem;
			color: $color-text-primary;

			@media screen and (max-width: 900px) {
				margin-left: 0;
				text-align: left;
			}
		}

		.col-ce {
			flex: 1;
			text-align: center;
			font-size: $font-size-2xl;
			font-weight: $font-weight-medium;
			line-height: 2.25rem;
			color: $ce-accent;

			@media screen and (max-width: 900px) {
				flex: 0.3;
			}

			@media screen and (max-width: 500px) {
				// Tight CE/PE columns at narrow viewports: smaller flex pushes
				// them rightward (Features eats the extra space) and brings
				// the two icon columns closer together. Must match the body
				// row .col-ce flex so headers sit centered above the
				// checkmarks below.
				flex: 0.18;
			}
		}

		.col-pe {
			flex: 1;
			text-align: center;
			font-size: $font-size-2xl;
			font-weight: $font-weight-medium;
			line-height: 2.25rem;
			color: var(--comparison-pe-color);

			@media screen and (max-width: 900px) {
				flex: 0.3;
			}

			@media screen and (max-width: 500px) {
				flex: 0.18;
			}
		}

		.short {
			display: none;
		}

		@media screen and (max-width: 900px) {
			.long {
				display: none;
			}
			.short {
				display: inline;
			}
		}
	}

	.comparison-group {
		background-color: $color-white;
		border-radius: 4px;
		padding: 4px;
		margin-bottom: 4px;
	}

	.group-header {
		display: flex;
		align-items: center;
		padding: 0.625rem 1.25rem;
		font-weight: $font-weight-medium;
		font-size: 1.125rem;
		line-height: 1.875rem;
		color: #3b3c3c;
		background-color: #f5f9f8;
		border-bottom: none;
	}

	.comparison-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 12px 20px;
		// `min-height` (not `max-height`) so single-line rows keep their
		// comfortable 50px baseline but multi-line wrapped labels
		// ("X.509 certificate chain authentication", "MQTT sessions and
		// subscriptions management" on mobile) can grow to fit instead
		// of overflowing past their border-bottom into the next row.
		min-height: 50px;
		border-bottom: 2px solid #e0e0e0;
		text-decoration: none;
		text-decoration-color: #212121;
		position: relative;
		transition: background $transition-base;

		&:last-child {
			border-bottom: none;
			min-height: 48px;
		}

		// Hover is gated behind `@media (hover: hover) and (min-width: 901px)`:
		// - the hover query stops touch devices from firing the effect on
		//   tap-and-drag (no real hover state),
		// - the width query stops it from firing on mobile width even in
		//   Chrome dev-tools' responsive mode (where the primary input
		//   stays "mouse" and the hover query still resolves to true).
		// On narrow viewports the multi-line wrapped labels are tall
		// enough that the +1px font-grow + line-height: 28px overflows
		// the row's 50px max-height and overlaps neighbors.
		@media (hover: hover) and (min-width: 901px) {
			&[href]:hover {
				background-color: #f9f9f9;
				text-decoration: underline;
				text-decoration-color: #212121;

				&::before {
					content: '';
					height: 44px;
					display: block;
					border: 1px solid #00695c;
					position: absolute;
					left: 0;
				}

				.col-feature {
					font-size: 15px;
					line-height: 28px;
				}

				.col-ce .mark,
				.col-pe .mark {
					width: 24px;
					height: 24px;
				}
			}
		}

		.col-feature {
			flex: 1;
			font-size: $font-size-sm;
			font-weight: $font-weight-normal;
			line-height: 1.5rem;
			color: #212121;
			transition: font-size 0.3s;

			@media screen and (max-width: 900px) {
				padding-right: 0;
			}

			@media screen and (max-width: 500px) {
				font-size: 12px;
			}
		}

		.col-ce,
		.col-pe {
			flex: 1;
			display: flex;
			align-items: center;
			justify-content: center;
			// Allow shrinking + text wrap so cells with free-form text
			// (e.g. "Coming soon", "Advanced (coming soon)") don't
			// overflow the column border on narrow viewports.
			min-width: 0;
			text-align: center;
			overflow-wrap: break-word;

			.mark {
				width: 20px;
				height: 20px;
				// `.col-ce` is itself a flex container, and the parent row has
				// `min-width: 0` on this cell so the cell can collapse when a
				// neighbour row contains an unbreakable token like
				// "(MQTT/CoAP/HTTP/SNMP/LWM2M)". Without `flex-shrink: 0`,
				// the svg's default flex-shrink: 1 lets it shrink with the cell
				// and the tick renders smaller in that row only.
				flex-shrink: 0;
			}

			@media screen and (max-width: 900px) {
				flex: 0.3;
			}

			@media screen and (max-width: 500px) {
				// Mirror the header CE/PE flex so icon cells stay narrow and
				// right-aligned at mobile.
				flex: 0.18;

				// Cells with link text (e.g. "Community", "Advanced + SLA"
				// in the Support Model row) widen to keep the labels from
				// overflowing into each other. Icon-only cells stay at 0.18
				// so checkmarks remain tightly grouped under the headers.
				&:has(.cell-link) {
					flex: 0.45;
				}
			}
		}

		// Each column's tick takes its column accent (via currentColor on the
		// inline svg): CE the navy its heading uses, PE whatever peColor is set to.
		.col-ce .mark {
			color: $ce-accent;
		}

		.col-pe .mark {
			color: var(--comparison-pe-color);
		}

		.cell-link {
			font-size: $font-size-sm;
			color: $color-primary;
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}

			&.pe-link {
				color: var(--comparison-pe-color);
			}
		}
	}
</style>
