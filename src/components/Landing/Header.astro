---
import HeaderContent from './HeaderContent.astro';
import { Products } from '@models/site.models';
import type { HeaderConfig } from '@util/header-config';

// The header of a `BaseLayout` page. Docs pages get theirs from Starlight (`starlight/Header.astro`);
// both render `HeaderContent` inside a `header.header`, which its styles and scripts key on.
interface Props {
	gitHubPlatform?: Products;
	headerConfig: HeaderConfig;
}

const { gitHubPlatform, headerConfig } = Astro.props;
---

<header class="header">
	<HeaderContent gitHubPlatform={gitHubPlatform} headerConfig={headerConfig} />
</header>
