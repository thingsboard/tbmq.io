---
import { Icon } from 'astro-icon/components';
import mark from '~/assets/images/docs/product-selector/tbmq.svg?raw';
import { DEMO_SIGNUP } from '@data/cta-destinations';

/**
 * What "Try for free" offers: an account on the public demo broker, or an installation of your own.
 * Any `data-demo-dialog` link opens it (`TRY_FREE` in `data/cta-destinations`); that link's own href
 * is the demo sign-up, for when scripts are off.
 *
 * The header's "Sign in" does not come here: an account can only be in one place, so that link goes
 * straight to the demo.
 */
---

<dialog class="dd print:hidden" aria-labelledby="demo-dialog-title" data-demo-dialog-root>
	<div class="dd__panel">
		<span class="dd__badge" aria-hidden="true" set:html={mark} />

		<form method="dialog">
			<button type="submit" class="dd__close" aria-label="Close">
				<Icon name="tabler:x" size="20" aria-hidden="true" />
			</button>
		</form>

		<p class="dd__eyebrow">TBMQ live demo</p>
		<p class="dd__title" id="demo-dialog-title">Try TBMQ in your browser</p>
		<p class="dd__lede">
			A free account on our public broker. Open the TBMQ UI and connect your MQTT clients. No credit card required.
		</p>

		<div class="dd__options">
			<a
				class="dd__option gtm_button"
				id="TryItNow_LiveDemo"
				href={DEMO_SIGNUP}
				target="_blank"
				rel="noopener noreferrer"
				data-demo-option
			>
				<span class="dd__option-icon">
					<Icon name="tabler:player-play" size="22" aria-hidden="true" />
				</span>
				<span class="dd__option-name">Live demo</span>
				<span class="dd__option-note">Hosted at demo.tbmq.io</span>
				<Icon name="tabler:chevron-right" size="20" class="dd__go" aria-hidden="true" />
			</a>
		</div>

		<p class="dd__alt">
			Rather run it yourself?
			<a id="TryItNow_Install" class="gtm_button" href="/docs/installation/">
				<Icon name="tabler:server-2" size="20" class="dd__alt-icon" aria-hidden="true" />
				Install on your own servers
				<Icon name="tabler:chevron-right" size="16" class="dd__alt-go" aria-hidden="true" />
			</a>
		</p>
	</div>
</dialog>

<script>
	import { bindModalDialog } from '@util/modal-dialog';

	const dlg = document.querySelector<HTMLDialogElement>('dialog[data-demo-dialog-root]');
	if (dlg) {
		// Must match the dialog's transition below.
		const modal = bindModalDialog(dlg, { fadeMs: 200, closingClass: 'dd--closing' });

		const open = (trigger: HTMLElement) => {
			if (!dlg.open) {
				// Close any open menu first (`SiteMenu` handles `sm-close`). `from` lets the menu move focus off a
				// trigger it is about to hide, so the dialog returns focus to a visible control.
				const makeCloseEvent = () => new CustomEvent('sm-close', { detail: { from: trigger } });
				document.querySelector('[data-sm-sheet]:not([hidden])')?.dispatchEvent(makeCloseEvent());
				document.querySelector('nav.sm')?.dispatchEvent(makeCloseEvent());
			}
			modal.open();
			// `showModal` lands on the close button; the likeliest answer takes the focus instead.
			dlg.querySelector<HTMLElement>('[data-demo-option]')?.focus();
		};

		dlg.addEventListener('click', (e) => {
			// The demo opens in a new tab, so the dialog closes behind it.
			if ((e.target as Element).closest('[data-demo-option]')) modal.close();
		});

		dlg.querySelector('.dd__close')?.addEventListener('click', (e) => {
			e.preventDefault();
			modal.close();
		});

		for (const trigger of document.querySelectorAll<HTMLElement>('[data-demo-dialog]')) {
			trigger.setAttribute('aria-haspopup', 'dialog');
			trigger.addEventListener('click', (e) => {
				// A modified click keeps its meaning: the link's own href, in a new tab or window.
				if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				e.preventDefault();
				// Opens after the tap paints: a modal restyles the whole page.
				requestAnimationFrame(() => setTimeout(() => open(trigger)));
			});
		}
	}
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The mark's tile, which straddles the panel's top edge.
	$badge: 72px;

	// A transparent viewport-filling box: a modal dialog clips its overflow and the badge hangs above the
	// panel. The UA hides a closed dialog with `display: none`, so `display` is set on `[open]` only.
	.dd {
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		place-items: center;
		opacity: 0;
		transition:
			opacity 0.2s ease,
			display 0.2s ease allow-discrete,
			overlay 0.2s ease allow-discrete;

		&[open] {
			display: grid;
			opacity: 1;

			@starting-style {
				opacity: 0;
			}
		}

		&[open].dd--closing {
			opacity: 0;
		}

		&::backdrop {
			background-color: transparent;
			transition:
				background-color 0.2s ease,
				display 0.2s ease allow-discrete,
				overlay 0.2s ease allow-discrete;
		}

		&[open]::backdrop {
			background-color: rgb(0 0 0 / 50%);

			@starting-style {
				background-color: transparent;
			}
		}

		&[open].dd--closing::backdrop {
			background-color: transparent;
		}

		@include media-down(sm) {
			place-items: end center;
		}

		:where(p) {
			margin: 0;
		}
	}

	.dd__panel {
		position: relative;
		display: flex;
		flex-direction: column;
		width: min(560px, calc(100vw - 32px));
		// Room for the badge that hangs over the top edge.
		margin-top: calc($badge / 2);
		padding: calc($badge / 2 + #{$spacing-6}) $spacing-8 $spacing-8;
		border-radius: $radius-xl;
		box-shadow: var(--elev-dialog);
		background-color: var(--color-bg-surface);
		// The brand's glow falling from the panel's top edge.
		background-image: radial-gradient(
			95% 105% at 50% 0%,
			color-mix(in srgb, var(--color-brand) 17%, transparent),
			color-mix(in srgb, var(--color-brand) 7%, transparent) 42%,
			transparent 84%
		);
		text-align: center;
		color: var(--color-text);

		@include media-down(sm) {
			width: 100vw;
			padding: calc($badge / 2 + #{$spacing-5}) $spacing-4 $spacing-8;
			border-radius: $radius-xl $radius-xl 0 0;
		}
	}

	.dd__badge {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translate(-50%, -50%);
		display: grid;
		place-items: center;
		width: $badge;
		height: $badge;
		border-radius: 32%;
		background-color: var(--color-brand);
		background-image: linear-gradient(150deg, rgb(255 255 255 / 24%), rgb(255 255 255 / 0%) 62%);
		box-shadow: 0 6px 18px rgb(0 0 0 / 12%);
		// White on the green; in the dark theme, where the brand is a pale mint, its own dark ink.
		color: var(--color-brand-contrast);

		:global(svg) {
			display: block;
			width: 62%;
			height: auto;
		}
	}

	.dd__close {
		position: absolute;
		top: $spacing-4;
		right: $spacing-4;
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--color-text-secondary);
		cursor: pointer;

		&:hover {
			background: color-mix(in srgb, currentColor 10%, transparent);
			color: var(--color-text);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}
	}

	.dd__eyebrow {
		@include text-s;
		margin-bottom: 6px;
		font-weight: $font-weight-medium;
		line-height: 1.2;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-brand);
	}

	.dd__title {
		@include card-title;
		margin-bottom: $spacing-2;
		font-weight: $font-weight-bold;
		text-wrap: balance;
	}

	.dd__lede {
		@include text-s;
		max-width: 56ch;
		margin: 0 auto $spacing-6;
		line-height: 22px;
		text-wrap: balance;
		color: var(--color-text-secondary);
	}

	.dd__options {
		display: grid;
		gap: $spacing-3;
		margin-bottom: $spacing-5;
		text-align: left;
	}

	.dd__option {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		column-gap: 14px;
		align-items: center;
		padding: $spacing-4;
		border-radius: $radius-lg;
		background-color: var(--color-bg-surface);
		box-shadow:
			0 1px 2px rgb(0 0 0 / 6%),
			0 10px 20px -8px rgb(0 0 0 / 10%);
		color: inherit;
		text-decoration: none;
		transition: box-shadow 0.18s ease;

		&:hover,
		&:focus-visible {
			box-shadow: 0 12px 28px rgb(0 0 0 / 7%);

			.dd__option-name {
				text-decoration: underline;
				text-underline-offset: 3px;
			}
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 3px;
		}
	}

	.dd__option-icon {
		grid-column: 1;
		grid-row: 1 / 3;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-brand) 12%, transparent);
		color: var(--color-brand);
	}

	.dd__option-name {
		@include text-tab;
		font-weight: $font-weight-bold;
	}

	.dd__option-note {
		@include text-s;
		line-height: 1.4;
		color: var(--color-text-secondary);
	}

	.dd__go {
		grid-column: 3;
		grid-row: 1 / 3;
		color: var(--color-text-muted);
	}

	// Flex, so the link's text lines up with the question rather than with the icons' baseline.
	.dd__alt {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 4px $spacing-2;
		@include text-s;
		line-height: 1.5;
		color: var(--color-text-secondary);

		a {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			border-radius: $radius-sm;
			color: var(--color-text);
			font-weight: $font-weight-medium;
			text-decoration: none;

			// Only where there is a pointer to hover with: on touch the state sticks to wherever the tap
			// that opened the dialog landed.
			@media (hover: hover) {
				&:hover {
					text-decoration: underline;
				}
			}

			&:focus-visible {
				outline: 2px solid var(--focus-ring);
				outline-offset: 3px;
			}
		}
	}

	.dd__alt-icon {
		color: var(--color-brand);
	}

	.dd__alt-go {
		margin-left: -3px;
	}
</style>
