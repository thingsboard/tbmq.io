---
import Navigation from './Navigation.astro';
import GitHubButton from './GitHubButton.astro';
import NButton from './NButton.astro';
import SearchButton from '../SearchButton.astro';
import ThemeToggle from '../ThemeToggle.astro';
import SmartImage from '@components/SmartImage.astro';
import { Icon } from 'astro-icon/components';
import { Products } from '@models/site.models';

interface Props {
	platformQuery?: string;
	gitHubPlatform?: Products;
}

const { platformQuery = '', gitHubPlatform } = Astro.props;
---

<div class="logo-burger">
	<a href="https://u24.gov.ua/" target="_blank" class="support-ukraine">
		<SmartImage
			src="/src/assets/images/support-ukraine-banner.webp"
			alt="Stand with Ukraine flag"
			width="48"
			height="31"
		/>
	</a>
	<a href="/" class="logo" aria-label="Link to homepage"></a>
	<div class="burger-group">
		<div class="icon-buttons">
			<ThemeToggle />
			<SearchButton />
		</div>
		<div class="divider"></div>
		<button onclick="Burger()" class="burger" aria-label="Burger menu">
			<Icon name="tabler:menu-2" class="icon-open" />
			<Icon name="tabler:x" class="icon-close" />
		</button>
	</div>
	<GitHubButton platform={gitHubPlatform} />
</div>

<!-- head-buttons is rendered BEFORE Navigation in the source so it parses
     and paints quickly. <Navigation> ships ~125 KiB of inline submenu
     markup; with that between <nav> and the right-side buttons, slow CPUs
     paint the centred nav before head-buttons exists, which made flexbox
     `space-between` pin the nav to the right edge and shift it left once
     head-buttons finally arrived (≈0.012 CLS). Visual order is restored
     with `order` in the header layout below. -->
<div class="head-buttons">
	<div class="icon-buttons">
		<ThemeToggle />
		<SearchButton />
	</div>
	<div class="divider"></div>
	<NButton id="Menu_Pricing" href="/pricing/" variant="text" class="price gtm_button"
		>Pricing</NButton
	>
	<NButton id="Menu_TryItNow" href="/installations/" variant="filled" class="try gtm_button"
		>Try it now</NButton
	>
</div>

<Navigation platformQuery={platformQuery} />

<script>
	// Burger menu toggle
	function Burger() {
		const header = document.querySelector('header.header');
		const body = document.body;

		if (header?.classList.contains('opened-burger')) {
			header.classList.remove('opened-burger');
			const subMenus = document.querySelectorAll(
				'nav.head-menu > ul > li > div.centered-sub > ul.sub-menu'
			);
			subMenus.forEach((menu) => menu.classList.remove('open-sub'));
			body.style.overflow = '';
		} else {
			header?.classList.add('opened-burger');
			body.style.overflow = 'hidden';
		}
	}

	// Make function available globally
	(window as any).Burger = Burger;

	// Swipe to open/close mobile menus:
	//   Starlight sidebar — swipe RIGHT from left edge to open, swipe LEFT to close
	//   Burger menu      — swipe LEFT from right edge to open, swipe RIGHT to close
	(function () {
		const OPEN_EDGE = 30; // px from screen edge that starts an open gesture
		const MIN_DIST = 60; // minimum horizontal travel to trigger
		const MAX_ANGLE = 35; // max degrees from horizontal (avoids triggering on scrolls)

		let startX = 0;
		let startY = 0;
		let tracking: 'sidebar' | 'burger' | null = null;

		function isSidebarOpen() {
			return document.body.hasAttribute('data-mobile-menu-expanded');
		}

		function isBurgerOpen() {
			return document.querySelector('header.header')?.classList.contains('opened-burger') ?? false;
		}

		function triggerSidebar() {
			(document.querySelector('starlight-menu-button button') as HTMLElement)?.click();
		}

		function triggerBurger() {
			(window as any).Burger?.();
		}

		document.addEventListener(
			'touchstart',
			(e) => {
				const t = e.touches[0];
				startX = t.clientX;
				startY = t.clientY;

				if (isSidebarOpen()) tracking = 'sidebar';
				else if (isBurgerOpen()) tracking = 'burger';
				else if (startX <= OPEN_EDGE) tracking = 'sidebar';
				else if (startX >= window.innerWidth - OPEN_EDGE) tracking = 'burger';
				else tracking = null;
			},
			{ passive: true }
		);

		document.addEventListener(
			'touchend',
			(e) => {
				const which = tracking;
				tracking = null;
				if (!which) return;

				const t = e.changedTouches[0];
				const dx = t.clientX - startX;
				const dy = t.clientY - startY;

				if (Math.abs(dx) < MIN_DIST) return;

				const angle = Math.abs(Math.atan2(Math.abs(dy), Math.abs(dx)) * (180 / Math.PI));
				if (angle > MAX_ANGLE) return;

				if (which === 'sidebar') {
					if (!isSidebarOpen() && dx > 0) triggerSidebar(); // swipe right → open
					else if (isSidebarOpen() && dx < 0) triggerSidebar(); // swipe left → close
				} else {
					if (!isBurgerOpen() && dx < 0) triggerBurger(); // swipe left from right edge → open
					else if (isBurgerOpen() && dx > 0) triggerBurger(); // swipe right → close
				}
			},
			{ passive: true }
		);
	})();
</script>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	header.header {
		position: fixed;
		top: var(--promo-cur, var(--promo-h, 0px)); // tracks the banner via the var; don't transition `top` (would desync)
		left: 0;
		// No `filter` here: the header itself never gets one (only .logo/.burger do),
		// and a filter on the header would make it the containing block for the fixed
		// promo banner inside it, breaking the banner's viewport anchoring on docs.
		transition: background-color 0.12s ease, box-shadow 0.12s ease, color 0.12s ease,
			border-color 0.12s ease;
		width: 100%;
		height: $header-height;
		z-index: 8888;
		border-bottom: none;
		background-color: var(--sl-color-bg-sidebar);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 20px;


		.logo-burger {
			position: relative;
			display: flex;
			height: 100%;
			align-items: center;
			gap: 0.875rem;
		}

		.head-buttons {
			// head-buttons is placed before <Navigation /> in DOM order to avoid
			// the centred-nav layout shift on slow CPUs. `order: 1` keeps it
			// visually after the nav (which keeps the default order: 0).
			order: 1;
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: 0.875rem;

			.icon-buttons {
				display: flex;
				align-items: center;
				gap: 0;
			}

			.divider {
				width: 1px;
				height: 32px;
				background-color: var(--sl-color-hairline-light);
				flex-shrink: 0;

				@media screen and (min-width: 1281px) and (max-width: 1499px) {
					display: none;
				}
			}

			.n-button {
				width: 90px;
				padding: 0;
				display: flex;
				align-items: center;
				justify-content: center;

				@media screen and (min-width: 1500px) {
					width: 110px;
				}

				&.price {
					color: var(--sl-color-white);
					border: 1px solid transparent;
				}
			}
		}

		.support-ukraine {
			display: flex;
			align-items: center;
			img {
				height: 31px;
				width: auto;
			}

			// Laptop widths — shrink the flag so the nav row doesn't wrap.
			@media screen and (min-width: 1281px) and (max-width: 1599px) {
				img {
					height: 20px;
				}
			}
		}

		.logo {
			position: relative;
			display: block;
			width: 140px;
			height: 60px;
			background-image: url(../../assets/images/landings/tbmq-logo.svg);
			background-size: contain;
			background-position: center center;
			background-repeat: no-repeat;

			[data-theme='dark'] & {
				filter: invert(100%) sepia(68%) saturate(0%) hue-rotate(350deg) brightness(113%)
					contrast(101%);
			}

			@media screen and (min-width: 1025px) {
				width: 180px;
			}

			// Laptop widths — smaller logo to keep the nav row from wrapping.
			@media screen and (min-width: 1281px) and (max-width: 1599px) {
				width: 120px;
			}

			// Small phones — shrink so the wordmark doesn't collide with the icons.
			@media screen and (max-width: 480px) {
				width: 110px;
			}
		}
	}

	.burger-group {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		right: 0;
		display: none;
		align-items: center;
		gap: 0.875rem;

		.icon-buttons {
			display: flex;
			align-items: center;
			gap: 0;
		}

		.divider {
			width: 1px;
			height: 32px;
			background-color: var(--sl-color-hairline-light);
			flex-shrink: 0;
		}
	}

	.burger {
		display: none;
		border: none;
		background: none;
		padding: 0;
		cursor: pointer;
		color: inherit;
		width: 32px;
		height: 32px;
		align-items: center;
		justify-content: center;

		svg {
			width: 28px;
			height: 28px;
		}

		.icon-close {
			display: none;
		}

		&:focus {
			outline: none;
		}
	}

	.opened-burger .burger {
		.icon-open {
			display: none;
		}

		.icon-close {
			display: block;
		}
	}

	// Marketing: banner + header are one sticky unit (wrapper in BaseLayout). It
	// scrolls until the banner is off-screen, then the header pins; the negative
	// margin-bottom keeps existing per-page $header-height offsets valid.
	// (Docs has no .tb-topbar — there the banner hides via scroll-driven --promo-cur.)
	.tb-topbar {
		position: sticky;
		top: calc(-1 * var(--promo-h, 0px));
		z-index: 8889;
		margin-bottom: calc(-1 * #{$header-height});
	}

	// Open mobile menu: lift the sticky unit above the cookie banner (9999).
	.tb-topbar:has(header.header.opened-burger) {
		z-index: 10000;
	}

	.tb-topbar header.header {
		position: static; // sticky unit handles positioning
	}

	// Open mobile menu breaks out of the sticky unit to a full-viewport overlay,
	// instantly (no transition/slide from its in-flow spot).
	.tb-topbar header.header.opened-burger {
		position: fixed !important;
		inset: 0 !important;
		z-index: 10000;
		transition: none !important;
		animation: none !important;
	}

	// Responsive styles
	@media screen and (max-width: 1280px) {
		header.header {
			display: block; // explicit (was `unset`): the header is no longer fixed here, so `unset` → inline would break it
			height: unset !important;
			transition-property: height; // `top` follows --promo-cur; don't transition it here

			.logo-burger {
				height: $header-height;
			}

			&.opened-burger {
				top: 0; // full-screen mobile menu covers the promo banner too
				height: 100% !important;
				z-index: 10000;
				display: flex !important;
				flex-direction: column;
				align-items: stretch;

				.logo-burger {
					box-shadow: 0 1px 0 rgba(48, 86, 128, 0.07);
					flex-shrink: 0;
				}

				.head-buttons {
					display: flex;
					flex-shrink: 0;
					gap: 0.875rem;
					padding: 20px 0;

					.icon-buttons {
						display: none;
					}

					.divider {
						display: none;
					}

					.n-button {
						display: flex;
						margin: 0;
						width: 110px;
					}
				}
			}

			.burger-group {
				display: flex;
			}

			.burger {
				display: flex;
			}

			.head-buttons {
				display: none;
			}

			.n-button {
				display: none;
			}
		}
	}

	// ============================================
	// PAGE-SPECIFIC HEADER STYLES
	// ============================================

	// Marketing pages with an always-solid header — persistent box-shadow.
	#contact-us,
	#installations,
	#performance,
	#live-demo,
	#product,
	#mqtt-learn {
		header.header {
			box-shadow: 0 0 20px rgba(0, 0, 0, 0.1), 0 0 40px rgba(0, 0, 0, 0.1);
		}
	}

	// Landing pages with transparent header
	#mqtt-broker {
		header.header {
			background-color: transparent;
			box-shadow: none;

			.support-ukraine p {
				color: $color-white;
			}

			.logo,
			.burger {
				filter: invert(100%) sepia(68%) saturate(0%) hue-rotate(350deg) brightness(113%)
					contrast(101%);
			}

			.burger {
				color: $color-black;
			}

			.divider {
				display: none;
			}

			.n-button {
				width: 110px;

				&.price {
					color: $color-white;
					transition-duration: 0s;
					border: none;
					background-color: rgba(255, 255, 255, 0.05);

					&:hover {
						text-decoration: none;
						color: var(--color-text);
						background-color: var(--color-bg-surface);
					}
				}

				&.try {
					background-color: var(--color-brand);
					color: var(--color-brand-contrast);

					&:hover {
						color: var(--color-brand);
						box-shadow: none;
						background-color: var(--color-bg-surface);
					}
				}
			}
		}
	}

	// Non-transparent header — hide the divider and style the buttons.
	#contact-us,
	#installations,
	#performance,
	#live-demo,
	#product,
	#mqtt-learn {
		header.header {
			.divider {
				display: none;
			}

			.n-button {
				&.price {
					border: 1px solid var(--color-border);
					color: var(--color-text);
					background-color: transparent;

					&:hover {
						border: 2px solid var(--color-text);
					}
				}

				&.try {
					background-color: var(--color-brand);
					color: var(--color-brand-contrast);

					&:hover {
						color: var(--color-brand);
						box-shadow: none;
						// Theme-aware: in light mode this resolves to white, in
						// dark mode to the dark surface — avoids a glaring
						// white pill on a dark header bg. On no-dark pages the
						// `:where(...)` re-emit forces the light value, so the
						// hover keeps its original look.
						background-color: var(--color-bg-surface);
					}
				}
			}
		}
	}

	// Pricing page: transparent header by default, opaque on hover and scroll
	#pricing header.header {
		background-color: transparent;
		// Snappier opaque flip — the slow 0.3s fade looked laggy under the banner.
		transition: background-color 0.15s ease, box-shadow 0.15s ease;

		&:hover {
			background-color: var(--color-bg-surface);
		}
	}

	#mqtt-broker {
		&.flip-nav header.header {
			.logo,
			.burger {
				filter: none;
			}
		}
	}

	// Scrolled header state (flip-nav)
	#mqtt-broker,
	#pricing {
		&.flip-nav header.header {
			transition: all 0.12s ease; // snappier transparent → opaque flip, synced with banner
			background-color: var(--color-bg-surface);
			box-shadow: var(--shadow-header);

			.support-ukraine p {
				color: $color-black;
			}

			.n-button {
				&.price {
					border: 1px solid var(--color-border);
					color: var(--color-text);
					background-color: transparent;

					&:hover {
						border: 2px solid var(--color-text);
					}
				}

				&.try {
					background-color: var(--color-brand);
					color: var(--color-brand-contrast);

					&:hover {
						background-color: var(--color-brand);
						color: var(--color-brand-contrast);
						box-shadow: var(--shadow-primary);
					}
				}
			}
		}
	}

	// Dark-mode opened burger background — covers pages whose <html> id isn't
	// enumerated in the landing-page list below (the docs tree renders with no
	// id at all). Without this they fall back to Starlight's
	// `--sl-color-bg-sidebar` (`hsl(224 14% 16%)` ≈ `#23262f`) and the drawer
	// reads as the same dark shade as page-level cards. Use the brightest
	// project surface token so the drawer is visibly elevated above both the
	// page bg (`#141517`) and card surfaces (`--color-bg-surface` `#1e1f23`).
	html[data-theme='dark'] header.header.opened-burger {
		background-color: var(--color-bg-light);
	}

	// Mobile burger opened state for landing pages
	#common,
	#mqtt-broker,
	#contact-us,
	#installations,
	#performance,
	#live-demo,
	#product,
	#mqtt-learn {
		header.header.opened-burger {
			transition: all $transition-base;
			background-color: var(--color-bg-light);
			box-shadow: var(--shadow-header);

			.support-ukraine p {
				color: $color-black;
			}

			.logo,
			.burger {
				filter: none;
			}

			.head-menu ul {
				a,
				a:not([href]),
				span.main-menu-link {
					color: var(--color-text);
				}

				li:hover a,
				li:hover span.main-menu-link {
					color: var(--color-brand);
				}
			}

			.n-button {
				&.price {
					border: 1px solid var(--color-border);
					color: var(--color-text);
					background-color: transparent;

					&:hover {
						border: 2px solid var(--color-text);
					}
				}

				&.try {
					background-color: var(--color-brand);
					color: var(--color-brand-contrast);

					&:hover {
						background-color: var(--color-brand);
						color: var(--color-brand-contrast);
						box-shadow: var(--shadow-primary);
					}
				}
			}
		}
	}

	// Hide search and theme toggle on landing pages
	#mqtt-broker,
	#pricing,
	#common,
	#installations,
	#performance,
	#live-demo,
	#product,
	#mqtt-learn {
		search-button,
		theme-toggle {
			display: none;
		}
	}

	// Hide divider on pages where theme toggle is hidden but not already handled above
	#pricing {
		header.header {
			.divider {
				display: none;
			}
		}
	}

	// Show theme toggle on 404 and pricing pages
	#common,
	#pricing {
		theme-toggle {
			display: flex;
		}
	}

	// Show header border only on docs and 404 pages
	html:not([id]),
	#common {
		header.header {
			border-bottom: 1px solid var(--sl-color-hairline-shade);
		}
	}

	// Starlight mobile sidebar: 90% width, toggle button left when closed / right edge when open
	@media (max-width: 50rem) {
		#starlight__sidebar {
			width: 90%;
		}

		starlight-menu-button button {
			inset-inline-end: auto;
			inset-inline-start: var(--sl-nav-pad-x);
			// Just below the header bottom (= --promo-cur + header height); tracks the banner up as it hides.
			top: calc(var(--promo-cur, var(--promo-h, 0px)) + var(--header-height) + 0.75rem);
		}

		starlight-menu-button[aria-expanded='true'] button {
			inset-inline-start: 90%;
		}

		// On pages with a TOC, the sidebar toggle is embedded inside the TOC bar
		html[data-has-toc] starlight-menu-button button {
			display: none;
		}
		// But when the sidebar is open it covers the TOC bar, so restore the close button
		html[data-has-toc] starlight-menu-button[aria-expanded='true'] button {
			display: flex;
		}
	}

	// Pages that don't support dark theme, excluded from the dark-tinting scope
	// below via :not(:where(...)). No force-light token override exists for them
	// — none is reachable: every page with one of these ids is rendered with
	// BaseLayout's `forceLightTheme` (SSR `data-theme="light"`, re-pinned before
	// paint by ThemeProvider's force-light branch, theme toggle not rendered),
	// so `html[data-theme='dark']` can never co-occur with these ids.
	$no-dark-pages: '#mqtt-broker, #installations, #performance, #live-demo, #product, #mqtt-learn';

	// Dark-theme tinting for the menu's dropdown content. Only applies on
	// pages that support dark theme — pages in $no-dark-pages above are
	// excluded via :not(:where(...)) so they keep their light-mode menu look.
	// `!important` is used on the .group-name / hover / indicator rules below
	// to defeat the higher-specificity brand-colour rules in Navigation.astro
	// (`a.com-lnk:hover .item-heading`, `.group-name`, etc.) without rewriting
	// them — light theme keeps its brand colours, only dark theme is
	// overridden. The icon sub-block at the end of this rule is the exception:
	// it scopes under `header.header` to win specificity naturally, so it
	// does NOT use `!important`.
	html[data-theme='dark']:not(:where(#{$no-dark-pages})) {
		// Group label inside dropdowns (e.g. "SCADA", "IoT platforms")
		.head-menu .sub-menu .group-name {
			color: var(--color-brand) !important;
		}

		// Item heading at rest — keep the regular text colour so the hover
		// state stays visible. Only the hover transitions to primary.

		// Item heading on hover — overrides every product/use-case brand colour
		// set by Navigation.astro's per-link rules, so the hover state keeps
		// using the dark-mode primary.
		.head-menu .sub-menu a:hover .sub-text h1,
		.head-menu .sub-menu a:hover .sub-text span.item-heading {
			color: var(--color-brand) !important;
		}

		// Top-level main menu link hover (Products / Services / Use Cases / …)
		.head-menu ul li:hover a,
		.head-menu ul li:hover span.main-menu-link,
		.head-menu ul li a:not([href]):hover,
		.head-menu ul li span.main-menu-link:hover {
			color: var(--color-brand) !important;
		}

		// Active-tab indicator (the underline + arrow under the hovered top item)
		.head-menu .indicator .head-arrow {
			border-bottom-color: var(--color-brand) !important;
		}
		.head-menu .indicator .line {
			background-color: var(--color-brand) !important;
		}

		// Recolour the dropdown product/use-case icons for dark theme.
		// The icon SVGs are inlined and use `currentColor` for their fills,
		// so we retint via CSS `color`. Each brand class gets a lighter
		// variant of its light-mode hue so the per-product identity is
		// preserved while remaining readable on the dark dropdown bg.
		// Scoped under `header.header` so specificity beats Navigation.astro's
		// per-brand rules (`a.com-lnk svg.nav-icon` …) without `!important`.
		header.header .head-menu .sub-menu a {
			// Default fallback (links without a brand class)
			svg.nav-icon {
				color: var(--menu-icon-color);
			}
			&.com-lnk svg.nav-icon,
			&.mobile-lnk svg.nav-icon {
				color: #7da9d8;
			}
			&.cloud-lnk svg.nav-icon {
				color: #7dd3fc;
