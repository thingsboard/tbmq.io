---
import SiteMenu from '@components/SiteMenu/SiteMenu.astro';
import GitHubButton from './GitHubButton.astro';
import NButton from './NButton.astro';
import SearchButton from '../SearchButton.astro';
import ThemeToggle from '../ThemeToggle.astro';
import { Icon } from 'astro-icon/components';
import { Products } from '@models/site.models';
import { DEMO_SIGNIN, DEMO_SIGNUP } from '@data/cta-destinations';

interface Props {
	platformQuery?: string;
	gitHubPlatform?: Products;
}

const { gitHubPlatform } = Astro.props;
---

<div class="logo-burger">
	<a href="/" class="logo" aria-label="Link to homepage"></a>
	<div class="burger-group">
		<div class="icon-buttons">
			<ThemeToggle />
			<SearchButton />
		</div>
		<div class="divider"></div>
		<button onclick="Burger()" class="burger" aria-label="Burger menu">
			<Icon name="tabler:menu-2" class="icon-open" />
			<Icon name="tabler:x" class="icon-close" />
		</button>
	</div>
	<!-- Burger mode (up to 1280px): the star button sits beside the logo. On the
	     desktop bar the copy in .head-buttons shows instead. -->
	<GitHubButton platform={gitHubPlatform} />
</div>

<!-- head-buttons is rendered BEFORE the menu in the source so it parses and
     paints first: with the menu's panel markup between the logo and the
     right-side buttons, slow CPUs paint the row before head-buttons exists
     and it shifts once they arrive. Visual order is restored with `order`
     in the header layout below. -->
<div class="head-buttons">
	<div class="icon-buttons">
		<ThemeToggle />
		<SearchButton />
	</div>
	<GitHubButton platform={gitHubPlatform} />
	<NButton id="Menu_SignIn" href={DEMO_SIGNIN} target="_blank" variant="outlined" class="signin">Sign in</NButton>
	<NButton id="Menu_TryItNow" href={DEMO_SIGNUP} target="_blank" variant="filled" class="try gtm_button"
		>Try for free</NButton
	>
</div>

<SiteMenu />

<script>
	// Burger menu toggle. While the phone menu is open, <html> carries
	// `data-sm-sheet-open`: other fixed UI (the cookie banner) reads it to get out
	// of the way. The menu collapses its own sections when the drawer closes
	// (SiteMenu watches the `opened-burger` class).
	function Burger() {
		const header = document.querySelector('header.header');
		const body = document.body;

		if (header?.classList.contains('opened-burger')) {
			header.classList.remove('opened-burger');
			document.documentElement.removeAttribute('data-sm-sheet-open');
			body.style.overflow = '';
		} else {
			header?.classList.add('opened-burger');
			document.documentElement.setAttribute('data-sm-sheet-open', '');
			body.style.overflow = 'hidden';
		}
	}

	// Make function available globally
	(window as any).Burger = Burger;

	// Swipe to open/close mobile menus:
	//   Starlight sidebar — swipe RIGHT from left edge to open, swipe LEFT to close
	//   Burger menu      — swipe LEFT from right edge to open, swipe RIGHT to close
	(function () {
		const OPEN_EDGE = 30; // px from screen edge that starts an open gesture
		const MIN_DIST = 60; // minimum horizontal travel to trigger
		const MAX_ANGLE = 35; // max degrees from horizontal (avoids triggering on scrolls)

		let startX = 0;
		let startY = 0;
		let tracking: 'sidebar' | 'burger' | null = null;

		// Starlight drops the sidebar's `popover` attribute on desktop viewports, where the sidebar
		// is always shown; `togglePopover()` throws on an element without it.
		function isSidebarDrawer() {
			return !!document.getElementById('starlight__sidebar')?.popover;
		}

		function isSidebarOpen() {
			return !!document.getElementById('starlight__sidebar')?.matches(':popover-open');
		}

		function isBurgerOpen() {
			return document.querySelector('header.header')?.classList.contains('opened-burger') ?? false;
		}

		function triggerSidebar() {
			document.getElementById('starlight__sidebar')?.togglePopover();
		}

		function triggerBurger() {
			(window as any).Burger?.();
		}

		document.addEventListener(
			'touchstart',
			(e) => {
				const t = e.touches[0];
				startX = t.clientX;
				startY = t.clientY;

				if (isSidebarOpen()) tracking = 'sidebar';
				else if (isBurgerOpen()) tracking = 'burger';
				else if (startX <= OPEN_EDGE && isSidebarDrawer()) tracking = 'sidebar';
				else if (startX >= window.innerWidth - OPEN_EDGE) tracking = 'burger';
				else tracking = null;
			},
			{ passive: true }
		);

		document.addEventListener(
			'touchend',
			(e) => {
				const which = tracking;
				tracking = null;
				if (!which) return;

				const t = e.changedTouches[0];
				const dx = t.clientX - startX;
				const dy = t.clientY - startY;

				if (Math.abs(dx) < MIN_DIST) return;

				const angle = Math.abs(Math.atan2(Math.abs(dy), Math.abs(dx)) * (180 / Math.PI));
				if (angle > MAX_ANGLE) return;

				if (which === 'sidebar') {
					if (!isSidebarOpen() && dx > 0) triggerSidebar(); // swipe right → open
					else if (isSidebarOpen() && dx < 0) triggerSidebar(); // swipe left → close
				} else {
					if (!isBurgerOpen() && dx < 0) triggerBurger(); // swipe left from right edge → open
					else if (isBurgerOpen() && dx > 0) triggerBurger(); // swipe right → close
				}
			},
			{ passive: true }
		);
	})();
</script>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	header.header {
		position: fixed;
		top: var(--promo-cur, var(--promo-h, 0px)); // tracks the banner via the var; don't transition `top` (would desync)
		left: 0;
		// No `filter` here: the header itself never gets one (only .logo/.burger do),
		// and a filter on the header would make it the containing block for the fixed
		// promo banner inside it, breaking the banner's viewport anchoring on docs.
		transition: background-color 0.12s ease, box-shadow 0.12s ease, color 0.12s ease,
			border-color 0.12s ease;
		width: 100%;
		height: $header-height;
		z-index: 8888;
		border-bottom: none;
		background-color: var(--sl-color-bg-sidebar);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 20px;

		// Colour contract, read by the menu (SiteMenu) and the bar's buttons. The page
		// states further down re-set these; nothing else decides the bar's text colour.
		--hd-ink: var(--color-text); // bar text and icons
		--hd-ink-hover: var(--color-brand); // hover, current page or section
		--hd-surface: var(--sl-color-bg-sidebar); // the solid bar, and an open menu panel
		--hd-rule: var(--color-border); // hairlines, outlined buttons

		.logo-burger {
			position: relative;
			display: flex;
			height: 100%;
			align-items: center;
			gap: 0.875rem;
		}

		.head-buttons {
			// head-buttons is placed before the menu in DOM order to avoid a layout
			// shift on slow CPUs. `order: 1` keeps it visually after the menu (which
			// keeps the default order: 0).
			order: 1;
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: 0.875rem;

			// Laptop widths — the bar is at its fullest here (eight menu items, the
			// docs icons, three buttons): tighter gaps before anything gets dropped.
			@media screen and (min-width: 1281px) and (max-width: 1439px) {
				gap: 0.5rem;
			}

			.icon-buttons {
				display: flex;
				align-items: center;
				gap: 0;
			}

			// The star button is rendered twice (see the markup): this copy is the
			// desktop bar's, the one beside the logo is burger mode's.
			.gh-wrap {
				display: none;

				@media screen and (min-width: 1281px) {
					display: block;
				}

				// Laptop widths — after the tighter gaps, the star count is the first
				// thing to go: the blog's bar (marketing type plus the search and theme
				// icons) does not fit beside it at 1281px with a scrollbar.
				@media screen and (min-width: 1281px) and (max-width: 1399px) {
					width: auto;

					.gh-sep,
					.gh-count {
						display: none;
					}
				}
			}

			.n-button {
				width: auto;
				min-width: 90px;
				padding-block: 0;
				padding-inline: 16px;
				display: flex;
				align-items: center;
				justify-content: center;
				white-space: nowrap;

				// Outlined in the bar's own ink, so one rule serves every page state:
				// the states only re-set `--hd-ink` and `--hd-rule`.
				&.signin {
					color: var(--hd-ink);
					border: 1px solid var(--hd-rule);
					background-color: transparent;

					&:hover {
						border-color: var(--hd-ink);
						text-decoration: none;
					}
				}
			}
		}

		.logo-burger .gh-wrap {
			@media screen and (min-width: 1281px) {
				display: none;
			}
		}

		.logo {
			position: relative;
			display: block;
			width: 140px;
			height: 60px;
			background-image: url(../../assets/images/landings/tbmq-logo.svg);
			background-size: contain;
			background-position: center center;
			background-repeat: no-repeat;

			[data-theme='dark'] & {
				filter: invert(100%) sepia(68%) saturate(0%) hue-rotate(350deg) brightness(113%)
					contrast(101%);
			}

			@media screen and (min-width: 1025px) {
				width: 180px;
			}

			// Laptop widths — smaller logo to keep the nav row from wrapping.
			@media screen and (min-width: 1281px) and (max-width: 1599px) {
				width: 120px;
			}

			// Small phones — shrink so the wordmark doesn't collide with the icons.
			@media screen and (max-width: 480px) {
				width: 110px;
			}
		}
	}

	.burger-group {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		right: 0;
		display: none;
		align-items: center;
		gap: 0.875rem;

		.icon-buttons {
			display: flex;
			align-items: center;
			gap: 0;
		}

		.divider {
			width: 1px;
			height: 32px;
			background-color: var(--sl-color-hairline-light);
			flex-shrink: 0;
		}
	}

	.burger {
		display: none;
		border: none;
		background: none;
		padding: 0;
		cursor: pointer;
		color: inherit;
		width: 32px;
		height: 32px;
		align-items: center;
		justify-content: center;

		svg {
			width: 28px;
			height: 28px;
		}

		.icon-close {
			display: none;
		}

		&:focus {
			outline: none;
		}
	}

	.opened-burger .burger {
		.icon-open {
			display: none;
		}

		.icon-close {
			display: block;
		}
	}

	// Marketing: banner + header are one sticky unit (wrapper in BaseLayout). It
	// scrolls until the banner is off-screen, then the header pins; the negative
	// margin-bottom keeps existing per-page $header-height offsets valid.
	// (Docs has no .tb-topbar — there the banner hides via scroll-driven --promo-cur.)
	.tb-topbar {
		position: sticky;
		top: calc(-1 * var(--promo-h, 0px));
		z-index: 8889;
		margin-bottom: calc(-1 * #{$header-height});
	}

	// Open mobile menu: lift the sticky unit above the cookie banner (9999).
	.tb-topbar:has(header.header.opened-burger) {
		z-index: 10000;
	}

	.tb-topbar header.header {
		position: static; // sticky unit handles positioning
	}

	// Open mobile menu breaks out of the sticky unit to a full-viewport overlay,
	// instantly (no transition/slide from its in-flow spot).
	.tb-topbar header.header.opened-burger {
		position: fixed !important;
		inset: 0 !important;
		z-index: 10000;
		transition: none !important;
		animation: none !important;
	}

	// Responsive styles
	@media screen and (max-width: 1280px) {
		header.header {
			display: block; // explicit (was `unset`): the header is no longer fixed here, so `unset` → inline would break it
			height: unset !important;
			transition-property: height; // `top` follows --promo-cur; don't transition it here

			.logo-burger {
				height: $header-height;
			}

			&.opened-burger {
				top: 0; // full-screen mobile menu covers the promo banner too
				height: 100% !important;
				z-index: 10000;
				display: flex !important;
				flex-direction: column;
				align-items: stretch;

				.logo-burger {
					box-shadow: 0 1px 0 rgba(48, 86, 128, 0.07);
					flex-shrink: 0;
				}

				.head-buttons {
					display: flex;
					flex-shrink: 0;
					gap: 0.875rem;
					padding: 20px 0;

					.icon-buttons {
						display: none;
					}

					.n-button {
						display: flex;
						margin: 0;
						min-width: 110px;
					}
				}
			}

			.burger-group {
				display: flex;
			}

			.burger {
				display: flex;
			}

			.head-buttons {
				display: none;
			}

			.n-button {
				display: none;
			}
		}
	}

	// ============================================
	// PAGE-SPECIFIC HEADER STYLES
	// ============================================

	// Marketing pages with an always-solid header — persistent box-shadow.
	#blog,
	#contact-us,
	#installations,
	#performance,
	#live-demo,
	#product,
	#mqtt-learn {
		header.header {
			box-shadow: 0 0 20px rgba(0, 0, 0, 0.1), 0 0 40px rgba(0, 0, 0, 0.1);
		}
	}

	// Landing pages with transparent header
	#mqtt-broker {
		header.header {
			background-color: transparent;
			box-shadow: none;

			.logo,
			.burger {
				filter: invert(100%) sepia(68%) saturate(0%) hue-rotate(350deg) brightness(113%)
					contrast(101%);
			}

			.burger {
				color: $color-black;
			}

			.n-button {
				&.try {
					background-color: var(--color-brand);
					color: var(--color-brand-contrast);

					&:hover {
						color: var(--color-brand);
						box-shadow: none;
						background-color: var(--color-bg-surface);
					}
				}
			}
		}
	}

	// Non-transparent header — style the filled button.
	#contact-us,
	#installations,
	#performance,
	#live-demo,
	#product,
	#mqtt-learn {
		header.header {
			.n-button {
				&.try {
					background-color: var(--color-brand);
					color: var(--color-brand-contrast);

					&:hover {
						color: var(--color-brand);
						box-shadow: none;
						// Theme-aware: in light mode this resolves to white, in
						// dark mode to the dark surface — avoids a glaring
						// white pill on a dark header bg. On no-dark pages the
						// `:where(...)` re-emit forces the light value, so the
						// hover keeps its original look.
						background-color: var(--color-bg-surface);
					}
				}
			}
		}
	}

	// Pricing page: transparent header by default, opaque on hover and scroll
	#pricing header.header {
		background-color: transparent;
		// Snappier opaque flip — the slow 0.3s fade looked laggy under the banner.
		transition: background-color 0.15s ease, box-shadow 0.15s ease;

		&:hover {
			background-color: var(--color-bg-surface);
		}
	}

	// Over the landing hero the bar's ink is white, until the page scrolls (flip-nav),
	// the drawer opens, or a menu panel opens. The pricing page's transparent bar sits
	// on the page background, so it keeps the default ink.
	#mqtt-broker:not(.flip-nav) header.header:not(.opened-burger):not([data-sm-open]) {
		--hd-ink: #{$color-white};
		--hd-ink-hover: #{$color-white};
		--hd-rule: rgb(255 255 255 / 0.3);
	}

	// Both transparent bars turn solid while a menu panel is open: the panel hangs
	// from the bar and shares its surface.
	#mqtt-broker,
	#pricing {
		header.header {
			--hd-surface: var(--color-bg-surface);

			&[data-sm-open] {
				background-color: var(--hd-surface);
			}
		}
	}

	#mqtt-broker header.header[data-sm-open] {
		.logo,
		.burger {
			filter: none;
		}
	}

	#mqtt-broker {
		&.flip-nav header.header {
			.logo,
			.burger {
				filter: none;
			}
		}
	}

	// Scrolled header state (flip-nav)
	#mqtt-broker,
	#pricing {
		&.flip-nav header.header {
			transition: all 0.12s ease; // snappier transparent → opaque flip, synced with banner
			background-color: var(--color-bg-surface);
			box-shadow: var(--shadow-header);

			.n-button {
				&.try {
					background-color: var(--color-brand);
					color: var(--color-brand-contrast);

					&:hover {
						background-color: var(--color-brand);
						color: var(--color-brand-contrast);
						box-shadow: var(--shadow-primary);
					}
				}
			}
		}
	}

	// Dark-mode opened burger background — covers pages whose <html> id isn't
	// enumerated in the landing-page list below (the docs tree renders with no
	// id at all). Without this they fall back to Starlight's
	// `--sl-color-bg-sidebar` (`hsl(224 14% 16%)` ≈ `#23262f`) and the drawer
	// reads as the same dark shade as page-level cards. Use the brightest
	// project surface token so the drawer is visibly elevated above both the
	// page bg (`#141517`) and card surfaces (`--color-bg-surface` `#1e1f23`).
	html[data-theme='dark'] header.header.opened-burger {
		background-color: var(--color-bg-light);
	}

	// Mobile burger opened state for landing pages
	#common,
	#mqtt-broker,
	#contact-us,
	#installations,
	#performance,
	#live-demo,
	#product,
	#mqtt-learn {
		header.header.opened-burger {
			transition: all $transition-base;
			background-color: var(--color-bg-light);
			box-shadow: var(--shadow-header);

			.logo,
			.burger {
				filter: none;
			}

			.n-button {
				&.try {
					background-color: var(--color-brand);
					color: var(--color-brand-contrast);

					&:hover {
						background-color: var(--color-brand);
						color: var(--color-brand-contrast);
						box-shadow: var(--shadow-primary);
					}
				}
			}
		}
	}

	// Hide search and theme toggle on landing pages
	#mqtt-broker,
	#pricing,
	#common,
	#installations,
	#performance,
	#live-demo,
	#product,
	#mqtt-learn {
		search-button,
		theme-toggle {
			display: none;
		}
	}

	// Show theme toggle on 404 and pricing pages
	#common,
	#pricing {
		theme-toggle {
			display: flex;
		}
	}

	// Show header border only on docs and 404 pages
	html:not([id]),
	#common {
		header.header {
			border-bottom: 1px solid var(--sl-color-hairline-shade);
		}
	}

	// Starlight mobile sidebar: 90% width, toggle button left when closed / right edge when open
	@media (max-width: 50rem) {
		#starlight__sidebar {
			width: 90%;
		}

		.sl-menu-button {
			inset-inline-end: auto;
			inset-inline-start: var(--sl-nav-pad-x);
			// Just below the header bottom (= --promo-cur + header height); tracks the banner up as it hides.
			top: calc(var(--promo-cur, var(--promo-h, 0px)) + var(--header-height) + 0.75rem);
		}

		.sl-menu-button:has(~ :popover-open) {
			inset-inline-start: 90%;
		}

		// On pages with a TOC, the sidebar toggle is embedded inside the TOC bar
		html[data-has-toc] .sl-menu-button {
			display: none;
		}
		// But when the sidebar is open it covers the TOC bar, so restore the close button
		html[data-has-toc] .sl-menu-button:has(~ :popover-open) {
			display: flex;
		}
	}
</style>
