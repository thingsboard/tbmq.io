---
import CtaButton from '@components/Landing/CtaButton.astro';
import type { Cta } from '@models/cta';

// Ported from upstream's `Landing/Hero.astro` (thingsboard.io). The video panel is a `visual`
// slot here; keep the rest close to upstream so its hero fixes cherry-pick cleanly.
interface Props {
	/** Every line but the last is a kicker sitting above the headline. */
	title: string[];
	subtitle: string;
	buttons?: Cta[];
}

const { title, subtitle, buttons = [] } = Astro.props;
---

<section id="hero" class="hero">
	<div class="hero__content">
		<h1>
			{title.map((line) => <span class="hero__line">{line}</span>)}
		</h1>
		<p class="hero__subtitle">{subtitle}</p>

		{
			buttons.length > 0 && (
				<div class="hero__buttons">
					{buttons.map(({ text, ...button }) => (
						<CtaButton {...button}>{text}</CtaButton>
					))}
				</div>
			)
		}
	</div>

	<div class="hero__panel">
		<slot name="visual" />
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	// Source order is the layout — auto-placement gives both arrangements.
	.hero {
		display: grid;
		grid-template-columns: 1fr;
		// Dark on every theme, so fixed values: a 32px dot grid over near-black.
		background:
			radial-gradient(rgba(#fff, 0.06) 1px, transparent 1.5px) 0 0 / 32px 32px,
			#060d09;
		color: #fff;
	}

	.hero__content {
		// The same room above the headline and under the buttons, so the copy stays centred.
		--hero-gap: 56px;

		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: calc(#{$header-height} + var(--hero-gap)) clamp(20px, calc(0.5rem + 2vw), 56px) var(--hero-gap);

		@media (max-height: 620px) {
			--hero-gap: 42px;
		}

		// Phones (after the short rule, so it wins): the panel sits right under the copy, centred on its axis.
		@media (max-width: 599px) {
			--hero-gap: 48px;

			align-items: center;
			text-align: center;
		}
	}

	h1 {
		@include hero-title;
		line-height: 1.2;
		margin: 0 0 20px;
		// Not in upstream: tbmq.io's base styles colour every heading for a light surface.
		color: inherit;

		@media (max-width: 599px) {
			max-width: 7em;
			text-wrap: balance;
		}

		@media (max-height: 620px), (max-width: $breakpoint-sm) {
			margin-bottom: 12px;
		}
	}

	.hero__line {
		display: block;

		// One title line is a headline, not a kicker to nothing. The fade matches the logo strip's marks.
		&:not(:last-child) {
			background-image: linear-gradient(to bottom, rgb(255 255 255 / 62%), rgb(255 255 255 / 38%));
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
		}
	}

	.hero__subtitle {
		@include text-m;
		font-size: $font-size-lg;
		// The mixin colours for a light surface; this one is always black.
		color: #fff;
		max-width: 52ch;
		margin: 0 0 32px;
		text-wrap: pretty;

		@media (max-width: 599px) {
			margin-inline: auto;
		}

		@media (max-height: 620px), (max-width: $breakpoint-sm) {
			margin-bottom: 20px;
		}
	}

	.hero__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;

		// From CtaButton, hence `:global`.
		:global(.cta-button > svg) {
			width: 20px;
			height: 20px;
		}

		:global(.cta-button--brand) {
			position: relative;
			overflow: hidden;
			isolation: isolate;
		}

		:global(.cta-button--brand::after) {
			content: '';
			position: absolute;
			inset-block: 0;
			left: 0;
			width: 45%;
			z-index: -1;
			pointer-events: none;
			background: linear-gradient(100deg, transparent, rgb(255 255 255 / 38%), transparent);
			transform: translateX(-160%) skewX(-18deg);
		}

		@media (prefers-reduced-motion: no-preference) {
			:global(.cta-button--brand:hover::after),
			:global(.cta-button--brand:focus-visible::after) {
				animation: hero-shimmer 0.75s cubic-bezier(0.4, 0, 0.2, 1);
			}
		}

		@media (max-width: 599px) {
			justify-content: center;
		}
	}

	// Holds the `visual` slot, centred and fitted inside it. `--hero-fit-h` is the height the
	// visual may use in each layout; side by side the panel is also the `hero-panel` size container.
	.hero__panel {
		--hero-fit-h: 520px;

		position: relative;
		display: grid;
		place-items: center;
		padding: 0 clamp(20px, calc(0.5rem + 2vw), 56px) 48px;
		// The glow sits behind the visual, so it follows the panel.
		background: radial-gradient(ellipse 55% 60% at 50% 50%, rgba($color-pe, 0.16), transparent 72%);
	}

	h1,
	.hero__subtitle,
	.hero__buttons {
		// `backwards` holds the from-state through the delay, so nothing is parked at 0.
		animation: hero-rise 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) backwards;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	.hero__subtitle {
		animation-delay: 300ms;
	}

	.hero__buttons {
		animation-delay: 600ms;
	}

	@keyframes hero-shimmer {
		from {
			transform: translateX(-160%) skewX(-18deg);
		}

		to {
			transform: translateX(320%) skewX(-18deg);
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translate3d(0, 45px, 0);
		}
	}

	// Tablets, and any portrait screen from `md`: the panel under the copy, the copy in two
	// columns — the headline in one, the lede and the actions in the other.
	@media (min-width: 600px) and (max-width: #{$breakpoint-md - 1px}),
		(min-width: $breakpoint-md) and (orientation: portrait) {
		.hero__content {
			--hero-copy-gap: clamp(#{$spacing-6}, 4vw, #{$spacing-8});

			container-type: inline-size;
			display: grid;
			grid-template-columns: 1fr 1fr;
			grid-template-rows: auto auto 1fr;
			column-gap: var(--hero-copy-gap);
			align-items: start;
			justify-items: start;
		}

		h1 {
			grid-column: 1;
			grid-row: 1 / -1;
			margin-bottom: 0;
			max-width: 7em;
			// Sized to its column: seven of its own ems fill half the copy.
			font-size: clamp(34px, calc((100cqi - var(--hero-copy-gap)) / 2 / 7), 48px);

			@media (max-height: 620px) {
				font-size: 34px;
			}
		}

		.hero__subtitle,
		.hero__buttons {
			grid-column: 2;
		}

		.hero__subtitle {
			max-width: 34ch;
		}

		.hero__panel {
			// Fills what the copy (~300px) leaves before the fold, the logo strip and 64px of the
			// next section kept in view, but never under 30vw.
			--hero-fit-h: max(30vw, calc(100svh - var(--promo-h, 0px) - 100px - 64px - 300px));
		}
	}

	// Side by side, from `md` in landscape: the copy at its natural width, the panel taking the rest.
	@media (min-width: $breakpoint-md) and (orientation: landscape) {
		.hero {
			// The widest the copy and the panel get together; past it the composition centres.
			--hero-wide-cap: max(1823px, calc(4000px - 100vw), 53vw);
			// The copy's column: its natural width, widening to 540 on very wide screens.
			--hero-band-min: min(22vw, 540px);
			// The first screen less the promo bar, header, ~100px logo strip and 120px of the next section,
			// capped at 960px: past it the visual gains nothing.
			--hero-fold-h: min(960px, calc(100svh - var(--promo-h, 0px) - #{$header-height} - 100px - 120px));
			// At most 2.6 of the panel's height wide, so the visual is not stranded in a wide empty band. The
			// height is floored at 320, the copy's shortest side by side, so a phone on its side gets no portrait box.
			--hero-panel-col: calc(max(var(--hero-fold-h), 320px) * 2.6);

			// The copy takes its own width, the panel the rest up to its cap; past the wide cap it centres.
			grid-template-columns: minmax(var(--hero-band-min), auto) minmax(0, var(--hero-panel-col));
			justify-content: center;
			padding-inline: max(0px, calc((100% - var(--hero-wide-cap)) / 2));
		}

		.hero__content {
			align-self: center;
			padding-inline: $bar-inset;
		}

		h1 {
			max-width: 7em;
			text-wrap: balance;

			@include media-up(lg) {
				font-size: clamp(48px, 1.85vw, 64px);
			}
		}

		.hero__subtitle {
			max-width: clamp(34ch, calc(34ch + (100vw - 2000px) / 10), 44ch);
		}

		.hero__panel {
			// Grows with a taller text column; the visual stays centred in it.
			align-self: stretch;
			// Clears the bar so nothing draws behind it.
			margin-top: $header-height;
			// The panel's size comes from the grid row and the fold, never from the visual, so the
			// visual can fit itself to the panel's height (`100cqh`).
			container: hero-panel / size;
			--hero-fit-h: 100cqh;
			min-height: var(--hero-fold-h);
			padding: 24px $bar-inset 24px 0;
		}
	}
</style>
