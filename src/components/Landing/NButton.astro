---
interface Props {
	variant?: 'filled' | 'outlined' | 'text';
	size?: 'sm' | 'md' | 'lg';
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	disabled?: boolean;
	id?: string;
	class?: string;
	pill?: boolean;
	fullWidth?: boolean;
	target?: string;
	ariaLabel?: string;
	[key: string]: any;
}

const {
	variant = 'filled',
	size = 'md',
	href,
	type = 'button',
	disabled = false,
	id,
	class: className,
	pill = false,
	fullWidth = false,
	target,
	ariaLabel,
	...attrs
} = Astro.props;

const classes = [
	'n-button',
	`n-button--${variant}`,
	`n-button--${size}`,
	pill && 'n-button--pill',
	fullWidth && 'n-button--full-width',
	disabled && 'n-button--disabled',
	className,
]
	.filter(Boolean)
	.join(' ');
---

{
	href ? (
		<a
			href={href}
			id={id}
			class={classes}
			target={target}
			rel={target === '_blank' ? 'noopener noreferrer' : undefined}
			aria-label={ariaLabel}
			{...attrs}
		>
			<slot />
		</a>
	) : (
		<button
			type={type}
			id={id}
			class={classes}
			disabled={disabled}
			aria-label={ariaLabel}
			{...attrs}
		>
			<slot />
		</button>
	)
}

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	.n-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-weight: $font-weight-normal;
		text-align: center;
		text-decoration: none;
		border-radius: $radius-sm;
		border: none;
		transition: all $transition-base;
		cursor: pointer;
		box-sizing: border-box;

		// ---- Color tokens (brand green — the CTA colour) ----
		// Decoupled from --sl-color-*accent* (the blue link accent) so buttons stay
		// green while links stay blue. --color-brand-contrast pairs with the green
		// fill in both themes (white on green in light, navy on mint in dark).
		// The variants below read only these tokens, so a future second colour is
		// one token block, not new rules. One consistent rule for the surface: no
		// call sites, no code — the warning/danger/success/white colour blocks and
		// the elevated/tonal variants were all removed on those grounds.
		--_btn-color: var(--color-brand);
		--_btn-color-contrast: var(--color-brand-contrast);
		--_btn-subtle-bg: var(--sl-color-green-low);

		// ---- Sizes ----
		&--sm {
			font-size: $font-size-sm;
			padding: 8px 16px;
			height: 36px;
		}

		&--md {
			font-size: $font-size-base;
			padding: 11px 20px;
			height: 47px;
		}

		&--lg {
			font-size: $font-size-lg;
			padding: 14px 28px;
			height: 54px;
		}

		// ---- Variants ----
		&--filled {
			background-color: var(--_btn-color);
			color: var(--_btn-color-contrast);

			// Darken with color-mix so background-color (animatable) carries the
			// hover easing — the old gradient overlay couldn't ease despite
			// `transition: all`, because background-image is a discrete property.
			&:hover {
				background-color: color-mix(in srgb, var(--_btn-color) 85%, black);
				text-decoration: none;
				color: var(--_btn-color-contrast);
			}

			&:active {
				background-color: color-mix(in srgb, var(--_btn-color) 75%, black);
				transition-duration: 0s;
			}
		}

		&--outlined {
			background-color: transparent;
			color: var(--_btn-color);
			border: 1px solid var(--_btn-color);

			// color-mix over --_btn-color (not the brand-rgb triple) so the tint
			// tracks whatever colour the outline actually uses.
			&:hover {
				background-color: color-mix(in srgb, var(--_btn-color) 10%, transparent);
				color: var(--_btn-color);
				text-decoration: none;
			}

			&:active {
				background-color: color-mix(in srgb, var(--_btn-color) 15%, transparent);
				color: var(--_btn-color);
				transition-duration: 0s;
			}
		}

		&--text {
			background-color: transparent;
			color: var(--_btn-color);

			&:hover {
				background-color: var(--_btn-subtle-bg);
				text-decoration: none;
			}
		}

		// ---- Modifiers ----
		&--pill {
			border-radius: $radius-full;
		}

		&--full-width {
			width: 100%;
		}

		&--disabled {
			opacity: 0.5;
			pointer-events: none;
			cursor: not-allowed;
		}
	}
</style>
