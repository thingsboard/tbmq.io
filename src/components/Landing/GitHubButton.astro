---
import { Products } from '@models/site.models';
import GITHUB_STARS from '@data/github-stars.json';
import { formatStars, formatStarsLong } from '@util/github-stars';

interface Props {
	platform?: Products;
}

const { platform = Products.TBMQ } = Astro.props;

// Every edition's source is discussed and starred in the one public repository.
const repoMap: Record<Products, keyof typeof GITHUB_STARS> = {
	[Products.TBMQ]: 'thingsboard/tbmq',
	[Products.TBMQ_PE]: 'thingsboard/tbmq',
	[Products.TBMQ_LITE]: 'thingsboard/tbmq',
};

const repo = repoMap[platform];
// The count the page is built with (`pnpm update:stars` refreshes the file). The script below replaces
// it with the live one, so the button is never empty and never changes width as it loads.
const stars = GITHUB_STARS[repo];
---

<a
	href={`https://github.com/${repo}`}
	class="gh-button"
	target="_blank"
	rel="noopener noreferrer"
	aria-label={`Star ${repo} on GitHub — ${formatStarsLong(stars)} stars`}
	data-repo={repo}
>
	{/* Octicon `mark-github` (GitHub Octicons, MIT). */}
	<svg class="gh-mark" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
		<path
			d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
		></path>
	</svg>
	<span class="gh-count">{formatStars(stars)}</span>
</a>

<script>
	import { formatStars, formatStarsLong } from '@util/github-stars';

	// Defer via `__deferOnInteraction` (GTM's system); 5.5s fallback > GTM's 5s
	// keeps GTM first. Full tier schedule: DeferredLoadTrigger.astro.
	const DEFER_MS = 5500;

	type DeferFn = (cb: () => void, fallbackMs?: number) => void;

	const fetchStars = async (repo: string): Promise<number | null> => {
		try {
			const res = await fetch(`https://api.github.com/repos/${repo}`, {
				headers: { Accept: 'application/vnd.github.v3+json' },
			});
			if (!res.ok) return null;
			const { stargazers_count: count } = await res.json();
			return typeof count === 'number' ? count : null;
		} catch {
			return null;
		}
	};

	const init = () => {
		const defer = (window as { __deferOnInteraction?: DeferFn }).__deferOnInteraction;
		document.querySelectorAll<HTMLAnchorElement>('a.gh-button[data-repo]').forEach((btn) => {
			const repo = btn.dataset.repo!;
			const counterEl = btn.querySelector<HTMLElement>('.gh-count')!;

			const show = (stars: number) => {
				counterEl.textContent = formatStars(stars);
				btn.setAttribute('aria-label', `Star ${repo} on GitHub — ${formatStarsLong(stars)} stars`);
			};

			const cached = Number(sessionStorage.getItem(`gh_stars_${repo}`));
			if (cached > 0) {
				show(cached);
				return;
			}

			const runFetch = async () => {
				const stars = await fetchStars(repo);
				if (stars === null) return;
				sessionStorage.setItem(`gh_stars_${repo}`, String(stars));
				show(stars);
			};

			if (defer) defer(runFetch, DEFER_MS);
			else setTimeout(runFetch, DEFER_MS);
		});
	};

	if (document.readyState === 'complete') {
		init();
	} else {
		window.addEventListener('load', init, { once: true });
	}
</script>

{/* Global: the rules nest under `HeaderContent`'s `.head-buttons`, which a scoped style can't match. */}
<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	// The base button styles are in `HeaderContent`; nesting under `.head-buttons` lets these win.
	.head-buttons .gh-button {
		--btn-px: 12px;

		display: none;
		flex: none;
		font-weight: $font-weight-normal;

		@include width-from($menu-split-from) {
			display: inline-flex;
		}

		// Logo only until the desktop menu row leaves room for the count.
		@include width-from($menu-row-from) {
			@include width-below(1440px) {
				width: 40px;
				padding: 0;
			}
		}
	}

	.gh-mark {
		flex: 0 0 16px;
		fill: currentColor;
	}

	// Trimmed to the cap height, so the digits sit mid-button. Digits of one width, so the live count
	// replacing the built-in one does not move the buttons beside it.
	.gh-count {
		text-box: trim-both cap alphabetic;
		font-variant-numeric: tabular-nums;

		@include width-from($menu-row-from) {
			@include width-below(1440px) {
				display: none;
			}
		}
	}
</style>
