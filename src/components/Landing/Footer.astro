---
import SocialNetworks from '@components/Landing/SocialNetworks.astro';
import NButton from '@components/Landing/NButton.astro';
import SmartImage from '@components/SmartImage.astro';
const currentYear = new Date().getFullYear();
---

<footer>
	<div class="light-text main-div">
		<div class="newsletterSubsContainer">
			<div class="newsletter-left">
				<NButton id="Footer_ContactUs" href="/contact-us/" class="contact-us gtm_button"> Contact us </NButton>
			</div>
			<div class="footer-top-img-section">
				<SmartImage
					src="/src/assets/images/landings/footer/crozdesk-quality-choice-badge.png"
					alt="ThingsBoard achievement - Crozdesk Quality Choice"
					height="80"
					width="80"
				/>
				<SmartImage
					src="/src/assets/images/landings/footer/crozdesk-trusted-vendor-badge.png"
					alt="ThingsBoard achievement - Crozdesk Trusted Vendor"
					height="80"
					width="80"
				/>
				<SmartImage
					src="/src/assets/images/landings/footer/crozdesk-happiest-users-badge.png"
					alt="ThingsBoard achievement - Crozdesk Happiest Users"
					height="80"
					width="80"
				/>
				<SmartImage
					src="/src/assets/images/landings/footer/supplier-retail.webp"
					alt="ThingsBoard achievement - Top Supplier in Retail 2024"
					height="80"
					width="55"
				/>
			</div>
		</div>

		<hr />

		<div class="deeper">
			<a href="/" class="footer-logo" aria-label="Link to homepage"></a>
			<nav>
				<a href="/docs/pe/getting-started/">Get Started</a>
				<a href="/docs/pe/">Documentation</a>
				<a href="/blog/">Blog</a>
				<a href="/contact-us/?subject=TBMQ&tbmqorder&message=I%20am%20interested%20in%20TBMQ&customTitle=GetTBMQ"
					>Contact us</a
				>
			</nav>
		</div>

		<div class="deepmost">
			<div class="copyright">&copy; {currentYear} The ThingsBoard Authors</div>
			<SocialNetworks />
		</div>
	</div>
</footer>

<style lang="scss">
	@use '../../styles/variables' as *;

	footer {
		width: 100%;
		background-color: #0f161d;
		padding-left: 1.875rem;
		padding-right: 1.875rem;

		@media screen and (min-width: 1500px) {
			padding-left: 6.25rem;
			padding-right: 6.25rem;
		}

		.main-div {
			padding: 5.75rem 0 4.875rem;
			max-width: 1200px;
			margin: 0 auto;

			@media screen and (min-width: 1500px) {
				max-width: 1400px !important;
			}

			@media screen and (max-width: 768px) {
				padding: 3.75rem 0 2.5rem;
			}

			hr {
				border: none;
				border-top: 2px solid white;
				opacity: 0.1;
				margin: 3.375rem 0 1rem;
			}

			.deeper {
				margin-bottom: 3.75rem;
				display: flex;
				justify-content: space-between;

				@media screen and (max-width: 1024px) {
					justify-content: flex-end;

					.footer-logo {
						display: none;
					}
				}

				@media screen and (max-width: 768px) {
					justify-content: center;

					nav {
						display: block !important;

						a {
							width: 100%;
							text-align: center !important;
							margin: 1.125rem 0 0 !important;
						}
					}
				}

				.footer-logo {
					background-image: url(../../assets/images/landings/thingsboard-logo.svg);
					filter: invert(100%) sepia(68%) saturate(0%) hue-rotate(350deg) brightness(113%) contrast(101%);
					width: 180px;
					height: 60px;
					background-size: contain;
					background-position: center center;
					background-repeat: no-repeat;
				}

				nav {
					display: flex;
					align-items: center;
					justify-content: right;

					a {
						text-align: right;
						display: inline-block;
						margin: 0 0.875rem;
						font-size: 1rem;
						color: white;
						transition: 300ms;
						text-decoration: none;

						&:hover {
							color: white;
							text-decoration: underline;
						}

						&:last-child {
							margin-right: 0;
						}

						&:first-child {
							margin-left: 0;
						}
					}
				}
			}
		}

		.newsletterSubsContainer {
			min-height: 6.625rem;
			width: 100%;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1.875rem;

			@media screen and (max-width: 900px) {
				flex-wrap: wrap;
				justify-content: center;
			}

			@media screen and (max-width: 768px) {
				flex-direction: column;
				align-items: center;
			}

			.newsletter-left {
				flex: 1;
				min-width: 0;
			}

			.footer-top-img-section {
				display: flex;
				gap: 2.5rem;
				flex-shrink: 0;

				@media screen and (max-width: 900px) {
					flex-wrap: wrap;
					justify-content: center;
					gap: 1.5rem 2rem;
				}
			}

			.contact-us {
				margin: 0;
				height: fit-content;
				padding: 0.8125rem 1.25rem;
				background-color: var(--color-brand);
				color: var(--color-brand-contrast);
				transition-duration: unset;

				&:hover {
					transition-duration: unset;
					box-shadow: unset;
					color: var(--color-brand-contrast);
				}

				&:focus {
					outline: none;
				}
			}
		}

		.deepmost {
			display: flex;
			justify-content: space-between;

			@media screen and (max-width: 768px) {
				display: block;

				.copyright {
					text-align: center;
				}

				:global(.social) {
					justify-content: center;
					width: 100%;
					padding-top: 3rem;
				}
			}

			.copyright {
				color: #8e8292;
				font-size: 0.875rem;
			}
		}
	}
</style>
