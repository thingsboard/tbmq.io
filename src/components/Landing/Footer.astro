---
import SocialNetworks from '@components/Landing/SocialNetworks.astro';
const currentYear = new Date().getFullYear();
---

<footer>
	<div class="light-text main-div">
		<hr />

		<div class="deeper">
			<a href="/" class="footer-logo" aria-label="Link to homepage"></a>
			<nav>
				<a href="/docs/pe/getting-started/">Get Started</a>
				<a href="/docs/pe/">Documentation</a>
				<a href="/blog/">Blog</a>
				<a href="/contact-us/">Contact us</a>
			</nav>
		</div>

		<div class="deepmost">
			<div class="copyright">&copy; {currentYear} The ThingsBoard Authors</div>
			<SocialNetworks />
		</div>
	</div>
</footer>

<style lang="scss">
	@use '../../styles/variables' as *;

	footer {
		width: 100%;
		background-color: #0f161d;
		padding-left: 1.875rem;
		padding-right: 1.875rem;

		@media screen and (min-width: 1500px) {
			padding-left: 6.25rem;
			padding-right: 6.25rem;
		}

		.main-div {
			padding: 5.75rem 0 4.875rem;
			max-width: 1200px;
			margin: 0 auto;

			@media screen and (min-width: 1500px) {
				max-width: 1400px !important;
			}

			@media screen and (max-width: 768px) {
				padding: 3.75rem 0 2.5rem;
			}

			hr {
				border: none;
				border-top: 2px solid white;
				opacity: 0.1;
				margin: 3.375rem 0 1rem;
			}

			.deeper {
				margin-bottom: 3.75rem;
				display: flex;
				justify-content: space-between;

				@media screen and (max-width: 1024px) {
					justify-content: flex-end;

					.footer-logo {
						display: none;
					}
				}

				@media screen and (max-width: 768px) {
					justify-content: center;

					nav {
						display: block !important;

						a {
							width: 100%;
							text-align: center !important;
							margin: 1.125rem 0 0 !important;
						}
					}
				}

				.footer-logo {
					background-image: url(../../assets/images/landings/thingsboard-logo.svg);
					filter: invert(100%) sepia(68%) saturate(0%) hue-rotate(350deg) brightness(113%) contrast(101%);
					width: 180px;
					height: 60px;
					background-size: contain;
					background-position: center center;
					background-repeat: no-repeat;
				}

				nav {
					display: flex;
					align-items: center;
					justify-content: right;

					a {
						text-align: right;
						display: inline-block;
						margin: 0 0.875rem;
						font-size: 1rem;
						color: white;
						transition: 300ms;
						text-decoration: none;

						&:hover {
							color: white;
							text-decoration: underline;
						}

						&:last-child {
							margin-right: 0;
						}

						&:first-child {
							margin-left: 0;
						}
					}
				}
			}
		}

		.deepmost {
			display: flex;
			justify-content: space-between;

			@media screen and (max-width: 768px) {
				display: block;

				.copyright {
					text-align: center;
				}

				:global(.social) {
					justify-content: center;
					width: 100%;
					padding-top: 3rem;
				}
			}

			.copyright {
				color: #8e8292;
				font-size: 0.875rem;
			}
		}
	}
</style>
