---
import { Icon } from 'astro-icon/components';

interface Props {
	leftLabel: string;
	rightLabel: string;
	leftValue: string;
	rightValue: string;
	id: string;
	leftGtmId?: string;
	rightGtmId?: string;
	leftFaqId?: string;
	leftFaqTooltip?: string;
	leftAutoTooltip?: boolean;
	rightFaqId?: string;
	rightFaqTooltip?: string;
	rightAutoTooltip?: boolean;
}

const { leftLabel, rightLabel, leftValue, rightValue, id, leftGtmId, rightGtmId, leftFaqId, leftFaqTooltip, leftAutoTooltip, rightFaqId, rightFaqTooltip, rightAutoTooltip } = Astro.props;
---

<div class="billing-toggle" data-toggle-id={id}>
	<span class={`billing-toggle-label${leftGtmId ? ' gtm_button' : ''} active`} id={leftGtmId} data-value={leftValue}>
		{leftLabel}
		{leftFaqId && (
			<span class="plan-feature-info" data-faq-id={leftFaqId}>
				<Icon name="tabler:info-circle" class="plan-feature-info-icon" />
				{leftFaqTooltip && (
					<span class="plan-feature-tooltip">
						<span class="plan-feature-tooltip-arrow"></span>
						<span class="plan-feature-tooltip-body" set:html={leftFaqTooltip + (leftAutoTooltip ? ' <span class="plan-feature-tooltip-readmore">read more</span>' : '')} />
					</span>
				)}
			</span>
		)}
	</span>
	<label class="billing-toggle-switch">
		<input type="checkbox" data-billing-toggle={id} role="switch" aria-label={`Toggle between ${leftLabel} and ${rightLabel}`} />
		<span class="billing-toggle-slider"></span>
	</label>
	<span class={`billing-toggle-label${rightGtmId ? ' gtm_button' : ''}`} id={rightGtmId} data-value={rightValue}>
		{rightLabel}
		{rightFaqId && (
			<span class="plan-feature-info" data-faq-id={rightFaqId}>
				<Icon name="tabler:info-circle" class="plan-feature-info-icon" />
				{rightFaqTooltip && (
					<span class="plan-feature-tooltip">
						<span class="plan-feature-tooltip-arrow"></span>
						<span class="plan-feature-tooltip-body" set:html={rightFaqTooltip + (rightAutoTooltip ? ' <span class="plan-feature-tooltip-readmore">read more</span>' : '')} />
					</span>
				)}
			</span>
		)}
	</span>
</div>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	.billing-toggle {
		display: flex;
		align-items: center;
		gap: $spacing-3;
		margin-bottom: $spacing-6;
	}

	.billing-toggle-label {
		font-size: $font-size-sm;
		font-weight: $font-weight-medium;
		color: var(--color-text-secondary);
		cursor: pointer;
		transition: color $transition-fast;
		user-select: none;

		&.active {
			color: var(--color-text);
			font-weight: $font-weight-semibold;
		}
	}

	.billing-toggle-switch {
		position: relative;
		display: inline-block;
		width: 44px;
		height: 24px;
		cursor: pointer;

		input {
			opacity: 0;
			width: 0;
			height: 0;
		}
	}

	.billing-toggle-slider {
		position: absolute;
		inset: 0;
		background-color: var(--color-primary);
		border-radius: $radius-full;
		transition: background-color $transition-fast;

		&::before {
			content: '';
			position: absolute;
			width: 18px;
			height: 18px;
			left: 3px;
			bottom: 3px;
			background: var(--color-bg-surface);
			border-radius: 50%;
			transition: transform $transition-fast;
		}
	}

	.billing-toggle-switch input:checked + .billing-toggle-slider::before {
		transform: translateX(20px);
	}

	// ─── FAQ info icon + tooltip (in the toggle labels) ───
	// Visibility (.pricing-tooltip--visible/--interactive) and flipping are
	// driven by the shared tooltip system in pages/pricing/index.astro.
	.plan-feature-info {
		position: relative;
		display: inline;
		cursor: pointer;
		margin-left: 0;
	}

	.plan-feature-info-icon {
		width: 14px;
		height: 14px;
		color: var(--color-text);
		opacity: 0.8;
		vertical-align: text-top;
		margin-top: -1px;
		transition:
			color 0.2s ease,
			opacity 0.2s ease;
	}

	.plan-feature-info:hover .plan-feature-info-icon {
		color: var(--color-primary);
		opacity: 1;
	}

	.plan-feature-tooltip {
		position: fixed;
		z-index: 99999;
		pointer-events: none;
		left: -9999px;
		top: 0;
		display: flex;
		align-items: center;

		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.15s ease,
			visibility 0.15s ease;
		transition-delay: 0ms;

		// Invisible bridge from icon to tooltip body so hover is maintained across the gap
		&::before {
			content: '';
			position: absolute;
			top: 0;
			left: -12px;
			width: 16px;
			height: 100%;
		}
	}

	.plan-feature-tooltip.pricing-tooltip--visible {
		opacity: 1;
		visibility: visible;
		pointer-events: none;
		&.pricing-tooltip--interactive {
			pointer-events: auto;
		}
	}

	.plan-feature-tooltip-arrow {
		flex-shrink: 0;
		width: 0;
		height: 0;
		border: 6px solid transparent;
		border-right-color: var(--sl-color-gray-5);
		position: relative;

		&::after {
			content: '';
			position: absolute;
			top: -6px;
			left: -4px;
			width: 0;
			height: 0;
			border: 6px solid transparent;
			border-right-color: var(--color-bg-surface);
		}
	}

	.plan-feature-tooltip-readmore {
		color: var(--color-primary);
		cursor: pointer;

		&:hover {
			text-decoration: underline;
		}
	}

	.plan-feature-tooltip-body {
		display: block;
		padding: $spacing-3;
		background: var(--color-bg-surface);
		color: var(--color-text);
		font-size: $font-size-sm;
		font-weight: $font-weight-normal;
		line-height: 1.5;
		text-align: left;
		white-space: normal;
		width: 280px;
		border-radius: $radius-lg;
		border: 1px solid var(--sl-color-gray-5);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);

		a {
			color: var(--color-primary);
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}
		}
	}
</style>
