										stroke-linecap="round"
										marker-end="url(#bm-8)"
									/>
									<path
										d="M242 92 C 263.6 92 268.4 92 290 92"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#bm-9)"
									/>
									<circle cx="56" cy="92" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="56" cy="92" r="8" fill="#17bb52" />
									<rect x="124" y="62" width="112" height="60" rx="12" fill="#155e2b" />
									<text
										x="180"
										y="93"
										text-anchor="middle"
										dominant-baseline="middle"
										font-size="15"
										font-weight="700"
										fill="#fff"
										letter-spacing="0.6"
									>
										BROKER
									</text>
									<circle cx="304" cy="92" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="304" cy="92" r="8" fill="#17bb52" />
									<text
										x="56"
										y="134"
										text-anchor="middle"
										font-size="15"
										font-weight="600"
										fill="#3f4a44"
										letter-spacing="0.3"
									>
										Publisher
									</text>
									<text
										x="304"
										y="134"
										text-anchor="middle"
										font-size="15"
										font-weight="600"
										fill="#3f4a44"
										letter-spacing="0.3"
									>
										Subscriber
									</text>
								</svg>
							)}
						</div>
						<div class="card-body">
							<p class="kicker">{b.kicker}</p>
							<h3 class="title">{b.title}</h3>
							<p class="scenario">{b.scenario}</p>
							<div class="metricgrid">
								{b.metrics.map((m) => (
									<div class:list={['mt', { hi: m.hi }]}>
										<div class="mt-k">{m.label}</div>
										<div class="mt-v">{m.value}</div>
									</div>
								))}
							</div>
							<a class="report-link" href={b.href}>
								Read the full report
								<Icon name="tabler:arrow-right" class="link-icon" />
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	#benchmark-results {
		padding: $spacing-20 $spacing-6;
		background-color: #f2f8f4;
	}

	.inner {
		@include container;
		max-width: 1400px;
	}

	.cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: 28px;

		@include media-up(md) {
			grid-template-columns: repeat(2, 1fr);
		}

		@include media-up(xl) {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.card {
		display: flex;
		flex-direction: column;
		background: $color-white;
		border-radius: 24px;
		padding: 32px;
		box-shadow: 0 7px 32px 0 rgba(0, 0, 0, 0.08);
	}

	// Mini topology diagram in its own rounded, bordered panel; card padding sets the outer spacing.
	.card-viz {
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 24px;
		padding: 8px 12px;
		background: linear-gradient(180deg, #f4faf6, #eef7f1);
		border: 1px solid $color-border-light;
		border-radius: 14px;

		svg {
			width: 100%;
			height: auto;
			max-height: 184px;
		}
	}

	.card-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 0;
	}

	.kicker {
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 13px;
		font-weight: $font-weight-semibold;
		color: $color-pe-link;
		margin: 0 0 12px;
	}

	.title {
		font-size: 24px;
		font-weight: $font-weight-semibold;
		line-height: 1.25;
		color: $color-text-primary;
		margin: 0 0 14px;
	}

	.scenario {
		font-size: 16px;
		line-height: 1.7;
		color: $color-text-secondary;
		margin: 0 0 24px;
		// Reserve 3 lines so the metric tiles start at the same height across
		// all three cards, keeping the columns aligned row-for-row.
		min-height: 5.1em;
	}

	// Metrics as compact tiles; the two headline numbers per card are accented.
	.metricgrid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
		margin: 0 0 28px;
	}

	.mt {
		border: 1px solid $color-border;
		border-radius: 9px;
		padding: 9px 11px;
		background: #f7faf8;

		&.hi {
			background: #eef7f0;
			border-color: #cfe8d6;

			.mt-v {
				color: $color-pe-link;
			}
		}
	}

	.mt-k {
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: $color-text-muted;
	}

	.mt-v {
		font-size: 15px;
		font-weight: $font-weight-bold;
		line-height: 1.3;
		color: $color-text-primary;
		font-variant-numeric: tabular-nums;
		margin-top: 2px;
	}

	.report-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: auto;
		font-size: 16px;
		font-weight: $font-weight-medium;
		color: $color-pe-link;
		text-decoration: none;

		&:hover {
			text-decoration: underline;
		}
	}

	:global(.link-icon) {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
	}
</style>
