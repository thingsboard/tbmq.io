---
import SectionHeader from '@components/Landing/SectionHeader.astro';
import { Icon } from 'astro-icon/components';

type Metric = { label: string; value: string; hi?: boolean };
type Benchmark = {
	kicker: string;
	title: string;
	viz: 'fan-in' | 'fan-out' | 'p2p';
	scenario: string;
	metrics: Metric[];
	href: string;
};

const benchmarks: Benchmark[] = [
	{
		kicker: 'Fan-in · Scale',
		title: '100 million connections',
		viz: 'fan-in',
		scenario:
			'A 25-node cluster sustained 100M+ concurrent MQTT clients emulating smart trackers while processing 6M messages per second.',
		metrics: [
			{ label: 'Throughput', value: '6M msg/sec', hi: true },
			{ label: 'Connections', value: '100,000,500', hi: true },
			{ label: 'Avg latency', value: '195 ms' },
			{ label: 'Delivery', value: '100%' },
			{ label: 'QoS', value: '1 (at least once)' },
			{ label: 'CPU', value: '45% utilization' },
		],
		href: '/docs/mqtt-broker/pe/reference/100m-connections-performance-test/',
	},
	{
		kicker: 'Fan-out · Throughput',
		title: '3M msg/sec, single node',
		viz: 'fan-out',
		scenario:
			'One 32-vCPU TBMQ node handled a 3M msg/sec fan-out — 100 publishers to 3,000 subscribers — with CPU headroom to spare.',
		metrics: [
			{ label: 'Throughput', value: '3M msg/sec', hi: true },
			{ label: 'Avg latency', value: '7.4 ms', hi: true },
			{ label: 'Nodes', value: '1 (32 vCPU)' },
			{ label: 'CPU', value: '54% utilization' },
			{ label: 'QoS', value: '0 (at most once)' },
			{ label: 'Payload', value: '66 bytes' },
		],
		href: '/docs/mqtt-broker/pe/reference/3m-throughput-single-node-performance-test/',
	},
	{
		kicker: 'Point-to-point · Delivery',
		title: '1M msg/sec, guaranteed',
		viz: 'p2p',
		scenario:
			'Persistent DEVICE clients scaled linearly from 200k to 1M msg/sec with QoS 1 guaranteed delivery, backed by Redis and Kafka.',
		metrics: [
			{ label: 'Throughput', value: '1M msg/sec', hi: true },
			{ label: 'Efficiency', value: '~8,900 msg/sec/core', hi: true },
			{ label: 'Avg latency', value: '75 ms' },
			{ label: 'Publish ACK', value: '8 ms' },
			{ label: 'QoS', value: '1 (at least once)' },
			{ label: 'Scaling', value: 'Linear, phase by phase' },
		],
		href: '/docs/mqtt-broker/pe/reference/1m-throughput-p2p-performance-test/',
	},
];
---

<section id="benchmark-results">
	<div class="inner">
		<SectionHeader
			class="reveal"
			title="Benchmarked at every scale"
			subtitle="TBMQ is proven across the three core MQTT messaging patterns — fan-in, fan-out, and point-to-point."
		/>
		<div class="cards">
			{
				benchmarks.map((b, i) => (
					<article class="card reveal" style={`--reveal-delay: ${i * 90}ms`}>
						<div class="card-viz">
							{b.viz === 'fan-in' && (
								<svg viewBox="0 0 360 196" role="img" aria-label="Fan-in: many publishers send to one broker">
									<defs>
										<marker
											id="bm-0"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
										<marker
											id="bm-1"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
										<marker
											id="bm-2"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
										<marker
											id="bm-3"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
									</defs>
									<path
										d="M68 36 C 139.1 36 154.9 73 226 73"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#bm-0)"
									/>
									<path
										d="M68 72 C 139.1 72 154.9 86 226 86"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#bm-1)"
									/>
									<path
										d="M68 108 C 139.1 108 154.9 98 226 98"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#bm-2)"
									/>
									<path
										d="M68 144 C 139.1 144 154.9 111 226 111"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#bm-3)"
									/>
									<circle cx="54" cy="36" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="54" cy="36" r="8" fill="#17bb52" />
									<circle cx="54" cy="72" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="54" cy="72" r="8" fill="#17bb52" />
									<circle cx="54" cy="108" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="54" cy="108" r="8" fill="#17bb52" />
									<circle cx="54" cy="144" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="54" cy="144" r="8" fill="#17bb52" />
									<rect x="232" y="62" width="112" height="60" rx="12" fill="#155e2b" />
									<text
										x="288"
										y="93"
										text-anchor="middle"
										dominant-baseline="middle"
										font-size="15"
										font-weight="700"
										fill="#fff"
										letter-spacing="0.6"
									>
										BROKER
									</text>
									<text
										x="60"
										y="174"
										text-anchor="middle"
										font-size="15"
										font-weight="600"
										fill="#3f4a44"
										letter-spacing="0.3"
									>
										Publishers
									</text>
								</svg>
							)}
							{b.viz === 'fan-out' && (
								<svg viewBox="0 0 360 196" role="img" aria-label="Fan-out: one broker delivers to many subscribers">
									<defs>
										<marker
											id="bm-4"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
										<marker
											id="bm-5"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
										<marker
											id="bm-6"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
										<marker
											id="bm-7"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
									</defs>
									<path
										d="M134 73 C 205.1 73 220.9 36 292 36"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#bm-4)"
									/>
									<path
										d="M134 86 C 205.1 86 220.9 72 292 72"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#bm-5)"
									/>
									<path
										d="M134 98 C 205.1 98 220.9 108 292 108"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#bm-6)"
									/>
									<path
										d="M134 111 C 205.1 111 220.9 144 292 144"
										fill="none"
										stroke="#4fb97a"
										stroke-width="2.25"
										stroke-linecap="round"
										marker-end="url(#bm-7)"
									/>
									<rect x="16" y="62" width="112" height="60" rx="12" fill="#155e2b" />
									<text
										x="72"
										y="93"
										text-anchor="middle"
										dominant-baseline="middle"
										font-size="15"
										font-weight="700"
										fill="#fff"
										letter-spacing="0.6"
									>
										BROKER
									</text>
									<circle cx="306" cy="36" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="306" cy="36" r="8" fill="#17bb52" />
									<circle cx="306" cy="72" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="306" cy="72" r="8" fill="#17bb52" />
									<circle cx="306" cy="108" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="306" cy="108" r="8" fill="#17bb52" />
									<circle cx="306" cy="144" r="13" fill="none" stroke="#bfe6cd" stroke-width="2" />
									<circle cx="306" cy="144" r="8" fill="#17bb52" />
									<text
										x="300"
										y="174"
										text-anchor="middle"
										font-size="15"
										font-weight="600"
										fill="#3f4a44"
										letter-spacing="0.3"
									>
										Subscribers
									</text>
								</svg>
							)}
							{b.viz === 'p2p' && (
								<svg
									viewBox="0 0 360 196"
									role="img"
									aria-label="Point-to-point: one publisher to one subscriber through the broker"
								>
									<defs>
										<marker
											id="bm-8"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
										<marker
											id="bm-9"
											markerUnits="userSpaceOnUse"
											markerWidth="10"
											markerHeight="10"
											refX="8"
											refY="5"
											orient="auto"
										>
											<path d="M0,0 L9,5 L0,10 Z" fill="#17bb52" />
										</marker>
									</defs>
