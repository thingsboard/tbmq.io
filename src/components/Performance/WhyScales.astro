---
import SectionHeader from '@components/Landing/SectionHeader.astro';
import { Icon } from 'astro-icon/components';

const points = [
	{
		color: 'green',
		icon: 'tabler:affiliate',
		title: 'Masterless cluster',
		text: 'No node-to-node communication. Add nodes and throughput scales linearly — the 1M msg/sec P2P test proved it phase by phase.',
	},
	{
		color: 'blue',
		icon: 'tabler:database',
		title: 'Kafka-backed durability',
		text: 'Messages are persisted in Kafka, not just buffered in memory. The 100M test moved 11.4 billion messages with 100% delivery.',
	},
	{
		color: 'purple',
		icon: 'tabler:stack-2',
		title: 'Redis-powered delivery',
		text: 'Persistent DEVICE clients get reliable, ordered delivery even after disconnects — without overloading the database.',
	},
	{
		color: 'amber',
		icon: 'tabler:activity',
		title: 'Non-blocking network core',
		text: "A Netty-based, event-driven I/O layer holds millions of connections per node without a thread for each — the reason one cluster reaches 100M.",
	},
];
---

<section id="why-scales">
	<div class="inner">
		<SectionHeader
			class="reveal"
			title="Why TBMQ scales"
			subtitle="The numbers are a consequence of the architecture — not a lucky benchmark run."
		/>
		<div class="points">
			{
				points.map((p, i) => (
					<div class:list={['blk', 'reveal', `c-${p.color}`]} style={`--reveal-delay: ${i * 90}ms`}>
						<span class="blk-icon">
							<Icon name={p.icon} />
						</span>
						<h3 class="blk-title">{p.title}</h3>
						<p class="blk-text">{p.text}</p>
					</div>
				))
			}
		</div>
		<a class="arch-link reveal" href="/docs/pe/architecture/">
			Explore the TBMQ architecture
			<Icon name="tabler:arrow-right" class="link-icon" />
		</a>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	#why-scales {
		padding: $spacing-20 $spacing-6;
		background-color: var(--color-bg-surface);
	}

	.inner {
		@include container;
		max-width: 1200px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.points {
		display: grid;
		grid-template-columns: 1fr;
		gap: 16px;
		width: 100%;
		max-width: 880px;

		@include media-up(md) {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.blk {
		display: flex;
		flex-direction: column;
		gap: 12px;
		border-radius: 16px;
		padding: 24px;
		border: 1px solid rgba(0, 0, 0, 0.08);
		background: var(--blk-tint);
	}

	.blk-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background: $color-white;
		color: var(--blk-acc);
		border: 1px solid rgba(0, 0, 0, 0.06);

		:global(svg) {
			width: 26px;
			height: 26px;
		}
	}

	.blk-title {
		font-size: 20px;
		font-weight: $font-weight-semibold;
		line-height: 1.3;
		color: var(--blk-ink);
		margin: 0;
	}

	.blk-text {
		font-size: 16px;
		line-height: 1.7;
		color: $color-text-secondary;
		margin: 0;
	}

	.c-green {
		--blk-tint: #eef7f0;
		--blk-acc: #1f8a3d;
		--blk-ink: #155e2b;
	}

	.c-blue {
		--blk-tint: #eaf1fb;
		--blk-acc: #2f74d0;
		--blk-ink: #12447c;
	}

	.c-purple {
		--blk-tint: #f0edfd;
		--blk-acc: #7a5af0;
		--blk-ink: #3f2e8a;
	}

	.c-amber {
		--blk-tint: #fbf1de;
		--blk-acc: #d98a25;
		--blk-ink: #7a4d0b;
	}

	.arch-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 56px;
		font-size: 18px;
		font-weight: $font-weight-medium;
		color: $color-pe-link;
		text-decoration: none;

		&:hover {
			text-decoration: underline;
		}
	}

	:global(.link-icon) {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
	}
</style>
