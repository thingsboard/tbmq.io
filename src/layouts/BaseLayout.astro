---
import Header from '../components/Landing/Header.astro';
import Footer from '../components/Landing/Footer.astro';
import OpenContentLinksInNewTab from '../components/OpenContentLinksInNewTab.astro';
import CookieBanner from '../components/CookieBanner.astro';
import UtmTracker from '../components/UtmTracker.astro';
import GtmNoscript from '../components/GtmNoscript.astro';
import ThirdPartyScripts from '../components/ThirdPartyScripts.astro';
import SeoMeta from '../components/SeoMeta.astro';
import ThemeProvider from '../components/starlight/ThemeProvider.astro';
import { Icon } from '@astrojs/starlight/components';
import { formatMarketingTitle } from '~/consts';
import { getOgImageUrl } from '~/util/getOgImageUrl';
import '../styles/global.scss';
import 'node_modules/@astrojs/starlight/style/props.css';

interface Props {
	title: string;
	description?: string;
	pageId?: string;
	customTitle?: boolean;
	githubLink?: string;
	githubLabel?: string;
	platformQuery?: string;
	noCanonical?: boolean;
	gitHubPlatform?: import('../models/site.models').Products;
	forceLightTheme?: boolean;
	ogImage?: string;
	ogType?: string;
	ogImageAlt?: string;
	publishedTime?: string;
	modifiedTime?: string;
	noIndex?: boolean;
	jsonLd?: Record<string, unknown>;
	/**
	 * Preload an above-the-fold LCP image with fetchpriority=high. Use ONLY for
	 * the page's LCP candidate (typically a CSS background not visible to the
	 * preload scanner — e.g. the hero on the home page). Misuse on decorative
	 * images will compete with the real LCP target for bandwidth.
	 */
	preloadLcpImage?: string;
	/** Open all in-content links in a new tab (SEO request; see OpenContentLinksInNewTab). */
	openContentLinksInNewTab?: boolean;
}

const {
	title,
	description,
	pageId = 'common',
	customTitle = false,
	githubLink = 'https://github.com/thingsboard/thingsboard',
	githubLabel = 'Star thingsboard/thingsboard on GitHub',
	platformQuery = '',
	noCanonical = false,
	gitHubPlatform,
	forceLightTheme = false,
	ogImage: ogImageProp,
	ogType,
	ogImageAlt,
	publishedTime,
	modifiedTime,
	noIndex = false,
	jsonLd,
	preloadLcpImage,
	openContentLinksInNewTab = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = customTitle ? title : formatMarketingTitle(title);
const ogImage = ogImageProp ?? getOgImageUrl(Astro.url.pathname);

// Bridge for the Starlight `ThemeProvider` override (rendered in <head> below):
// `bsl` marks a BaseLayout page, `bslForceLight` locks the light theme and skips
// the theme switcher. Matches the upstream ThingsBoard site so the override file
// stays mergeable.
const locals = Astro.locals as unknown as Record<string, unknown>;
locals.bsl = true;
locals.bslForceLight = forceLightTheme;
---

<!doctype html>
<html id={pageId} lang="en" data-theme="light" data-force-light={forceLightTheme ? 'true' : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="cf-2fa-verify" content="a08672380de15e9" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- Establish TLS to GTM origin early; tags loaded via GTM (FB, LinkedIn, etc.) stay lazy by design. -->
		<link rel="preconnect" href="https://www.googletagmanager.com" />

		{preloadLcpImage && <link rel="preload" as="image" href={preloadLcpImage} fetchpriority="high" />}

		<title>{pageTitle}</title>

		<SeoMeta
			title={pageTitle}
			description={description}
			canonicalUrl={canonicalUrl}
			noCanonical={noCanonical}
			ogImage={ogImage}
			ogType={ogType}
			ogImageAlt={ogImageAlt}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			noIndex={noIndex}
			jsonLd={jsonLd}
		/>

		<link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg" />

		<ThemeProvider />
		<script is:inline>
			// Pages with data-force-light stay light regardless of user preference.
			// All other pages respect the theme set by ThemeProvider (from localStorage / OS).
			if (document.documentElement.dataset.forceLight === 'true') {
				document.documentElement.dataset.theme = 'light';
			}
		</script>

		<ThirdPartyScripts />
		<slot name="head" />
	</head>

	<body>
		<GtmNoscript />

		{
			/* Theme-switcher icon palette (light/dark/auto) that `StarlightThemeProvider.updatePickers()`
		    clones into the theme-select label icon. Rendered here at the top of <body> instead of
		    <head> because a warmed `astro dev` traps hoisted <style> blocks inside any <head>
		    <template>, unstyling the page (https://github.com/withastro/astro/issues/16994).
		    Only needed where the switcher exists (not on forceLightTheme pages). */
		}
		{
			!forceLightTheme && (
				<template id="theme-icons">
					<Icon name="sun" class="light" />
					<Icon name="moon" class="dark" />
					<Icon name="laptop" class="auto" />
				</template>
			)
		}

		{/* Sticky unit: header pins on scroll. See `.tb-topbar` in HeaderContent. */}
		<div class="tb-topbar">
			<Header
				githubLink={githubLink}
				githubLabel={githubLabel}
				platformQuery={platformQuery}
				gitHubPlatform={gitHubPlatform}
			/>
		</div>
		<CookieBanner />
		<UtmTracker />

		<slot />

		{openContentLinksInNewTab && <OpenContentLinksInNewTab />}

		<Footer />

		<!-- flip-nav sentinel: toggles `flip-nav` at ~10px scroll so transparent-header
		     pages turn opaque early. (The banner hides via CSS in the .tb-topbar unit.) -->
		<div id="flip-nav-sentinel" aria-hidden="true"></div>
		<style is:inline>
			#flip-nav-sentinel {
				position: absolute;
				top: 10px;
				left: 0;
				width: 1px;
				height: 1px;
				pointer-events: none;
				visibility: hidden;
			}
		</style>
		<script is:inline>
			(function () {
				const html = document.documentElement;
				const pagesWithTransparentHeader = [
					'home',
					'thingsboard-paas',
					'thingsboard-pe',
					'thingsboard-edge',
					'mqtt-broker',
					'pricing',
					'affiliate',
				];
				if (!pagesWithTransparentHeader.includes(html.id)) return;

				const sentinel = document.getElementById('flip-nav-sentinel');
				if (!sentinel) return;

				new IntersectionObserver(
					function (entries) {
						html.classList.toggle('flip-nav', !entries[0].isIntersecting);
					},
					{ threshold: 0 }
				).observe(sentinel);
			})();
		</script>
	</body>
</html>
