---
import CookieConsent from '../components/CookieConsent.astro';
import UtmTracker from '../components/UtmTracker.astro';
import SeoMeta from '../components/SeoMeta.astro';
import ThirdPartyScripts from '../components/ThirdPartyScripts.astro';
import { formatMarketingTitle } from '~/consts';
import { getOgImageUrl } from '~/util/getOgImageUrl';
import { marketingJsonLd } from '~/util/structuredData';

interface LegalPageMeta {
	title: string;
	description?: string;
	ogImage?: string;
	noIndex?: boolean;
	/** Breadcrumb leaf label; emits the default WebPage + BreadcrumbList graph, as on BaseLayout. */
	breadcrumb?: string;
	jsonLd?: Record<string, unknown>;
}

/* `.astro` callers pass the meta as props; an `.mdx` page using `layout:` gets
   its frontmatter wrapped in `Astro.props.frontmatter` instead. */
type Props = LegalPageMeta & { frontmatter?: LegalPageMeta };

const {
	title,
	description,
	ogImage: ogImageProp,
	noIndex = false,
	breadcrumb,
	jsonLd,
} = Astro.props.frontmatter ?? Astro.props;
/* Markdown documents carry their own opening date line and section headings;
   the hand-written HTML pages space those themselves. */
const isMarkdownPage = Boolean(Astro.props.frontmatter);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = formatMarketingTitle(title);
const ogImage = ogImageProp ?? getOgImageUrl(Astro.url.pathname);
const structuredData =
	jsonLd ??
	(breadcrumb ? marketingJsonLd({ path: Astro.url.pathname, name: title, description, breadcrumb }) : undefined);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<SeoMeta
			title={pageTitle}
			description={description}
			canonicalUrl={canonicalUrl}
			ogImage={ogImage}
			noIndex={noIndex}
			jsonLd={structuredData}
		/>
		<link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg" />
		<ThirdPartyScripts />
	</head>
	<body>
		<div class:list={['legal-page', { 'legal-page--markdown': isMarkdownPage }]}>
			<slot />
		</div>
		<CookieConsent />
		<UtmTracker />
		<script is:inline>
			// The demo broker (demo.tbmq.io) embeds these pages in an <iframe> inside its
			// sign-up dialog; the website-scope notice and the cookie banner are noise there.
			// The banner's own reveal script already skips frames; removing its root also keeps its
			// module script, which runs later, from binding anything.
			if (window.self !== window.top) {
				document.querySelectorAll('.scope').forEach((el) => (el.hidden = true));
				document.getElementById('cc-main')?.remove();
			}
		</script>
	</body>
</html>

<style lang="scss" is:global>
	@use '../styles/variables' as *;
	:root {
		--sl-main-pad: 0;
		--sl-line-height: 1.5;
		// Standalone document — BaseLayout's global token sheet isn't loaded here,
		// so every theme token this page (and the shared CookieConsent) reads must
		// be pinned locally to its light value, or the var() resolves to nothing.
		// The mixin is the same light palette :root gets in _theme.scss.
		@include light-theme-tokens;
	}

	// The cookie banner sits outside .legal-page, and nothing else sets a font on this page.
	#cc-main {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
	}

	.legal-page {
		max-width: 860px;
		margin: 0 auto;
		padding: 60px 24px 80px;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		color: #212529;
		line-height: 1.7;
		font-size: 16px;
		text-align: justify;

		h1,
		h2 {
			font-weight: 600;
			line-height: 1.3;
			margin: 0 0 16px;
		}

		h1 {
			font-size: 1.5em;
			text-align: center;
		}

		h2 {
			font-size: 1.25em;
			margin-top: 32px;
		}

		p {
			@include body-text;
			margin: 0 0 8px;

			b {
				color: var(--color-text);
			}
		}

		a {
			color: var(--color-primary);
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}
		}

		ul {
			margin: 0 0 8px !important;
			padding-left: 24px !important;
			list-style: disc !important;

			li {
				margin-bottom: 4px;
				list-style: disc !important;
				color: #75767c !important;

				&::marker {
					color: #75767c !important;
				}
			}
		}

		.date {
			font-size: 0.8em;
			color: grey;
		}

		.scope {
			margin: 16px 0 0;
			padding: 12px 16px;
			border-left: 3px solid var(--color-primary);
			background: rgba(0, 0, 0, 0.03);
			text-align: left;
		}

		// Everything below applies only to the Markdown documents. The
		// hand-written HTML pages space and mark up their own content, so keeping
		// these rules scoped leaves them rendering exactly as before.
		&.legal-page--markdown {
			// No manual <br /> between sections here: the gap lives on the heading.
			h2 {
				margin-top: 40px;
			}

			h2,
			h3 {
				text-align: left;
			}

			h3 {
				font-size: 1.1em;
				font-weight: 600;
				line-height: 1.3;
				margin: 28px 0 16px;
			}

			// The revision-date line each document opens with.
			h1 + p {
				margin-bottom: 32px;
			}

			// Markdown emits <strong>, not <b>.
			strong {
				color: var(--color-text);
				font-weight: 600;
			}

			// `display: block` lets the wide tables scroll instead of stretching
			// the 860px column on narrow screens.
			table {
				display: block;
				overflow-x: auto;
				width: 100%;
				margin: 0 0 16px;
				border-collapse: collapse;
				font-size: 0.95em;
				text-align: left;
			}

			th,
			td {
				padding: 8px 12px;
				border: 1px solid var(--color-border-light);
				text-align: left;
				vertical-align: top;
			}

			th {
				background: var(--color-bg-light);
				color: var(--color-text);
				font-weight: 600;
			}

			li > ul {
				margin-top: 4px !important;
			}
		}
	}
</style>
